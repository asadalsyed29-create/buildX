quot;&quot;,&quot;args&quot;:&quot;Welcome to the Game Hub! Here are 50 coins to start.&quot;,&quot;ln&quot;:7},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;coins&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;player_main : 50&quot;,&quot;ln&quot;:8},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;wait&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;4s&quot;,&quot;ln&quot;:10},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;message&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;Walk into a portal to play. Beat each game for a trophy!&quot;,&quot;ln&quot;:11}],&quot;handlers&quot;:[],&quot;funcs&quot;:{},&quot;rules&quot;:[]}</string></Properties><Item class="StringValue" referent="RBX000002CE"><Properties><string name="Name">BuildXSource</string><string name="Value">#set = trophies : 0
#load_value = trophies
#once_ever
#message = Welcome to the Game Hub! Here are 50 coins to start.
#coins = player_main : 50
#end
#wait = 4s
#message = Walk into a portal to play. Beat each game for a trophy!</string></Properties></Item></Item><Item class="StringValue" referent="RBX000002D1"><Properties><string name="Name">HuntScript</string><string name="Value">{&quot;main&quot;:[{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;set&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;found : 0&quot;,&quot;ln&quot;:1},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;wait_until&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;found == 12&quot;,&quot;ln&quot;:3},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;load_value&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;once_e1lfonkt_3&quot;,&quot;ln&quot;:4},{&quot;k&quot;:&quot;jz&quot;,&quot;cond&quot;:&quot;once_e1lfonkt_3 &gt; 0&quot;,&quot;neg&quot;:true,&quot;to&quot;:9},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;set&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;once_e1lfonkt_3 : 1&quot;,&quot;ln&quot;:6},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;save_value&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;once_e1lfonkt_3&quot;,&quot;ln&quot;:7},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;add&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;trophies : 1&quot;,&quot;ln&quot;:8},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;save_value&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;trophies&quot;,&quot;ln&quot;:9},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;message&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;New trophy! You beat the Coin Hunt&quot;,&quot;ln&quot;:10},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;coins&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;player_main : 25&quot;,&quot;ln&quot;:12},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;teleport&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;player_main : Hub_Spawn&quot;,&quot;ln&quot;:13},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;wait_while&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;found == 12&quot;,&quot;ln&quot;:14},{&quot;k&quot;:&quot;jmp&quot;,&quot;to&quot;:1,&quot;y&quot;:1}],&quot;handlers&quot;:[],&quot;funcs&quot;:{},&quot;rules&quot;:[]}</string></Properties><Item class="StringValue" referent="RBX000002D0"><Properties><string name="Name">BuildXSource</string><string name="Value">#set = found : 0
#if = found = 12 = then
#once_ever
#add = trophies : 1
#save_value = trophies
#message = New trophy! You beat the Coin Hunt
#end
#coins = player_main : 25
#teleport = player_main : Hub_Spawn
#end</string></Properties></Item></Item><Item class="StringValue" referent="RBX000002D3"><Properties><string name="Name">ArenaScript</string><string name="Value">{&quot;main&quot;:[{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;set&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;defeated : 0&quot;,&quot;ln&quot;:1},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;wait_until&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;defeated == 4&quot;,&quot;ln&quot;:6},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;load_value&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;once_e1d9wrje_6&quot;,&quot;ln&quot;:7},{&quot;k&quot;:&quot;jz&quot;,&quot;cond&quot;:&quot;once_e1d9wrje_6 &gt; 0&quot;,&quot;neg&quot;:true,&quot;to&quot;:9},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;set&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;once_e1d9wrje_6 : 1&quot;,&quot;ln&quot;:9},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;save_value&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;once_e1d9wrje_6&quot;,&quot;ln&quot;:10},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;add&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;trophies : 1&quot;,&quot;ln&quot;:11},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;save_value&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;trophies&quot;,&quot;ln&quot;:12},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;message&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;New trophy! You beat the Zombie Arena&quot;,&quot;ln&quot;:13},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;coins&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;player_main : 25&quot;,&quot;ln&quot;:15},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;teleport&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;player_main : Hub_Spawn&quot;,&quot;ln&quot;:16},{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;wait_while&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;defeated == 4&quot;,&quot;ln&quot;:17},{&quot;k&quot;:&quot;jmp&quot;,&quot;to&quot;:1,&quot;y&quot;:1}],&quot;handlers&quot;:[{&quot;ev&quot;:&quot;on_bot_death&quot;,&quot;arg&quot;:&quot;&quot;,&quot;ops&quot;:[{&quot;k&quot;:&quot;act&quot;,&quot;name&quot;:&quot;add&quot;,&quot;tgt&quot;:null,&quot;conn&quot;:null,&quot;carg&quot;:&quot;&quot;,&quot;args&quot;:&quot;defeated : 1&quot;,&quot;ln&quot;:3}]}],&quot;funcs&quot;:{},&quot;rules&quot;:[]}</string></Properties><Item class="StringValue" referent="RBX000002D2"><Properties><string name="Name">BuildXSource</string><string name="Value">#set = defeated : 0
#on_bot_death
#add = defeated : 1
#end
#if = defeated = 4 = then
#once_ever
#add = trophies : 1
#save_value = trophies
#message = New trophy! You beat the Zombie Arena
#end
#coins = player_main : 25
#teleport = player_main : Hub_Spawn
#end</string></Properties></Item></Item></Item><Item class="Script" referent="RBX000002EE"><Properties><string name="Name">READ ME - how this game works</string><bool name="Disabled">true</bool><ProtectedString name="Source"><![CDATA[--[[
GAME HUB - HOW EVERYTHING WORKS
This game was made in BuildX and exported for Roblox. Everything is in this one file.

== 1. Opening the game ==
In Roblox Studio (on a laptop or PC): File > Open from File, then pick the .rbxlx file.
Open the Explorer and Properties windows from the View tab if you cannot see them.

== 2. Meshes and pictures (do this once per game) ==
This game has 5 meshes.
Until you make them, meshes show as plain blocks in edit mode (they get their real shape when you press Play).
First time only: in the Explorer, open ServerStorage, right-click "BuildX Mesh Maker" and choose Save as Local Plugin.
Then: Plugins tab > BuildX > Make meshes. It uploads the meshes and pictures to your Roblox account and puts them in place.
Save the game afterwards (File > Save to File, or publish). Ctrl+Z undoes it.
If it says some are not ready yet, wait a minute and press Make meshes again (new uploads take a moment).
Do this before you publish, so everyone sees the real meshes and pictures.

== 3. Playing and testing ==
Home tab > Play to test as a player. Stop to go back to editing.
Test tab > Clients and Servers lets you test with 2 or more players.
The View tab > Output window shows messages from the game. If a BuildX command does not work in Roblox, it says so there and skips that line.

== 4. Where everything is ==
Workspace: everything in your world (parts, models, bots, spawn pads).
ServerStorage > Storage: things kept out of the world (BuildX Storage), copied in by your code.
ServerScriptService > BuildXRuntime: the script that runs all the BuildX code. Do not delete it.
   BuildXData inside it: the game settings (colors, materials, sounds, items, leaderboard, walk speed...).
ServerScriptService > BuildXScripts: your BuildX Scripts.
StarterGui: your GUIs. StarterPlayer: walk speed and jump power. Lighting: time of day, fog and sky.
ReplicatedStorage: BuildXRemote (talks between the game and the players), BuildXMeshData.

== 5. Your code ==
Every part, model or bot with code has two values inside it:
   BuildXSource = the code you wrote in BuildX (for reading).
   BuildXCode = the same code made ready to run. This is what the game runs.
To change code, change it in BuildX and export again. Editing BuildXSource in Studio does not change the game.
You can still move, resize, recolor, copy and delete parts in Studio. Copies keep their code.

== 6. Bots ==
Each bot is a Model with a Humanoid. Change its health, walk speed and jump power in the Humanoid.
BuildXBehavior (inside the bot) is what it does: Idle, Static, Wander, Patrol, Follow, Chase, Flee or Dance.
BuildXRespawn = true means it comes back after it dies.
The bot is a cube: HumanoidRootPart moves it, Body is what you see.

== 7. GUIs ==
Your GUIs are in StarterGui. You can move and recolor things in Studio.
The BuildX values inside buttons (BuildXMode, BuildXLook...) tell the game how the button works. Leave them as they are.

== 8. Saving player data ==
This game saves things for players (save_value / load_value / once_ever). Roblox saves only work after the game is published.
To test saves in Studio: publish once, then Home > Game Settings > Security > turn on "Enable Studio Access to API Services".

== 9. Putting it online ==
Make the meshes first (step 2).
File > Publish to Roblox, give it a name, then Publish.
To let everyone play: Home > Game Settings > Permissions > Public, then Save.
Phones, tablets, PCs and consoles all work. Roblox adds its own controls.

== 10. If something goes wrong ==
Open View > Output and press Play. Lines starting with [BuildX] tell you what happened.
If a part does nothing, check that it still has its BuildXCode value inside it.
You can always export the game from BuildX again.
]]
return nil
]]></ProtectedString></Properties></Item></Item>
<Item class="StarterGui" referent="RBX000002F0"><Properties><string name="Name">StarterGui</string></Properties><Item class="ScreenGui" referent="RBX000002DD"><Properties><string name="Name">Hud</string><bool name="Enabled">true</bool><bool name="ResetOnSpawn">false</bool><bool name="IgnoreGuiInset">false</bool><token name="ScreenInsets">2</token><token name="ZIndexBehavior">1</token></Properties><Item class="BoolValue" referent="RBX000002D4"><Properties><string name="Name">BuildXGui</string><bool name="Value">true</bool></Properties></Item><Item class="TextLabel" referent="RBX000002D8"><Properties><string name="Name">Trophies</string><UDim2 name="Position"><XS>0.02</XS><XO>0</XO><YS>0.02</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.24</XS><XO>0</XO><YS>0.08</YS><YO>0</YO></UDim2><Color3 name="BackgroundColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="BackgroundTransparency">0.55</float><int name="BorderSizePixel">0</int><bool name="Visible">true</bool><int name="ZIndex">1</int><string name="Text">Trophies:  / 5</string><Color3 name="TextColor3"><R>1</R><G>0.87843</G><B>0.54118</B></Color3><float name="TextSize">24</float><token name="Font">19</token><bool name="TextWrapped">true</bool><token name="TextXAlignment">2</token><float name="TextStrokeTransparency">1</float><Color3 name="TextStrokeColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextTransparency">0</float></Properties><Item class="StringValue" referent="RBX000002D5"><Properties><string name="Name">BuildXText</string><string name="Value">Trophies: {trophies} / 5</string></Properties></Item><Item class="StringValue" referent="RBX000002D6"><Properties><string name="Name">BuildXPath</string><string name="Value">Hud.Trophies</string></Properties></Item><Item class="StringValue" referent="RBX000002D7"><Properties><string name="Name">BuildXType</string><string name="Value">Text</string></Properties></Item></Item><Item class="TextLabel" referent="RBX000002DC"><Properties><string name="Name">Coins</string><UDim2 name="Position"><XS>0.02</XS><XO>0</XO><YS>0.11</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.24</XS><XO>0</XO><YS>0.08</YS><YO>0</YO></UDim2><Color3 name="BackgroundColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="BackgroundTransparency">0.55</float><int name="BorderSizePixel">0</int><bool name="Visible">true</bool><int name="ZIndex">1</int><string name="Text">Coins: </string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">22</float><token name="Font">19</token><bool name="TextWrapped">true</bool><token name="TextXAlignment">2</token><float name="TextStrokeTransparency">1</float><Color3 name="TextStrokeColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextTransparency">0</float></Properties><Item class="StringValue" referent="RBX000002D9"><Properties><string name="Name">BuildXText</string><string name="Value">Coins: {coins}</string></Properties></Item><Item class="StringValue" referent="RBX000002DA"><Properties><string name="Name">BuildXPath</string><string name="Value">Hud.Coins</string></Properties></Item><Item class="StringValue" referent="RBX000002DB"><Properties><string name="Name">BuildXType</string><string name="Value">Text</string></Properties></Item></Item></Item></Item>
<Item class="StarterPlayer" referent="RBX000002F3"><Properties><string name="Name">StarterPlayer</string><float name="CharacterWalkSpeed">16</float><bool name="CharacterUseJumpPower">true</bool><float name="CharacterJumpPower">53.15</float></Properties><Item class="StarterPlayerScripts" referent="RBX000002F2"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX000002F1"><Properties><string name="Name">BuildXClient</string><ProtectedString name="Source"><![CDATA[-- BuildX runtime for Roblox: the screen side (GUIs, messages, camera, keys, flying).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local plr = Players.LocalPlayer
local pgui = plr:WaitForChild("PlayerGui")
local Remote = ReplicatedStorage:WaitForChild("BuildXRemote")
local cam = workspace.CurrentCamera

local VARS = {}
local function lower(s) return string.lower(tostring(s or "")) end
local function trim(s) return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")) end
local function interp(s) return (tostring(s or ""):gsub("{([%w_]+)}", function(v) local x = VARS[lower(v)]; if x == nil then return "" end if type(x) == "number" and x % 1 ~= 0 then return string.format("%.1f", x) end return tostring(x) end)) end

local function A(inst, name) local v = inst:FindFirstChild(name); if v and v:IsA("ValueBase") then return v.Value end return inst:GetAttribute(name) end
local function setA(inst, name, val) local v = inst:FindFirstChild(name); if v and v:IsA("ValueBase") then pcall(function() v.Value = val end) else inst:SetAttribute(name, val) end end
---------------------------------------------------------------- the overlay (messages, titles, toasts)
local hud = Instance.new("ScreenGui")
hud.Name = "BuildXHud"; hud.ResetOnSpawn = false; hud.IgnoreGuiInset = true; hud.DisplayOrder = 50; hud.Parent = pgui
local function label(name, pos, size, ts)
	local t = Instance.new("TextLabel")
	t.Name = name; t.AnchorPoint = Vector2.new(0.5, 0.5); t.Position = pos; t.Size = size
	t.BackgroundTransparency = 1; t.TextColor3 = Color3.new(1, 1, 1); t.TextStrokeTransparency = 0.35
	t.Font = Enum.Font.GothamBold; t.TextScaled = true; t.Visible = false; t.Parent = hud
	local c = Instance.new("UITextSizeConstraint"); c.MaxTextSize = ts; c.Parent = t
	return t
end
local title = label("Title", UDim2.new(0.5, 0, 0.38, 0), UDim2.new(0.8, 0, 0.14, 0), 72)
local msg = label("Message", UDim2.new(0.5, 0, 0.5, 0), UDim2.new(0.8, 0, 0.08, 0), 34)
local toast = label("Toast", UDim2.new(0.5, 0, 0.82, 0), UDim2.new(0.6, 0, 0.05, 0), 24)
local timerL = label("Timer", UDim2.new(0.5, 0, 0.06, 0), UDim2.new(0.3, 0, 0.06, 0), 30)
local flash = Instance.new("Frame"); flash.Size = UDim2.new(1, 0, 1, 0); flash.BackgroundColor3 = Color3.new(1, 1, 1); flash.BackgroundTransparency = 1; flash.BorderSizePixel = 0; flash.Parent = hud
local tok = {}
-- notifications: dark cards stacked at the top right, like in BuildX
local cards = Instance.new("Frame"); cards.Name = "Notifications"; cards.BackgroundTransparency = 1; cards.AnchorPoint = Vector2.new(1, 0)
cards.Position = UDim2.new(1, -12, 0, 150); cards.Size = UDim2.new(0.45, 0, 0.6, 0); cards.Parent = hud
do local ll = Instance.new("UIListLayout"); ll.HorizontalAlignment = Enum.HorizontalAlignment.Right; ll.Padding = UDim.new(0, 5); ll.SortOrder = Enum.SortOrder.LayoutOrder; ll.Parent = cards end
local cardN = 0
local function addCard(text, secs)
	cardN = cardN + 1
	local c = Instance.new("TextLabel"); c.Name = "Card"; c.LayoutOrder = cardN; c.AutomaticSize = Enum.AutomaticSize.XY; c.Size = UDim2.new(0, 0, 0, 0)
	c.BackgroundColor3 = Color3.new(0, 0, 0); c.BackgroundTransparency = 0.3; c.BorderSizePixel = 0
	c.Font = Enum.Font.GothamBold; c.TextSize = 16; c.TextColor3 = Color3.new(1, 1, 1); c.Text = text; c.TextWrapped = false
	local pd = Instance.new("UIPadding"); pd.PaddingLeft = UDim.new(0, 11); pd.PaddingRight = UDim.new(0, 11); pd.PaddingTop = UDim.new(0, 6); pd.PaddingBottom = UDim.new(0, 6); pd.Parent = c
	local cr = Instance.new("UICorner"); cr.CornerRadius = UDim.new(0, 8); cr.Parent = c
	c.Parent = cards
	local kids = {} for _, k in ipairs(cards:GetChildren()) do if k:IsA("TextLabel") then table.insert(kids, k) end end
	if #kids > 5 then table.sort(kids, function(x, y) return x.LayoutOrder < y.LayoutOrder end) kids[1]:Destroy() end
	task.delay(secs or 3, function() if c.Parent then c:Destroy() end end)
end
local function showFor(l, text, secs)
	if l == toast then addCard(text, secs) return end
	l.Text = text; l.Visible = true
	local t = {} tok[l] = t
	task.delay(secs or 3, function() if tok[l] == t then l.Visible = false end end)
end

---------------------------------------------------------------- the BuildX GUIs (made into ScreenGuis in StarterGui)
local function allGuis() local o = {} for _, g in ipairs(pgui:GetChildren()) do if g:IsA("LayerCollector") and A(g, "BuildXGui") then table.insert(o, g) end end return o end
local function findGui(name) for _, g in ipairs(allGuis()) do if lower(g.Name) == lower(trim(name)) then return g end end return nil end
local function findThing(path)
	path = trim(path)
	local gname, ename = path:match("^([^%.]+)%.(.+)$")
	for _, g in ipairs(allGuis()) do
		for _, d in ipairs(g:GetDescendants()) do
			local p = A(d, "BuildXPath")
			if p and (lower(p) == lower(path) or (not gname and lower(d.Name) == lower(path)) or (gname and lower(g.Name) == lower(gname) and lower(d.Name) == lower(ename))) then return d end
		end
	end
	return nil
end
local function setVis(d, v)
	d.Visible = v
	local p = A(d, "BuildXPath")
	if p then Remote:FireServer("gvis", p, v) end
end
local function refreshTexts()
	for _, g in ipairs(allGuis()) do
		for _, d in ipairs(g:GetDescendants()) do
			local raw = A(d, "BuildXText")
			if raw and (d:IsA("TextLabel") or d:IsA("TextButton")) then d.Text = interp(raw) end
			local bar = A(d, "BuildXBarVar")
			if bar and bar ~= "" and VARS[lower(bar)] ~= nil then
				local fill = d:FindFirstChild("Fill")
				local mx = A(d, "BuildXMax") or 100
				if fill then fill.Size = UDim2.new(math.clamp((tonumber(VARS[lower(bar)]) or 0) / mx, 0, 1), 0, 1, 0) end
			end
		end
	end
end
local function setValue(d, v)
	local mx = A(d, "BuildXMax") or 100
	local mn = A(d, "BuildXMin") or 0
	local fill = d:FindFirstChild("Fill")
	if fill then fill.Size = UDim2.new(math.clamp((v - mn) / math.max(1e-6, mx - mn), 0, 1), 0, 1, 0) end
	setA(d, "BuildXValue", v)
	local var = A(d, "BuildXVar")
	if var and var ~= "" then Remote:FireServer("var", var, v) end
end

local function isOff(d) return A(d, "BuildXDisabled") == true end
local function applyToggle(d, v)
	setA(d, "BuildXValue", v)
	local st = A(d, "BuildXTStyle") or "Switch"
	local on = v == 1
	local onC = A(d, "BuildXOnColor") or Color3.fromRGB(47, 191, 91)
	local offC = A(d, "BuildXOffColor") or Color3.fromRGB(85, 91, 104)
	local knob = d:FindFirstChild("Knob"); if knob then knob.Position = UDim2.new(on and 0.55 or 0.05, 0, 0.1, 0); knob.Visible = string.find(string.lower(st), "switch") ~= nil end
	d.BackgroundColor3 = (on and st ~= "Radio dot" and st ~= "Light") and onC or offC
	if st == "Thin switch" or st == "ON/OFF text" then d.BackgroundTransparency = 1 end
	local tr = d:FindFirstChild("Track"); if tr then tr.BackgroundColor3 = on and onC or offC end
	local ck = d:FindFirstChild("Check"); if ck then ck.Visible = st == "Checkbox" and on end
	local cx = d:FindFirstChild("Cross"); if cx then cx.Visible = st == "Cross box" and on end
	local dot = d:FindFirstChild("Dot")
	if dot then
		if st == "Light" then dot.BackgroundColor3 = on and (A(d, "BuildXLightColor") or Color3.fromRGB(255, 224, 102)) or Color3.fromRGB(44, 47, 54) end
		local inn = dot:FindFirstChild("Inner"); if inn then inn.Visible = on end
	end
	local lb = d:FindFirstChild("Label")
	if lb then
		local t = on and (A(d, "BuildXOnText") or "") or (A(d, "BuildXOffText") or "")
		if t == "" and (st == "Button" or st == "ON/OFF text") then t = on and "ON" or "OFF" end
		lb.Text = t; lb.Visible = t ~= "" and st ~= "Checkbox" and st ~= "Cross box"
		if st == "Button" or st == "ON/OFF text" then lb.Position = UDim2.new(0, 0, 0, 0); lb.Size = UDim2.new(1, 0, 1, 0); lb.TextXAlignment = Enum.TextXAlignment.Center
		elseif st == "Radio dot" or st == "Light" then lb.Position = UDim2.new(0.3, 0, 0, 0); lb.Size = UDim2.new(0.65, 0, 1, 0); lb.TextXAlignment = Enum.TextXAlignment.Left
		else lb.Position = UDim2.new(on and 0.08 or 0.5, 0, 0, 0); lb.Size = UDim2.new(0.42, 0, 1, 0); lb.TextXAlignment = on and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right end
		if st == "ON/OFF text" then lb.TextColor3 = on and onC or offC end
	end
end
local function fade(d, off)
	if off then
		if d:GetAttribute("BxBgT") == nil then d:SetAttribute("BxBgT", d.BackgroundTransparency); if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then d:SetAttribute("BxTxT", d.TextTransparency) end end
		d.BackgroundTransparency = 1 - (1 - (d:GetAttribute("BxBgT") or 0)) * 0.5
		if d:GetAttribute("BxTxT") ~= nil then d.TextTransparency = 1 - (1 - d:GetAttribute("BxTxT")) * 0.5 end
	elseif d:GetAttribute("BxBgT") ~= nil then
		d.BackgroundTransparency = d:GetAttribute("BxBgT"); if d:GetAttribute("BxTxT") ~= nil then d.TextTransparency = d:GetAttribute("BxTxT") end
	end
end
local function isPress(io) return io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch end
-- button modes: Click, Double tap, Long press, Repeat while held, Once only; hover and pressed colors
local function hookClick(d, path)
	local m = A(d, "BuildXMode") or "Click"
	local function cool()
		local c = A(d, "BuildXCool") or 0
		if c > 0 then local t = os.clock(); if (d:GetAttribute("BxCd") or 0) > t then return false end d:SetAttribute("BxCd", t + c) end
		return true
	end
	local function fire() Remote:FireServer("gclick", path) end
	if m == "Long press" then
		local holding = 0
		d.InputBegan:Connect(function(io)
			if not isPress(io) or isOff(d) then return end
			holding = holding + 1; local my = holding; local t = A(d, "BuildXLongTime") or 1
			if A(d, "BuildXLongBar") ~= false then
				local bar = Instance.new("Frame"); bar.Name = "LongBar"; bar.BorderSizePixel = 0; bar.BackgroundColor3 = A(d, "BuildXLongColor") or Color3.new(1, 1, 1); bar.BackgroundTransparency = 0.15
				bar.Position = UDim2.new(0, 0, 0.86, 0); bar.Size = UDim2.new(0, 0, 0.14, 0); bar.ZIndex = d.ZIndex + 1; bar.Parent = d
				TweenService:Create(bar, TweenInfo.new(t, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 0.14, 0)}):Play()
			end
			task.delay(t, function() if holding == my then holding = holding + 1; local b = d:FindFirstChild("LongBar"); if b then b:Destroy() end if cool() then fire() end end end)
		end)
		UserInputService.InputEnded:Connect(function(io) if isPress(io) then holding = holding + 1; local b = d:FindFirstChild("LongBar"); if b then b:Destroy() end end end)
	elseif m == "Repeat while held" then
		local held = 0
		d.InputBegan:Connect(function(io)
			if not isPress(io) or isOff(d) then return end
			held = held + 1; local my = held
			if cool() then fire() end
			task.delay(A(d, "BuildXRepDelay") or 0.4, function() while held == my do fire(); task.wait(math.max(0.05, A(d, "BuildXRepEvery") or 0.2)) end end)
		end)
		UserInputService.InputEnded:Connect(function(io) if isPress(io) then held = held + 1 end end)
	else
		local last = 0
		d.Activated:Connect(function()
			if isOff(d) then return end
			if m == "Double tap" then local t = os.clock(); if t - last > (A(d, "BuildXGap") or 0.35) then last = t; return end last = 0 end
			if m == "Once only" and d:GetAttribute("BxUsed") then return end
			if not cool() then return end
			if m == "Once only" then
				d:SetAttribute("BxUsed", true)
				local tx = A(d, "BuildXOnceText"); if tx and tx ~= "" and d:IsA("TextButton") then d.Text = tx end
				local a = A(d, "BuildXOnceAfter") or "Fade"
				if a == "Fade" then setA(d, "BuildXDisabled", true); fade(d, true) elseif a == "Hide" then d.Visible = false end
			end
			fire()
		end)
	end
	local hov, prs = A(d, "BuildXHoverColor"), A(d, "BuildXPressColor")
	local ghost = A(d, "BuildXLook") == "Ghost"
	if hov or prs or ghost then
		local saved, savedT
		local over, down = false, false
		local function paint()
			if not over and not down then if saved then d.BackgroundColor3 = saved; d.BackgroundTransparency = savedT; saved = nil end return end
			if not saved then saved = d.BackgroundColor3; savedT = d.BackgroundTransparency end
			d.BackgroundColor3 = (down and prs) or (over and hov) or saved
			if ghost then d.BackgroundTransparency = 1 - (A(d, "BuildXGhostAlpha") or 1) end
		end
		d.MouseEnter:Connect(function() over = true; paint() end)
		d.MouseLeave:Connect(function() over = false; down = false; paint() end)
		d.InputBegan:Connect(function(io) if isPress(io) then down = true; paint() end end)
		d.InputEnded:Connect(function(io) if isPress(io) then down = false; paint() end end)
	end
end
local function hookGui(g)
	for _, d in ipairs(g:GetDescendants()) do
		local path = A(d, "BuildXPath")
		local typ = A(d, "BuildXType")
		if path then
			if d:IsA("GuiButton") and (A(d, "BuildXClick") or typ == "Button") and typ ~= "Toggle" and typ ~= "Dropdown" and typ ~= "Slider" then
				hookClick(d, path)
			end
			if typ == "TextBox" and d:IsA("TextBox") then
				d.FocusLost:Connect(function() local var = A(d, "BuildXVar"); if var and var ~= "" then Remote:FireServer("var", var, d.Text) end Remote:FireServer("gclick", path) end)
			elseif typ == "Toggle" then
				applyToggle(d, (A(d, "BuildXValue") or 0) == 1 and 1 or 0)
				local m = A(d, "BuildXMode") or "Toggle"
				local function set(x, who)
					who = who or d; applyToggle(who, x)
					local var = A(who, "BuildXVar"); if var and var ~= "" then Remote:FireServer("var", var, x) end
					Remote:FireServer("gclick", A(who, "BuildXPath"), x)
				end
				if m == "Hold" then
					d.InputBegan:Connect(function(io) if isPress(io) and not isOff(d) and (A(d, "BuildXValue") or 0) ~= 1 then set(1) end end)
					UserInputService.InputEnded:Connect(function(io) if isPress(io) and (A(d, "BuildXValue") or 0) == 1 then set(0) end end)
				else
					d.Activated:Connect(function()
						if isOff(d) then return end
						local on = (A(d, "BuildXValue") or 0) == 1
						if m == "Latch" then
							if on then return end
							set(1)
							local t = A(d, "BuildXLatchTime") or 0
							if t > 0 then local tok = os.clock(); d:SetAttribute("BxLatch", tok); task.delay(t, function() if d:GetAttribute("BxLatch") == tok and (A(d, "BuildXValue") or 0) == 1 then set(0) end end) end
						elseif m == "Pick one" then
							if on then return end
							local gr = string.lower(trim(A(d, "BuildXGroup") or "Group1"))
							for _, o in ipairs(g:GetDescendants()) do
								if o ~= d and A(o, "BuildXType") == "Toggle" and A(o, "BuildXMode") == "Pick one" and string.lower(trim(A(o, "BuildXGroup") or "Group1")) == gr and (A(o, "BuildXValue") or 0) == 1 then set(0, o) end
							end
							set(1)
						else set(on and 0 or 1) end
					end)
				end
			elseif typ == "Dropdown" then
				local m = A(d, "BuildXMode") or "Dropdown"; local lk = A(d, "BuildXLook") or ""
				local function opts() local t = {}; for o in tostring(A(d, "BuildXOptions") or ""):gmatch("[^,]+") do table.insert(t, trim(o)) end return t end
				local function dots() local f = d:FindFirstChild("Dots"); if not f then return end for i, x in ipairs(opts()) do local c = f:FindFirstChild("Dot" .. i); if c then c.BackgroundTransparency = (x == d.Text) and 0 or 0.65 end end end
				local function pick(v)
					d.Text = v; dots()
					local var = A(d, "BuildXVar"); if var and var ~= "" then Remote:FireServer("var", var, v) end
					Remote:FireServer("gclick", path, v)
				end
				if m == "Cycle" then
					local lastX
					d.InputBegan:Connect(function(io) if isPress(io) then lastX = io.Position.X end end)
					d.Activated:Connect(function()
						if isOff(d) then return end
						local o = opts(); if #o == 0 then return end
						local i = 1; for k, x in ipairs(o) do if x == d.Text then i = k end end
						local dir = 1
						if lk == "Arrows on the sides" and lastX and lastX < d.AbsolutePosition.X + d.AbsoluteSize.X / 2 then dir = -1 end
						local n = i + dir
						if n < 1 or n > #o then if A(d, "BuildXWrap") == false then return end n = (n - 1) % #o + 1 end
						pick(o[n])
					end)
				else
					local list
					d.Activated:Connect(function()
						if isOff(d) then return end
						if list then list:Destroy(); list = nil; return end
						local o = opts(); if #o == 0 then return end
						local rows = math.min(#o, math.max(1, A(d, "BuildXListMax") or 6))
						list = Instance.new("ScrollingFrame"); list.Name = "List"; list.BorderSizePixel = 0; list.ScrollBarThickness = 4
						list.BackgroundColor3 = A(d, "BuildXListColor") or d.BackgroundColor3; list.ZIndex = d.ZIndex + 5
						list.Size = UDim2.new(1, 0, rows, 0); list.CanvasSize = UDim2.new(0, 0, 0, 0); list.AutomaticCanvasSize = Enum.AutomaticSize.Y
						if lk == "Opens up" then list.AnchorPoint = Vector2.new(0, 1); list.Position = UDim2.new(0, 0, 0, 0)
						elseif lk == "Opens to the side" then list.Position = UDim2.new(1, 0, 0, 0)
						else list.Position = UDim2.new(0, 0, 1, 0) end
						local lay = Instance.new("UIListLayout"); lay.SortOrder = Enum.SortOrder.LayoutOrder; lay.Parent = list
						local h = d.AbsoluteSize.Y
						for i, x in ipairs(o) do
							local b = Instance.new("TextButton"); b.Name = "Choice" .. i; b.LayoutOrder = i; b.Size = UDim2.new(1, 0, 0, h)
							b.BackgroundColor3 = Color3.fromRGB(61, 139, 255); b.BackgroundTransparency = (x == d.Text) and 0.75 or 1
							b.Text = x; b.TextColor3 = d.TextColor3; b.Font = d.Font; b.TextSize = d.TextSize; b.ZIndex = list.ZIndex + 1; b.AutoButtonColor = false; b.Parent = list
							b.Activated:Connect(function() if list then list:Destroy(); list = nil end pick(x) end)
						end
						list.Parent = d
					end)
				end
			elseif typ == "Slider" then
				local dragging = false
				local function at(x)
					if isOff(d) then return end
					local a = d.AbsolutePosition.X; local w = math.max(1, d.AbsoluteSize.X)
					local mn = A(d, "BuildXMin") or 0; local mx = A(d, "BuildXMax") or 100
					setValue(d, math.floor(mn + math.clamp((x - a) / w, 0, 1) * (mx - mn) + 0.5))
				end
				d.InputBegan:Connect(function(io) if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then dragging = true; at(io.Position.X) end end)
				UserInputService.InputChanged:Connect(function(io) if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then at(io.Position.X) end end)
				UserInputService.InputEnded:Connect(function(io) if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then if dragging then dragging = false; Remote:FireServer("gclick", path, A(d, "BuildXValue")) end end end)
			end
		end
	end
end
for _, g in ipairs(allGuis()) do hookGui(g) end
for _, g in ipairs(allGuis()) do for _, d in ipairs(g:GetDescendants()) do if A(d, "BuildXPath") and isOff(d) then fade(d, true) end end end
pgui.ChildAdded:Connect(function(g) if g:IsA("LayerCollector") and A(g, "BuildXGui") then task.wait(); hookGui(g) end end)

---------------------------------------------------------------- flying
local flyOn, flyConn, flyVel, flyGyro = false, nil, nil, nil
local function setFly(on)
	local ch = plr.Character; local root = ch and ch:FindFirstChild("HumanoidRootPart"); local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if flyConn then flyConn:Disconnect(); flyConn = nil end
	if flyVel then flyVel:Destroy(); flyVel = nil end
	flyOn = on
	if not on or not root or not hum then if hum then hum.PlatformStand = false end return end
	local at = root:FindFirstChild("BuildXFlyAt") or Instance.new("Attachment", root); at.Name = "BuildXFlyAt"
	flyVel = Instance.new("LinearVelocity"); flyVel.Attachment0 = at; flyVel.MaxForce = 1e6; flyVel.RelativeTo = Enum.ActuatorRelativeTo.World; flyVel.Parent = root
	flyConn = RunService.RenderStepped:Connect(function()
		local dir = hum.MoveDirection * 40
		local up = 0
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump then up = 30 end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then up = -30 end
		flyVel.VectorVelocity = Vector3.new(dir.X, up, dir.Z)
	end)
end
plr.CharacterAdded:Connect(function() flyOn = false; if flyConn then flyConn:Disconnect(); flyConn = nil end end)

---------------------------------------------------------------- what the server asks for
local cc -- ColorCorrection for screen looks
local function colorFx() if not cc then cc = Instance.new("ColorCorrectionEffect"); cc.Name = "BuildXScreen"; cc.Parent = Lighting end return cc end
local shakeUntil = 0
local timerOn = false
local countdownT = nil

Remote.OnClientEvent:Connect(function(kind, a, b)
	if kind == "title" then showFor(title, tostring(a), tonumber(b) or 3)
	elseif kind == "toast" then showFor(toast, tostring(a), 2.5)
	elseif kind == "message" then showFor(msg, tostring(a), 4)
	elseif kind == "chat" then if _G.BuildXChatLog then _G.BuildXChatLog(tostring(a), tostring(b)) end
	elseif kind == "vars" then VARS = {} for k, v in pairs(a or {}) do VARS[lower(k)] = v end refreshTexts()
	elseif kind == "gui" then
		local name = tostring(a)
		for _, g in ipairs(allGuis()) do
			if name == "*" or lower(g.Name) == lower(name) then
				local v = b
				if b == "toggle" then v = not g.Enabled end
				g.Enabled = v and true or false
				Remote:FireServer("gvis", g.Name, g.Enabled)
			end
		end
	elseif kind == "gset" then
		local d = findThing(a)
		if not d then local g = findGui(a); if g and b and b.hidden ~= nil then g.Enabled = not b.hidden end return end
		b = b or {}
		if b.text ~= nil and (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) then setA(d, "BuildXText", tostring(b.text)); d.Text = interp(b.text) end
		if b.hidden ~= nil then setVis(d, not b.hidden) end
		if b.value ~= nil then setValue(d, tonumber(b.value) or 0) end
		local function col(x) local h = tostring(x):gsub("#", ""); return Color3.fromRGB(tonumber(h:sub(1, 2), 16) or 255, tonumber(h:sub(3, 4), 16) or 255, tonumber(h:sub(5, 6), 16) or 255) end
		local isText = d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")
		if b.bg then d.BackgroundColor3 = col(b.bg); if A(d, "BuildXType") == "Toggle" then local v = A(d, "BuildXValue") == 1; local cv = d:FindFirstChild(v and "BuildXOnColor" or "BuildXOffColor"); if cv then cv.Value = d.BackgroundColor3 end end end
		if b.addText and isText then local t = (A(d, "BuildXText") or d.Text) .. tostring(b.addText); setA(d, "BuildXText", t); d.Text = interp(t) end
		if b.textColor and isText then d.TextColor3 = col(b.textColor) end
		if b.alpha then d.BackgroundTransparency = 1 - b.alpha; if d:GetAttribute("BxBgT") ~= nil then d:SetAttribute("BxBgT", 1 - b.alpha) end end
		if b.textSize and isText then d.TextScaled = false; d.TextSize = b.textSize * cam.ViewportSize.Y / 720 end
		if b.font and isText then for _, it in ipairs(Enum.Font:GetEnumItems()) do if it.Value == (b.bold == false and b.font[1] or b.font[2] or b.font[1]) then d.Font = it break end end end
		if b.bold ~= nil and isText and not b.font then local w = d.FontFace; pcall(function() d.FontFace = Font.new(w.Family, b.bold and Enum.FontWeight.Bold or Enum.FontWeight.Regular, w.Style) end) end
		if b.x or b.y then local p = d.Position; d.Position = UDim2.new(b.x and b.x / 100 or p.X.Scale, p.X.Offset, b.y and b.y / 100 or p.Y.Scale, p.Y.Offset) end
		if b.dx or b.dy then local p = d.Position; d.Position = UDim2.new(p.X.Scale + (b.dx or 0) / 100, p.X.Offset, p.Y.Scale + (b.dy or 0) / 100, p.Y.Offset) end
		if b.w or b.h then local z = d.Size; d.Size = UDim2.new(b.w and b.w / 100 or z.X.Scale, z.X.Offset, b.h and b.h / 100 or z.Y.Scale, z.Y.Offset) end
		if b.rot then d.Rotation = b.rot end
		if b.drot then d.Rotation = d.Rotation + b.drot end
		if b.radius then local c = d:FindFirstChildOfClass("UICorner") or Instance.new("UICorner"); c.CornerRadius = UDim.new(0, b.radius * cam.ViewportSize.Y / 720); c.Parent = d end
		if b.stroke or b.strokeColor then local s = d:FindFirstChildOfClass("UIStroke"); if not s then s = Instance.new("UIStroke"); s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Thickness = 2; s.Parent = d end if b.stroke then s.Thickness = b.stroke; s.Enabled = b.stroke > 0 end if b.strokeColor then s.Color = col(b.strokeColor) end end
		if b.toggle ~= nil and A(d, "BuildXType") == "Toggle" then local v = b.toggle == "flip" and ((A(d, "BuildXValue") or 0) == 1 and 0 or 1) or b.toggle; applyToggle(d, v); local var = A(d, "BuildXVar"); if var and var ~= "" then Remote:FireServer("var", var, v) end end
		if b.options then setA(d, "BuildXOptions", b.options) end
		if b.choice and isText then d.Text = b.choice; local var = A(d, "BuildXVar"); if var and var ~= "" then Remote:FireServer("var", var, b.choice) end end
		if b.disabled ~= nil then setA(d, "BuildXDisabled", b.disabled); fade(d, b.disabled) end
		if b.toggleHidden then setVis(d, not d.Visible) end
	elseif kind == "fly" then setFly(a == true)
	elseif kind == "gravity" then workspace.Gravity = tonumber(a) or 196.2
	elseif kind == "camera_shake" then shakeUntil = os.clock() + (tonumber((tostring(a or ""):gsub("[^%d%.]", ""))) or 1)
	elseif kind == "zoom" then local n = tonumber(a) or 20; plr.CameraMinZoomDistance = math.max(0.5, n); plr.CameraMaxZoomDistance = n; task.delay(0.2, function() plr.CameraMinZoomDistance = 0.5; plr.CameraMaxZoomDistance = math.max(n, 128) end)
	elseif kind == "fov" then cam.FieldOfView = tonumber(a) or 70
	elseif kind == "first_person" then plr.CameraMode = Enum.CameraMode.LockFirstPerson
	elseif kind == "third_person" then plr.CameraMode = Enum.CameraMode.Classic; plr.CameraMinZoomDistance = 0.5
	elseif kind == "camera_reset" then cam.CameraType = Enum.CameraType.Custom; plr.CameraMode = Enum.CameraMode.Classic
	elseif kind == "view_camera" then cam.CameraType = Enum.CameraType.Scriptable; cam.CFrame = CFrame.new(unpack(a))
	elseif kind == "screen_flash" then flash.BackgroundTransparency = 0; TweenService:Create(flash, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
	elseif kind == "screen_fade" then flash.BackgroundColor3 = Color3.new(0, 0, 0); flash.BackgroundTransparency = 1; local t = TweenService:Create(flash, TweenInfo.new(0.6), {BackgroundTransparency = 0}); t:Play(); t.Completed:Wait(); TweenService:Create(flash, TweenInfo.new(0.6), {BackgroundTransparency = 1}):Play(); task.delay(0.7, function() flash.BackgroundColor3 = Color3.new(1, 1, 1) end)
	elseif kind == "screen_grayscale" then colorFx().Saturation = -1; colorFx().TintColor = Color3.new(1, 1, 1)
	elseif kind == "screen_sepia" then colorFx().Saturation = -0.6; colorFx().TintColor = Color3.fromRGB(255, 226, 180)
	elseif kind == "screen_invert" then colorFx().Contrast = -1
	elseif kind == "screen_blur" then local bl = Lighting:FindFirstChild("BuildXBlur") or Instance.new("BlurEffect", Lighting); bl.Name = "BuildXBlur"; bl.Size = 12
	elseif kind == "countdown" then countdownT = os.clock() + (tonumber(a) or 10)
	elseif kind == "timer" then timerOn = a == true
	elseif kind == "say" then
		showFor(toast, tostring(a), 3)
		pcall(function()
			local tts = Instance.new("AudioTextToSpeech"); tts.Text = tostring(a)
			local out = Instance.new("AudioDeviceOutput"); out.Parent = tts
			local w = Instance.new("Wire"); w.SourceInstance = tts; w.TargetInstance = out; w.Parent = tts
			tts.Parent = workspace; tts:Play()
			task.delay(20, function() tts:Destroy() end)
		end)
	end
end)

RunService.RenderStepped:Connect(function()
	if os.clock() < shakeUntil then
		local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		if h then h.CameraOffset = Vector3.new((math.random() - 0.5) * 0.8, (math.random() - 0.5) * 0.8, 0) end
	else
		local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		if h and h.CameraOffset.Magnitude > 0 then h.CameraOffset = Vector3.new() end
	end
	if countdownT then
		local left = math.ceil(countdownT - os.clock())
		if left > 0 then timerL.Visible = true; timerL.Text = tostring(left) else countdownT = nil; timerL.Visible = false end
	elseif timerOn then timerL.Visible = true; timerL.Text = tostring(VARS.timer or 0)
	else timerL.Visible = false end
end)

---------------------------------------------------------------- keys (for #on = key = e)
local function keyName(io)
	if io.KeyCode == Enum.KeyCode.Unknown then return nil end
	local n = lower(io.KeyCode.Name)
	if n == "space" then return "space" end
	return n
end
UserInputService.InputBegan:Connect(function(io, typing)
	if typing then return end
	local k = keyName(io); if k then Remote:FireServer("key", k, true) end
end)
UserInputService.InputEnded:Connect(function(io)
	local k = keyName(io); if k then Remote:FireServer("key", k, false) end
end)

do

---------------------------------------------------------------- abilities, camera looks, screen looks and weather
local AB = {}
local lastHid = nil
local airJumps, fuel, lastVY, dashCD, sprinting, hoverUntil = 0, 3, 0, 0, false, 0
local function body() local ch = plr.Character; return ch and ch:FindFirstChildOfClass("Humanoid"), ch and ch:FindFirstChild("HumanoidRootPart") end
local function inAir(h) local s = h:GetState(); return s == Enum.HumanoidStateType.Freefall or s == Enum.HumanoidStateType.Jumping end
local function jumpHeld() return UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA) or (AB._touchJump == true) end
local function doDash() local h, r = body(); if not r or os.clock() < dashCD then return end dashCD = os.clock() + 0.8; local l = r.CFrame.LookVector; r.AssemblyLinearVelocity = Vector3.new(l.X * 80, 10, l.Z * 80) end
local RP = RaycastParams.new(); RP.FilterType = Enum.RaycastFilterType.Exclude
local function wallHit(r, dir) RP.FilterDescendantsInstances = {plr.Character}; return workspace:Raycast(r.Position, dir * 2.5, RP) end
local force
local function gravForce(r, extra)
	if not force or force.Parent ~= r then
		local at = r:FindFirstChild("BXAbAtt") or Instance.new("Attachment"); at.Name = "BXAbAtt"; at.Parent = r
		force = Instance.new("VectorForce"); force.Name = "BXAbForce"; force.Attachment0 = at; force.RelativeTo = Enum.ActuatorRelativeTo.World; force.ApplyAtCenterOfMass = true; force.Parent = r
	end
	force.Force = Vector3.new(0, r.AssemblyMass * workspace.Gravity * extra, 0)
end
UserInputService.JumpRequest:Connect(function()
	local h, r = body(); if not h or not r then return end
	if not inAir(h) then return end
	if AB.walljump then
		for _, d in ipairs({r.CFrame.LookVector, -r.CFrame.LookVector, r.CFrame.RightVector, -r.CFrame.RightVector}) do
			local hit = wallHit(r, d)
			if hit then r.AssemblyLinearVelocity = hit.Normal * 40 + Vector3.new(0, 50, 0); return end
		end
	end
	if AB.infjump or airJumps < (AB.jumps or 0) then
		airJumps = airJumps + 1
		local v = r.AssemblyLinearVelocity; r.AssemblyLinearVelocity = Vector3.new(v.X, h.JumpPower, v.Z)
	end
end)
plr.CharacterAdded:Connect(function(ch)
	force = nil; airJumps = 0
	local h = ch:WaitForChild("Humanoid")
	h.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Landed then
			airJumps = 0
			local _, r = body()
			if r and AB.bounce and lastVY < -50 then task.defer(function() local v = r.AssemblyLinearVelocity; r.AssemblyLinearVelocity = Vector3.new(v.X, -lastVY * 0.6, v.Z) end) end
			if AB.bunny or AB.pogo then task.defer(function() h.Jump = true end) end
		end
	end)
end)
UserInputService.InputBegan:Connect(function(io, typing)
	if typing then return end
	if io.KeyCode == Enum.KeyCode.E and AB.dash then doDash() end
	if io.KeyCode == Enum.KeyCode.R and AB.sprint then sprinting = true; local h = body(); if h then h.WalkSpeed = h.WalkSpeed * 1.6 end end
	if (io.KeyCode == Enum.KeyCode.Q or io.KeyCode == Enum.KeyCode.C) and AB.pound then local h, r = body(); if h and r and inAir(h) then r.AssemblyLinearVelocity = Vector3.new(0, -150, 0) end end
end)
UserInputService.InputEnded:Connect(function(io) if io.KeyCode == Enum.KeyCode.R and sprinting then sprinting = false; local h = body(); if h then h.WalkSpeed = h.WalkSpeed / 1.6 end end end)
-- the controls are changed right after Roblox reads them
RunService:BindToRenderStep("BuildXControls", Enum.RenderPriority.Input.Value + 1, function()
	local h = body(); if not h then return end
	if not (AB.backwards or AB.mirror or AB.drunk or AB.autorun) then return end
	local d = h.MoveDirection
	if AB.autorun and d.Magnitude < 0.1 then local l = cam.CFrame.LookVector; d = Vector3.new(l.X, 0, l.Z).Unit end
	if AB.backwards then d = -d end
	if AB.mirror then local rv = cam.CFrame.RightVector; rv = Vector3.new(rv.X, 0, rv.Z).Unit; d = d - rv * (2 * d:Dot(rv)) end
	if AB.drunk and d.Magnitude > 0.1 then local a = math.sin(os.clock() * 2.3) * 0.6; d = CFrame.Angles(0, a, 0):VectorToWorldSpace(d) end
	h:Move(d, false)
end)
RunService.Heartbeat:Connect(function(dt)
	local h, r = body(); if not h or not r then return end
	local v = r.AssemblyLinearVelocity
	local air = inAir(h)
	local g = AB.gscale or 1
	local up = 1 - g
	if os.clock() < hoverUntil then up = 1; r.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z) end
	if AB.floatUp and AB.floatUp ~= 0 then up = 1; r.AssemblyLinearVelocity = Vector3.new(v.X, AB.floatUp, v.Z) end
	if up ~= 0 or force then gravForce(r, up) end
	v = r.AssemblyLinearVelocity
	if air and AB.glide and jumpHeld() and v.Y < -8 then r.AssemblyLinearVelocity = Vector3.new(v.X, -8, v.Z) end
	if air and AB.parachute and v.Y < -12 then r.AssemblyLinearVelocity = Vector3.new(v.X, -12, v.Z) end
	if AB.jetpack then
		if jumpHeld() and fuel > 0 then fuel = fuel - dt; r.AssemblyLinearVelocity = Vector3.new(v.X, math.min(v.Y + 160 * dt, 40), v.Z) elseif not air then fuel = math.min(3, fuel + dt) end
	end
	if AB.wallclimb and h.MoveDirection.Magnitude > 0.1 and wallHit(r, h.MoveDirection.Unit) then r.AssemblyLinearVelocity = Vector3.new(v.X, 14, v.Z) end
	if AB.pogo and not air then h.Jump = true end
	if AB.stopdead and not air and h.MoveDirection.Magnitude < 0.05 then r.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0) end
	if AB.spin and AB.spin ~= 0 then h.AutoRotate = false; r.CFrame = r.CFrame * CFrame.Angles(0, math.rad(AB.spin * dt), 0) elseif h.AutoRotate == false and not AB._noRot then h.AutoRotate = true end
	lastVY = r.AssemblyLinearVelocity.Y
end)

-- camera looks
local CS = {}
local camT = 0
local function rootPos() local _, r = body(); return r and r.Position or Vector3.new() end
local function clearCam() CS = {}; cam.CameraType = Enum.CameraType.Custom; plr.CameraMinZoomDistance = 0.5; plr.CameraMaxZoomDistance = 128; cam.FieldOfView = 70 end
local bars
local function letterbox(on)
	if on and not bars then
		bars = Instance.new("Frame"); bars.Name = "BuildXBars"; bars.BackgroundTransparency = 1; bars.Size = UDim2.new(1, 0, 1, 0); bars.Parent = hud
		for i = 0, 1 do local b = Instance.new("Frame"); b.BorderSizePixel = 0; b.BackgroundColor3 = Color3.new(0, 0, 0); b.Size = UDim2.new(1, 0, 0.11, 0); b.Position = UDim2.new(0, 0, i * 0.89, 0); b.Parent = bars end
	elseif not on and bars then bars:Destroy(); bars = nil end
end
local function V(s, d) local t = {} for x in tostring(s or ""):gmatch("[^,]+") do table.insert(t, tonumber(x)) end if #t >= 3 then return Vector3.new(t[1], t[2], t[3]) end return d end
local function TT(s, d) local n = tonumber((tostring(s or ""):gsub("[^%d%.]", ""))); if not n then return d end if tostring(s):find("ms") then n = n / 1000 elseif tostring(s):find("m") and not tostring(s):find("s") then n = n * 60 end return n end
local CAMF = {
	top_down = function() CS.fixed = "top" end, side_view = function() CS.fixed = "side" end,
	camera_follow = function(a) CS.follow = typeof(a) == "Instance" and a or nil end,
	camera_at = function(a) CS.fixed = "at"; CS.at = V(a, Vector3.new(0, 30, 40)) end,
	cinematic = function() letterbox(true) end, no_cinematic = function() letterbox(false) end,
	camera_orbit = function(a) CS.orbit = tonumber(a) or 0.3 end, camera_stop_orbit = function() CS.orbit = nil end,
	camera_low_angle = function() CS.pitch = 0.05 end, camera_high_angle = function() CS.pitch = 1.1 end, camera_level = function() CS.pitch = 0.25 end,
	camera_free_angle = function() CS.pitch = nil; CS.dist = nil; CS.yaw = nil end,
	camera_close = function() CS.dist = 12 end, camera_far = function() CS.dist = 90 end,
	camera_shoulder = function(a) CS.shoulder = tonumber(a) or 3; CS.dist = CS.dist or 18 end, camera_center = function() CS.shoulder = nil end,
	camera_look_at = function(a) CS.look = typeof(a) == "Instance" and a or nil end, camera_stop_looking = function() CS.look = nil end,
	camera_pan_to = function(a) local v, t = tostring(a):match("^([^:]*):?(.*)$"); local b = V(v); if b then CS.pan = {a = cam.CFrame, b = b, t = 0, d = TT(t, 2)} end end,
	camera_head_bob = function() CS.bob = true end, camera_no_bob = function() CS.bob = nil end,
	camera_roll = function(a) CS.roll = tonumber(a) or 10 end, camera_unroll = function() CS.roll = nil end,
	camera_breathe = function(a) CS.fov0 = CS.fov0 or cam.FieldOfView; CS.breathe = tonumber(a) or 4 end, camera_stop_breathe = function() CS.breathe = nil; if CS.fov0 then cam.FieldOfView = CS.fov0 end end,
	dolly_zoom = function(a) CS.dolly = {t = 0, d = TT(a, 2), f0 = cam.FieldOfView, d0 = (cam.CFrame.Position - rootPos()).Magnitude} end,
	camera_spin_once = function() CS.spin1 = 0 end,
	camera_behind = function() local _, r = body(); if r then cam.CFrame = CFrame.lookAt(r.Position - r.CFrame.LookVector * 15 + Vector3.new(0, 5, 0), r.Position) end end,
	camera_front = function() local _, r = body(); if r then cam.CFrame = CFrame.lookAt(r.Position + r.CFrame.LookVector * 15 + Vector3.new(0, 3, 0), r.Position) end end,
	camera_isometric = function() CS.pitch = 0.62; CS.yaw = math.pi / 4; CS.dist = 70 end,
	camera_birdseye = function() CS.pitch = 1.5; CS.dist = 60 end,
}
RunService:BindToRenderStep("BuildXCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if next(CS) == nil then return end
	camT = camT + dt
	local p = rootPos()
	local cf = cam.CFrame
	if CS.fixed then
		cam.CameraType = Enum.CameraType.Scriptable
		if CS.fixed == "top" then cf = CFrame.lookAt(p + Vector3.new(0, 60, 0.01), p)
		elseif CS.fixed == "side" then cf = CFrame.lookAt(p + Vector3.new(0, 5, 40), p)
		else cf = CFrame.lookAt(CS.at, p) end
	elseif CS.follow and CS.follow.Parent then cam.CameraType = Enum.CameraType.Scriptable; local q = CS.follow.Position; cf = CFrame.lookAt(q + Vector3.new(0, 12, 24), q)
	elseif CS.pan then
		cam.CameraType = Enum.CameraType.Scriptable
		CS.pan.t = math.min(CS.pan.d, CS.pan.t + dt); local u = CS.pan.t / CS.pan.d; u = 0.5 - 0.5 * math.cos(u * math.pi)
		local from = CS.pan.a.Position; local look0 = from + CS.pan.a.LookVector * 20
		local tgt = look0:Lerp(CS.pan.b, u); cf = CFrame.lookAt(from:Lerp(CS.pan.b + (from - look0), u), tgt)
	elseif CS.pitch or CS.dist or CS.yaw or CS.orbit or CS.spin1 or CS.shoulder or CS.dolly then
		local l = cf.LookVector
		local yaw = CS.yaw or math.atan2(-l.X, -l.Z)
		if CS.orbit then CS.oy = (CS.oy or yaw) + CS.orbit * dt; yaw = CS.oy end
		if CS.spin1 then CS.spin1 = CS.spin1 + dt; yaw = yaw + math.min(1, CS.spin1 / 2) * math.pi * 2; if CS.spin1 >= 2 then CS.spin1 = nil end end
		local pitch = CS.pitch or math.asin(math.clamp(-l.Y, -1, 1))
		local dist = CS.dist or (cf.Position - p).Magnitude
		if CS.dolly then local D = CS.dolly; D.t = D.t + dt; local u = math.min(1, D.t / D.d); local f = D.f0 + 40 * u; cam.FieldOfView = math.min(110, f); dist = D.d0 * math.tan(math.rad(D.f0 / 2)) / math.tan(math.rad(f / 2)); if u >= 1 then CS.dolly = nil end end
		local dir = Vector3.new(math.sin(yaw) * math.cos(pitch), math.sin(pitch), math.cos(yaw) * math.cos(pitch))
		local focus = p + Vector3.new(0, 2, 0)
		cf = CFrame.lookAt(focus + dir * dist, focus)
		if CS.shoulder then cf = cf + cf.RightVector * CS.shoulder end
	end
	if CS.look and CS.look.Parent then cf = CFrame.lookAt(cf.Position, CS.look.Position) end
	if CS.bob then local h = body(); if h and h.MoveDirection.Magnitude > 0.1 then cf = cf + Vector3.new(0, math.sin(camT * 12) * 0.25, 0) end end
	if CS.roll then cf = cf * CFrame.Angles(0, 0, math.rad(CS.roll)) end
	if CS.breathe then cam.FieldOfView = CS.fov0 + math.sin(camT * math.pi * 2 / CS.breathe) * 6 end
	cam.CFrame = cf
end)

-- screen looks
local FX = Instance.new("Frame"); FX.Name = "BuildXScreenFx"; FX.BackgroundTransparency = 1; FX.Size = UDim2.new(1, 0, 1, 0); FX.ZIndex = 5; FX.Parent = hud
local named = {}
local function drop(k) if named[k] then named[k]:Destroy(); named[k] = nil end end
local function layer(k) drop(k); local f = Instance.new("Frame"); f.Name = k; f.BackgroundTransparency = 1; f.Size = UDim2.new(1, 0, 1, 0); f.Parent = FX; named[k] = f; return f end
local function edges(k, col, inner, strength)
	local f = layer(k)
	for i, rot in ipairs({90, 270, 0, 180}) do
		local e = Instance.new("Frame"); e.BorderSizePixel = 0; e.BackgroundColor3 = col
		if i <= 2 then e.Size = UDim2.new(1, 0, inner, 0); e.Position = UDim2.new(0, 0, i == 1 and 0 or 1 - inner, 0) else e.Size = UDim2.new(inner, 0, 1, 0); e.Position = UDim2.new(i == 3 and 0 or 1 - inner, 0, 0, 0) end
		local g = Instance.new("UIGradient"); g.Rotation = rot; g.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1 - strength), NumberSequenceKeypoint.new(1, 1)}); g.Parent = e
		e.Parent = f
	end
	return f
end
local function cc() return colorFx() end
local function resetCC() local c = cc(); c.Brightness = 0; c.Contrast = 0; c.Saturation = 0; c.TintColor = Color3.new(1, 1, 1); local bl = Lighting:FindFirstChild("BuildXBlur"); if bl then bl:Destroy() end local bm = Lighting:FindFirstChild("BuildXBloom"); if bm then bm:Destroy() end end
local function look(b, ct, s, tint) resetCC(); local c = cc(); c.Brightness = b or 0; c.Contrast = ct or 0; c.Saturation = s or 0; c.TintColor = tint or Color3.new(1, 1, 1) end
local function blur(n) local bl = Lighting:FindFirstChild("BuildXBlur") or Instance.new("BlurEffect"); bl.Name = "BuildXBlur"; bl.Size = n; bl.Parent = Lighting end
local grainOn = false
local SCRF = {
	screen_sharp_contrast = function() look(0, 0.45, 0.1) end, screen_washed_out = function() look(0.1, -0.25, -0.5) end, screen_vivid = function() look(0.02, 0.15, 0.7) end,
	screen_dim = function() look(-0.25, 0, 0) end, screen_bright = function() look(0.2, 0, 0) end,
	night_vision = function() look(0.2, 0.2, -1, Color3.fromRGB(120, 255, 120)) end, thermal_vision = function() look(0.05, 0.5, 0.9, Color3.fromRGB(255, 150, 80)) end,
	dream_vision = function() look(0.1, -0.1, 0.2, Color3.fromRGB(255, 235, 250)); blur(4); local bm = Instance.new("BloomEffect"); bm.Name = "BuildXBloom"; bm.Intensity = 1.5; bm.Size = 40; bm.Threshold = 0.6; bm.Parent = Lighting end,
	sunburn_vision = function() look(0.05, 0.1, 0.2, Color3.fromRGB(255, 170, 150)) end, frozen_vision = function() look(0.05, 0.05, -0.3, Color3.fromRGB(170, 210, 255)) end,
	screen_hue = function(a) look(0, 0, 0.3, Color3.fromHSV(((tonumber(a) or 90) % 360) / 360, 0.45, 1)) end,
	screen_normal = function() resetCC() end,
	screen_tilt = function(a) CS.roll = tonumber(a) or 8 end, screen_upside_down = function() CS.roll = 180 end, screen_straight = function() CS.roll = nil end,
	screen_mirror = function() showFor(toast, "Roblox can't flip the screen left to right", 2.5) end,
	vignette = function() edges("vig", Color3.new(0, 0, 0), 0.3, 0.7) end,
	tunnel_vision = function() edges("vig", Color3.new(0, 0, 0), 0.45, 1) end,
	red_damage_edges = function() local f = edges("red", Color3.fromRGB(200, 0, 0), 0.25, 0.6); task.delay(0.8, function() if named.red == f then drop("red") end end) end,
	scanlines = function() local f = layer("scan"); for i = 0, 199 do local l = Instance.new("Frame"); l.BorderSizePixel = 0; l.BackgroundColor3 = Color3.new(0, 0, 0); l.BackgroundTransparency = 0.78; l.Size = UDim2.new(1, 0, 0, 1); l.Position = UDim2.new(0, 0, i / 200, 0); l.Parent = f end end,
	film_grain = function() local f = layer("grain"); for i = 1, 260 do local d = Instance.new("Frame"); d.BorderSizePixel = 0; d.BackgroundColor3 = math.random() < 0.5 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1); d.BackgroundTransparency = 0.75; d.Size = UDim2.new(0, 2, 0, 2); d.Parent = f end grainOn = true end,
	letterbox = function() letterbox(true) end,
	underwater_screen = function() look(-0.1, 0, -0.2, Color3.fromRGB(150, 210, 240)); blur(3); local f = layer("uw"); f.BackgroundTransparency = 0.8; f.BackgroundColor3 = Color3.fromRGB(40, 130, 190) end,
	fade_from_black = function(a) local f = layer("blk"); f.BackgroundColor3 = Color3.new(0, 0, 0); f.BackgroundTransparency = 0; TweenService:Create(f, TweenInfo.new(TT(a, 1)), {BackgroundTransparency = 1}):Play() end,
	flash_screen_color = function(a) local f = layer("flash"); local h = tostring(a or "#ffffff"):gsub("#", ""); f.BackgroundColor3 = Color3.fromRGB(tonumber(h:sub(1, 2), 16) or 255, tonumber(h:sub(3, 4), 16) or 255, tonumber(h:sub(5, 6), 16) or 255); f.BackgroundTransparency = 0.2; TweenService:Create(f, TweenInfo.new(0.45), {BackgroundTransparency = 1}):Play() end,
	tint_screen = function(a) local f = layer("tint"); local h = tostring(a or "#ffa500"):gsub("#", ""); f.BackgroundColor3 = Color3.fromRGB(tonumber(h:sub(1, 2), 16) or 255, tonumber(h:sub(3, 4), 16) or 165, tonumber(h:sub(5, 6), 16) or 0); f.BackgroundTransparency = 0.82 end,
	clear_screen_effects = function() for k in pairs(named) do drop(k) end resetCC(); letterbox(false); CS.roll = nil; grainOn = false end,
}
RunService.RenderStepped:Connect(function()
	if grainOn and named.grain then for _, d in ipairs(named.grain:GetChildren()) do d.Position = UDim2.new(math.random(), 0, math.random(), 0) end end
	if named.uw then cam.FieldOfView = 70 + math.sin(os.clock() * 1.5) * 1.5 end
end)

-- weather follows the camera
local wPart, wEm, wFx = nil, {}, {}
local WK = {
	weather_rain = {{"#9fc4ff", 70, 0.12, 400, "glow", 0.3}}, weather_snow = {{"#ffffff", 6, 0.3, 160, "glow", 0}}, hail = {{"#e8f4ff", 80, 0.35, 120, "glow", 0}},
	sleet = {{"#9fc4ff", 60, 0.12, 220, "glow", 0.3}, {"#ffffff", 12, 0.28, 90, "glow", 0}}, sandstorm = {{"#d8b98a", 6, 1.2, 220, "smoke", 0, true}},
	thunderstorm = {{"#9fc4ff", 80, 0.14, 500, "glow", 0.3}}, fireflies = {{"#d8ff6b", 1, 0.25, 30, "glow", 1, false, true}}, falling_leaves = {{"#c8732e", 4, 0.5, 40, "smoke", 0}, {"#9c3e1e", 4, 0.5, 30, "smoke", 0}},
	cherry_blossoms = {{"#ffb7d5", 3, 0.35, 70, "smoke", 0}}, ash_fall = {{"#8a8a8a", 3, 0.3, 120, "smoke", 0}}, meteor_shower = {{"#fff2c8", 150, 0.6, 6, "spark", 1, true}},
	dust_motes = {{"#fff6d8", 0.5, 0.12, 40, "glow", 0.5, false, true}}, blizzard = {{"#ffffff", 14, 0.3, 700, "glow", 0, true}},
	bubbles_rising = {{"#dff2ff", 3, 0.5, 50, "glow", 0.2, false, true}},
}
local TEXW = {glow = "rbxasset://textures/particles/forcefield_glow_main.dds", smoke = "rbxasset://textures/particles/smoke_main.dds", spark = "rbxasset://textures/particles/sparkles_main.dds"}
local function hexc(h) h = tostring(h):gsub("#", ""); return Color3.fromRGB(tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16)) end
local fog0
local function setWeather(W)
	for _, e in ipairs(wEm) do e:Destroy() end wEm = {}
	for _, p in ipairs(wFx) do p:Destroy() end wFx = {}
	if fog0 then Lighting.FogEnd = fog0[1]; Lighting.FogColor = fog0[2]; fog0 = nil end
	local list = W.kind and WK[W.kind]
	if list then
		if not wPart then wPart = Instance.new("Part"); wPart.Name = "BuildXWeather"; wPart.Anchored = true; wPart.CanCollide = false; wPart.CanQuery = false; wPart.CanTouch = false; wPart.Transparency = 1; wPart.Size = Vector3.new(160, 1, 160); wPart.Parent = workspace end
		for _, d in ipairs(list) do
			local e = Instance.new("ParticleEmitter"); e.Texture = TEXW[d[5]]; e.Color = ColorSequence.new(hexc(d[1])); e.LightEmission = d[6]
			e.Shape = Enum.ParticleEmitterShape.Box; e.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward; e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
			e.EmissionDirection = d[8] and Enum.NormalId.Top or Enum.NormalId.Bottom
			e.Speed = NumberRange.new(d[2] * 0.8, d[2]); e.Size = NumberSequence.new(d[3]); e.Rate = d[4] * (W.amt or 1)
			e.Lifetime = NumberRange.new(d[8] and 4 or 60 / math.max(d[2], 1), d[8] and 7 or 70 / math.max(d[2], 1)); e.SpreadAngle = Vector2.new(d[8] and 180 or 8, d[8] and 180 or 8)
			e.Acceleration = Vector3.new((W.wind or 0) * 20 + (d[7] and 60 or 0), d[5] == "smoke" and -3 or 0, 0)
			if d[2] > 40 then e.LockedToPart = false; e.Squash = NumberSequence.new(-3) end
			e.Parent = wPart; table.insert(wEm, e)
		end
		if W.kind == "blizzard" or W.kind == "sandstorm" then fog0 = {Lighting.FogEnd, Lighting.FogColor}; Lighting.FogEnd = 140; Lighting.FogColor = W.kind == "blizzard" and Color3.fromRGB(230, 236, 242) or Color3.fromRGB(200, 170, 120) end
	end
	if W.aurora then
		for i = 0, 5 do local p = Instance.new("Part"); p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CastShadow = false; p.Material = Enum.Material.Neon; p.Size = Vector3.new(160, 40, 1)
			p.Color = i % 2 == 0 and Color3.fromRGB(80, 255, 160) or Color3.fromRGB(170, 90, 255); p.Transparency = 0.75; p.Name = "BuildXAurora"; p.Parent = workspace; table.insert(wFx, p) end
	end
	if W.rainbow then
		local cols = {"#ff3b3b", "#ff9b3b", "#ffee3b", "#4cff4c", "#3ba4ff", "#4b3bff", "#a03bff"}
		for b, col in ipairs(cols) do for s = 0, 36 do local an = math.pi * s / 36; local R = 300 - b * 6
			local p = Instance.new("Part"); p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CastShadow = false; p.Material = Enum.Material.Neon; p.Size = Vector3.new(6, 27, 6); p.Color = hexc(col); p.Transparency = 0.55
			p.CFrame = CFrame.new(Vector3.new(math.cos(an) * R, math.sin(an) * R - 40, -500)) * CFrame.Angles(0, 0, an); p.Name = "BuildXRainbow"; p.Parent = workspace; table.insert(wFx, p) end end
	end
end
RunService.RenderStepped:Connect(function()
	if wPart and #wEm > 0 then wPart.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, 40, 0)) end
	for i, p in ipairs(wFx) do if p.Name == "BuildXAurora" then local t = os.clock() * 0.2 + i; p.CFrame = CFrame.new(cam.CFrame.Position.X + math.sin(t) * 40 + (i - 3) * 30, 260 + math.sin(t * 1.7) * 10, cam.CFrame.Position.Z - 300) * CFrame.Angles(0.4, math.sin(t) * 0.4, 0); p.Transparency = 0.7 + math.sin(t * 2) * 0.1 end end
end)

-- driving a part like a drone (#control)
local ctl, ctlSpeed, ctlGyro = nil, 30, nil
local controls
pcall(function() controls = require(plr:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls() end)
local function moveVec() if controls then local ok, v = pcall(function() return controls:GetMoveVector() end) if ok and v then return v end end return Vector3.new() end
local function stopControl()
	if not ctl then return end
	local _, r = body(); if r then r.Anchored = false end
	local h = body(); cam.CameraSubject = h
	if ctlGyro then ctlGyro:Destroy(); ctlGyro = nil end
	ctl = nil
end
RunService.Heartbeat:Connect(function()
	if not ctl then return end
	if not ctl.Parent then stopControl() return end
	local mv = moveVec()
	local l = cam.CFrame.LookVector; local f = Vector3.new(l.X, 0, l.Z).Unit; local rt = cam.CFrame.RightVector; rt = Vector3.new(rt.X, 0, rt.Z).Unit
	local up = (UserInputService:IsKeyDown(Enum.KeyCode.Space) or jumpHeld()) and 1 or ((UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q)) and -1 or 0)
	local v = (f * -mv.Z + rt * mv.X) * ctlSpeed + Vector3.new(0, up * ctlSpeed * 0.7, 0)
	ctl.AssemblyLinearVelocity = v
	ctl.AssemblyAngularVelocity = Vector3.new()
	if ctlGyro then ctlGyro.CFrame = CFrame.lookAt(Vector3.new(), f) end
end)
-- what only this computer knows, for the #get_ info commands
local fpsN, fpsT, fps = 0, 0, 60
RunService.RenderStepped:Connect(function(dt) fpsN = fpsN + 1; fpsT = fpsT + dt; if fpsT >= 0.5 then fps = math.floor(fpsN / fpsT + 0.5); fpsN = 0; fpsT = 0 end end)
task.spawn(function()
	while true do
		task.wait(0.5)
		local vs = cam.ViewportSize; local l = cam.CFrame.LookVector; local mv = moveVec()
		local _, r = body()
		Remote:FireServer("info", {fps = fps, w = math.floor(vs.X), h = math.floor(vs.Y), phone = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and 1 or 0,
			zoom = r and math.floor((cam.CFrame.Position - r.Position).Magnitude * 10 + 0.5) / 10 or 0, cyaw = math.floor((math.deg(math.atan2(l.X, -l.Z)) + 360) % 360 + 0.5), cpitch = math.floor(math.deg(math.asin(math.clamp(l.Y, -1, 1))) + 0.5),
			ix = math.floor(mv.X * 100 + 0.5) / 100, iy = math.floor(-mv.Z * 100 + 0.5) / 100, lang = (pcall(function() return game:GetService("LocalizationService").RobloxLocaleId end) and game:GetService("LocalizationService").RobloxLocaleId or "en"):sub(1, 2), dark = 0})
	end
end)

Remote.OnClientEvent:Connect(function(kind, a, b)
	if kind == "control" then
		if a == nil then stopControl() else stopControl(); ctl = a; ctlSpeed = (tonumber(b) or 0) > 0 and tonumber(b) or 30; local _, r = body(); if r then r.Anchored = true end cam.CameraSubject = a
			local at = a:FindFirstChild("BXCtlAtt") or Instance.new("Attachment"); at.Name = "BXCtlAtt"; at.Parent = a; ctlGyro = Instance.new("AlignOrientation"); ctlGyro.Mode = Enum.OrientationAlignmentMode.OneAttachment; ctlGyro.Attachment0 = at; ctlGyro.RigidityEnabled = true; ctlGyro.Parent = a end
	elseif kind == "ab" then AB = a or {}; if AB.hover and AB.hoverId ~= lastHid then hoverUntil = os.clock() + AB.hover end lastHid = AB.hoverId
	elseif kind == "vel" then local _, r = body(); if r and typeof(a) == "Vector3" then r.AssemblyLinearVelocity = a end
	elseif kind == "dash" then doDash()
	elseif kind == "cam" then local f = CAMF[a]; if f then f(b) end
	elseif kind == "camera_reset" then clearCam()
	elseif kind == "scr" then local f = SCRF[a]; if f then f(b) end
	elseif kind == "weather" then setWeather(a or {}) end
end)

end

do
-- ===== GUIs on parts and floating GUIs: find what they sit on =====
local function findPart(n)
	n = lower(trim(n)); if n == "" then return nil end
	for _, d in ipairs(workspace:GetDescendants()) do if (d:IsA("BasePart") or d:IsA("Model")) and lower(d.Name) == n then return d end end
	return nil
end
local spotParts = {}
local function adorn(g)
	if not (g:IsA("SurfaceGui") or g:IsA("BillboardGui")) or not A(g, "BuildXGui") then return end
	local follow = A(g, "BuildXFollow") or "part"
	if g:IsA("SurfaceGui") or follow == "part" then
		local p = findPart(A(g, "BuildXPart") or "")
		if p and p:IsA("Model") then p = p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true) end
		g.Adornee = p
	elseif follow == "spot" then
		local sp = spotParts[g.Name]
		if not sp then
			local x, y, z = tostring(A(g, "BuildXSpot") or "0,5,0"):match("([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)")
			sp = Instance.new("Part"); sp.Name = "BuildXSpot_" .. g.Name; sp.Anchored = true; sp.CanCollide = false; sp.CanQuery = false; sp.CanTouch = false
			sp.Transparency = 1; sp.Size = Vector3.new(0.2, 0.2, 0.2); sp.CFrame = CFrame.new(tonumber(x) or 0, tonumber(y) or 5, tonumber(z) or 0); sp.Parent = workspace
			spotParts[g.Name] = sp
		end
		g.Adornee = sp
	else
		local ch = plr.Character; g.Adornee = ch and (ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")) or nil
	end
end
local function adornAll() for _, g in ipairs(pgui:GetChildren()) do pcall(adorn, g) end end
pgui.ChildAdded:Connect(function(g) task.wait(); pcall(adorn, g) end)
plr.CharacterAdded:Connect(function(ch) ch:WaitForChild("HumanoidRootPart", 5); task.wait(); adornAll() end)
task.defer(adornAll)

-- ===== doors that open for game pass owners =====
Remote.OnClientEvent:Connect(function(kind, a)
	if kind ~= "passdoor" then return end
	local p = findPart(a); if not p then return end
	local list = p:IsA("BasePart") and {p} or p:GetDescendants()
	for _, b in ipairs(list) do if b:IsA("BasePart") then b.CanCollide = false; b.LocalTransparencyModifier = 0.6 end end
end)

-- ===== item animations (same presets as the BuildX item editor) =====
local HttpService = game:GetService("HttpService")
local SN, PI = math.sin, math.pi; local P2 = PI * 2
local function ez(u) if u <= 0 then return 0 elseif u >= 1 then return 1 end return u * u * (3 - 2 * u) end
local function O(p, r, s) return {p = p or {0, 0, 0}, r = r or {0, 0, 0}, s = s} end
local LOOPS = {
	["Bob"] = function(t, a) return O({0, 0.18 * a * SN(t * P2 * 1.6), 0}) end,
	["Sway"] = function(t, a) return O(nil, {0, 0, 14 * a * SN(t * P2 * 1.1)}) end,
	["Swing"] = function(t, a) return O({0, 0, 0.15 * a * SN(t * P2 * 1.4)}, {26 * a * SN(t * P2 * 1.4), 0, 0}) end,
	["Wobble"] = function(t, a) return O(nil, {8 * a * SN(t * P2 * 2.1), 0, 8 * a * SN(t * P2 * 1.7)}) end,
	["Shake"] = function(t, a) return O({0.06 * a * SN(t * 91), 0.04 * a * SN(t * 77), 0.06 * a * SN(t * 63)}) end,
	["Pulse"] = function(t, a) return O(nil, nil, 1 + 0.12 * a * SN(t * P2 * 2)) end,
	["Float"] = function(t, a) return O({0, 0.35 * a + 0.25 * a * SN(t * P2 * 0.7), 0}, {0, 25 * a * SN(t * P2 * 0.35), 0}) end,
	["Spin"] = function(t, a) return O(nil, {0, (t * 180 * a) % 360, 0}) end,
	["Flip"] = function(t, a) return O(nil, {(t * 360 * a) % 360, 0, 0}) end,
	["Orbit"] = function(t, a) return O({0.9 * a * math.cos(t * P2 * 0.6) - 0.9 * a, 0.2 * a * SN(t * P2 * 1.2), 0.9 * a * SN(t * P2 * 0.6)}) end,
	["Paddle"] = function(t, a) return O({0, 0.25 * a * math.cos(t * P2 * 1.2), 0.3 * a * SN(t * P2 * 1.2)}, {40 * a * SN(t * P2 * 1.2), 0, 0}) end,
	["Climb pull"] = function(t, a) return O({0, 0.5 * a * SN(t * P2 * 1.3), 0}, {-60 * a, 0, 0}) end,
	["Raise up"] = function(t, a) return O({0, 0.9 * a, 0}, {-25 * a, 0, 0}) end,
	["Hold low"] = function(t, a) return O({0, -0.6 * a, 0}, {25 * a, 0, 0}) end,
	["Point forward"] = function(t, a) return O({0, 0.3 * a, 0.4 * a}, {-80 * a, 0, 0}) end,
	["Above head"] = function(t, a) return O({0.9 * a, 2.4 * a, -0.6 * a}) end,
	["Behind back"] = function(t, a) return O({0.5 * a, -0.2 * a, -1.6 * a}, {35 * a, 0, 0}) end,
	["Tucked in"] = function(t, a) return O({0.7 * a, -0.2 * a, -0.3 * a}, {15 * a, 0, -10 * a}) end,
	["Hide"] = function() return O(nil, nil, 0.001) end,
}
local SHOTS = {
	["Slash"] = function(u, a) return O(nil, {-95 * a * SN(u * PI), 0, 0}) end,
	["Side slash"] = function(u, a) return O({-0.4 * a * SN(u * PI), 0, 0.3 * a * SN(u * PI)}, {0, 0, 95 * a * SN(u * PI)}) end,
	["Stab"] = function(u, a) return O({0, 0, 1.3 * a * SN(u * PI)}, {-70 * a * SN(u * PI), 0, 0}) end,
	["Smash"] = function(u, a) local x = u < 0.3 and -70 * ez(u / 0.3) or u < 0.6 and -70 + 140 * ez((u - 0.3) / 0.3) or 70 * (1 - ez((u - 0.6) / 0.4)); return O({0, 0.4 * a * SN(u * PI), 0}, {x * a, 0, 0}) end,
	["Throw"] = function(u, a) local x = u < 0.4 and 60 * ez(u / 0.4) or 60 - 150 * ez((u - 0.4) / 0.6); return O({0, 0.3 * a, (u < 0.4 and -0.6 * ez(u / 0.4) or -0.6 + 1.6 * ez((u - 0.4) / 0.6)) * a}, {x * a, 0, 0}) end,
	["Recoil"] = function(u, a) local k = u < 0.15 and u / 0.15 or 1 - ez((u - 0.15) / 0.85); return O({0, 0.1 * a * k, -0.5 * a * k}, {-25 * a * k, 0, 0}) end,
	["Spin once"] = function(u) return O(nil, {0, 360 * ez(u), 0}) end,
	["Flip once"] = function(u) return O(nil, {360 * ez(u), 0, 0}) end,
	["Pop"] = function(u, a) return O(nil, nil, 1 + 0.4 * a * SN(u * PI)) end,
	["Drink"] = function(u, a) local k = SN(u * PI); return O({0.6 * a * k, 0.9 * a * k, 0}, {-100 * a * k, 0, 0}) end,
	["Eat"] = function(u, a) local k = SN(u * PI); return O({0.6 * a * k, 0.8 * a * k + 0.08 * a * SN(u * P2 * 4), 0}, {-30 * a * k, 0, 0}) end,
	["Raise and lower"] = function(u, a) return O({0, 1.0 * a * SN(u * PI), 0}) end,
	["Shake once"] = function(u, a) return O({0.12 * a * SN(u * 40) * (1 - u), 0, 0}) end,
	["Pull out"] = function(u, a) return O({0, -1.2 * a * (1 - ez(u)), 0}, {60 * a * (1 - ez(u)), 0, 0}) end,
}
local ONCE = {use = true, equip = true, land = true}
local function lenOf(A, st) return math.max(0.05, tonumber(A.len) or (A.kind == "Keys" and 1 or (ONCE[st] and 0.4 or 1))) end
local function kv(k, f, i, d) local t = k[f]; if type(t) == "table" then return tonumber(t[i]) or d end return d end
local function mix(a, b, u)
	local o = O({0, 0, 0}, {0, 0, 0}, (tonumber(a.s) or 1) + ((tonumber(b.s) or 1) - (tonumber(a.s) or 1)) * u)
	for i = 1, 3 do o.p[i] = kv(a, "p", i, 0) + (kv(b, "p", i, 0) - kv(a, "p", i, 0)) * u; o.r[i] = kv(a, "r", i, 0) + (kv(b, "r", i, 0) - kv(a, "r", i, 0)) * u end
	return o
end
local function keyAt(A, t)
	local K = {}; for _, k in ipairs(A.keys or {}) do table.insert(K, k) end
	table.sort(K, function(x, y) return (x.t or 0) < (y.t or 0) end)
	if #K == 0 then return O() end
	if t <= (K[1].t or 0) then return mix(K[1], K[1], 0) end
	local last = K[#K]
	if t >= (last.t or 0) then
		if A.loop ~= false and #K > 1 then local L = lenOf(A); local t1 = L + (K[1].t or 0); if t <= t1 then return mix(last, K[1], ez((t - last.t) / math.max(1e-4, t1 - last.t))) end end
		return mix(last, last, 0)
	end
	for i = 1, #K - 1 do local a, b = K[i], K[i + 1]; if t >= a.t and t <= b.t then return mix(a, b, ez((t - a.t) / math.max(1e-4, b.t - a.t))) end end
	return mix(K[1], K[1], 0)
end
local function sample(A, st, secs)
	if not A or not A.kind or A.kind == "None" then return nil end
	local sp = tonumber(A.speed) or 1; local a = tonumber(A.amount) or 1
	local once = ONCE[st] or A.loop == false; local L = lenOf(A, st)
	if A.kind == "Keys" then local t = secs * sp; if once then if t > L then return nil end else t = t % L end return keyAt(A, t) end
	if SHOTS[A.kind] then local T = secs * sp; if once then if T > L then return nil end return SHOTS[A.kind](T / L, a) end return SHOTS[A.kind]((T % L) / L, a) end
	if LOOPS[A.kind] then if once and secs * sp > L then return nil end return LOOPS[A.kind](secs * sp, a) end
	return nil
end
local function addO(o, d) if not d then return end for i = 1, 3 do o.p[i] = o.p[i] + (d.p[i] or 0); o.r[i] = o.r[i] + (d.r[i] or 0) end if d.s then o.s = o.s * d.s end end
local function stateOf(hum, root, S)
	local st = hum:GetState(); local E = Enum.HumanoidStateType
	if st == E.Seated or hum.Sit then return "sit" end
	if st == E.Climbing then return "climb" end
	if st == E.Swimming then return "swim" end
	if st == E.Jumping then return "jump" end
	if st == E.Freefall or st == E.FallingDown then return root.AssemblyLinearVelocity.Y > 0 and "jump" or "fall" end
	if st == E.PlatformStanding or st == E.Physics then return "fly" end
	if S.landAt and os.clock() - S.landAt < 0.4 then return "land" end
	local v = root.AssemblyLinearVelocity; local spd = Vector3.new(v.X, 0, v.Z).Magnitude
	if spd > math.max(20, hum.WalkSpeed * 1.25) then return "run" elseif spd > 1 then return "walk" end
	return "idle"
end
local STATE = setmetatable({}, {__mode = "k"})
local function offCF(o)
	-- BuildX: +x is the character's left, +z forward. Roblox: +x right, -z forward.
	local cf = CFrame.new(-o.p[1], o.p[2], -o.p[3]) * CFrame.fromOrientation(0, math.rad(o.r[2]), 0) * CFrame.fromOrientation(math.rad(-o.r[1]), 0, 0) * CFrame.fromOrientation(0, 0, math.rad(-o.r[3]))
	return cf
end
RunService.RenderStepped:Connect(function()
	local now = os.clock(); local srv = workspace:GetServerTimeNow()
	for _, pl in ipairs(Players:GetPlayers()) do
		local ch = pl.Character; local hum = ch and ch:FindFirstChildOfClass("Humanoid"); local root = ch and ch:FindFirstChild("HumanoidRootPart")
		local tool = ch and ch:FindFirstChildOfClass("Tool")
		if hum and root and tool then
			local S = STATE[ch]; if not S then S = {}; STATE[ch] = S
				hum.StateChanged:Connect(function(_, n) if n == Enum.HumanoidStateType.Landed then S.landAt = os.clock() end end) end
			local js = tool:GetAttribute("BuildXAnims")
			local w = ch:FindFirstChild("RightGrip", true)
			if js and w and w:IsA("JointInstance") then
				if S.tool ~= tool then S.tool = tool; S.eqAt = now; S.A = nil; pcall(function() S.A = HttpService:JSONDecode(js) end) end
				local A = S.A or {}
				local st = stateOf(hum, root, S); if S.st ~= st then S.st = st; S.st0 = now end
				local o = O({0, 0, 0}, {0, 0, 0}, 1)
				addO(o, sample(A[st], st, now - S.st0))
				if S.eqAt then addO(o, sample(A.equip, "equip", now - S.eqAt)) end
				local ua = tool:GetAttribute("BuildXUseAt"); if ua then addO(o, sample(A.use, "use", srv - ua)) end
				local g0 = tool:GetAttribute("BuildXGrip0") or tool.Grip
				w.C1 = g0 * offCF(o):Inverse()
				local hd = tool:FindFirstChild("Handle")
				if hd then hd.LocalTransparencyModifier = (o.s or 1) < 0.05 and 1 or 0 end
			end
		end
	end
end)

-- ===== "hold to keep using" items =====
local holding = false
UserInputService.InputBegan:Connect(function(i, gp) if gp then return end if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then holding = true end end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then holding = false end end)
local nextUse = 0
RunService.Heartbeat:Connect(function()
	if not holding or os.clock() < nextUse then return end
	local ch = plr.Character; local t = ch and ch:FindFirstChildOfClass("Tool")
	if t and t:GetAttribute("BuildXAutoUse") then nextUse = os.clock() + 0.1; Remote:FireServer("use") end
end)
end

-- ===== BuildX's messages and rolling cubes (Roblox keeps its own HUD, chat and avatar) =====
do
local SG = game:GetService("StarterGui")
local function U(k) local v = Remote:GetAttribute("ui_" .. k); if v == nil then return true end return v end

-- messages at the top (18px bold), titles big at 22% down, like BuildX
msg.AnchorPoint = Vector2.new(0.5, 0); msg.Position = UDim2.new(0.5, 0, 0, 12); msg.Size = UDim2.new(1, -40, 0, 24); msg.TextScaled = false; msg.TextSize = 18; msg.Font = Enum.Font.GothamBold; msg.TextStrokeTransparency = 0.55
title.AnchorPoint = Vector2.new(0.5, 0); title.Position = UDim2.new(0.5, 0, 0.22, 0); title.Size = UDim2.new(1, -40, 0, 54); title.TextScaled = false; title.TextSize = 44; title.Font = Enum.Font.GothamBlack; title.TextStrokeTransparency = 0.2

-- bots talking go into Roblox's own chat window
_G.BuildXChatLog = function(who, s)
	if not U("showChat") then return end
	local line = tostring(who) .. ": " .. tostring(s)
	local ok = pcall(function()
		local ch = game:GetService("TextChatService"):FindFirstChild("TextChannels"):FindFirstChild("RBXGeneral")
		ch:DisplaySystemMessage(line)
	end)
	if not ok then pcall(function() SG:SetCore("ChatMakeSystemMessage", {Text = line, Color = Color3.new(1, 1, 1)}) end) end
end

-- bots are BuildX cubes and roll over their edges when they move, like BuildX
local ROLL = {}
local CUBES, scanT = {}, 99
RunService.RenderStepped:Connect(function(dt)
	scanT = scanT + dt
	if scanT > 1 then scanT = 0; CUBES = {}
		for _, d in ipairs(workspace:GetDescendants()) do if d.Name == "BodyWeld" and d:IsA("Weld") and d.Parent and d.Parent.Name == "Body" and d.Parent.Parent and d.Parent.Parent:IsA("Model") then table.insert(CUBES, d.Parent.Parent) end end
	end
	for _, m in ipairs(CUBES) do
		if m.Parent then
			local body = m:FindFirstChild("Body"); local w = body and body:FindFirstChild("BodyWeld"); local root = m:FindFirstChild("HumanoidRootPart")
			if w and root and w:IsA("Weld") then
				local R = ROLL[m] or {ph = 0, last = root.Position}; ROLL[m] = R
				local d = root.Position - R.last; R.last = root.Position
				local flat = Vector3.new(d.X, 0, d.Z).Magnitude
				local s = body.Size.X
				local hum = m:FindFirstChildOfClass("Humanoid")
				if flat < 20 and flat > 0.002 and hum and hum.Health > 0 then R.ph = R.ph + flat / s
				else local tg = math.floor(R.ph + 0.5); if math.abs(tg - R.ph) > 1e-4 then local st = math.min(math.abs(tg - R.ph), dt * 2.6); R.ph = R.ph + (tg > R.ph and st or -st) end end
				local u = R.ph - math.floor(R.ph); local th = u * math.pi / 2; local s2 = s / 2
				local yc = s2 * (math.cos(th) + math.sin(th)); local fo = s2 * (1 - math.cos(th) + math.sin(th)) - u * s
				w.C0 = CFrame.new(0, yc - s2, -fo) * CFrame.Angles(-th, 0, 0)
			end
		end
	end
	for m in pairs(ROLL) do if not m.Parent then ROLL[m] = nil end end
end)
end

-- ===== meshes and pictures are made inside the game from the data in the place (nothing to import or upload) =====
do
local AS = game:GetService("AssetService")
local RS = game:GetService("ReplicatedStorage")
local MD = RS:FindFirstChild("BuildXMeshData")
local ID = RS:FindFirstChild("BuildXImageData")
local B64 = {}
do local cs = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" for i = 1, 64 do B64[string.byte(cs, i)] = i - 1 end end
local function decode(s)
	local n = #s; local pad = 0
	if s:sub(-1) == "=" then pad = pad + 1 end
	if s:sub(-2, -2) == "=" then pad = pad + 1 end
	local total = math.floor(n / 4) * 3 - pad
	local out = buffer.create(total); local o = 0
	for i = 1, n, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local x = (B64[a] or 0) * 262144 + (B64[b] or 0) * 4096 + (B64[c] or 0) * 64 + (B64[d] or 0)
		if o < total then buffer.writeu8(out, o, math.floor(x / 65536) % 256); o = o + 1 end
		if o < total then buffer.writeu8(out, o, math.floor(x / 256) % 256); o = o + 1 end
		if o < total then buffer.writeu8(out, o, x % 256); o = o + 1 end
	end
	return out
end
local IMGS = {}
local function picture(key)
	if IMGS[key] ~= nil then return IMGS[key] or nil end
	IMGS[key] = false
	local mod = ID and ID:FindFirstChild(key); if not mod then return nil end
	local ok, res = pcall(function()
		local d = require(mod)
		local ei = AS:CreateEditableImage({Size = Vector2.new(d.w, d.h)})
		ei:WritePixelsBuffer(Vector2.zero, Vector2.new(d.w, d.h), decode(d.p))
		return ei
	end)
	if ok then IMGS[key] = res; return res end
	warn("[BuildX] picture " .. key .. " could not be made: " .. tostring(res))
	return nil
end
local function nums(s) local t = {} for x in string.gmatch(s, "[^,]+") do t[#t + 1] = tonumber(x) end return t end
local MESH = {}
local function meshContent(key)
	if MESH[key] ~= nil then return MESH[key] or nil end
	MESH[key] = false
	local mod = MD and MD:FindFirstChild(key); if not mod then return nil end
	local ok, res = pcall(function()
		local d = require(mod)
		local v, n, t, ix = nums(d.v), nums(d.n), nums(d.t), nums(d.i)
		local em = AS:CreateEditableMesh()
		local V, N, U = {}, {}, {}
		for i = 0, #v / 3 - 1 do
			V[i] = em:AddVertex(Vector3.new(v[i * 3 + 1], v[i * 3 + 2], v[i * 3 + 3]))
			N[i] = em:AddNormal(Vector3.new(n[i * 3 + 1] or 0, n[i * 3 + 2] or 1, n[i * 3 + 3] or 0))
			U[i] = em:AddUV(Vector2.new(t[i * 2 + 1] or 0, t[i * 2 + 2] or 0))
		end
		for k = 1, #ix, 3 do
			local a, b, c = ix[k], ix[k + 1], ix[k + 2]
			local f = em:AddTriangle(V[a], V[b], V[c])
			em:SetFaceNormals(f, {N[a], N[b], N[c]})
			em:SetFaceUVs(f, {U[a], U[b], U[c]})
		end
		return {content = Content.fromObject(em), tex = d.tex}
	end)
	if ok then MESH[key] = res; return res end
	warn("[BuildX] mesh " .. key .. " could not be made: " .. tostring(res))
	return nil
end
-- the place has a plain block where each mesh goes; the real mesh is drawn on it
local BUSY = setmetatable({}, {__mode = "k"})
local function dress(ph)
	if not ph or not ph:IsA("BasePart") or BUSY[ph] or ph:FindFirstChild("BuildXLook") then return end
	BUSY[ph] = true
	local tag = ph:FindFirstChild("BuildXMesh"); if not tag then return end
	local mc = meshContent(tag.Value); if not mc then return end
	local ok, m = pcall(function() return AS:CreateMeshPartAsync(mc.content) end)
	if not ok or not m or not ph.Parent then if not ok then warn("[BuildX] mesh: " .. tostring(m)) end return end
	m.Name = "BuildXLook"; m.Anchored = false; m.CanCollide = false; m.CanTouch = false; m.CanQuery = false; m.Massless = true
	if mc.tex then local ei = picture(mc.tex); if ei then m.TextureContent = Content.fromObject(ei) end end
	local function sync()
		m.Size = ph.Size; m.Color = ph.Color; m.Material = ph.Material; m.Reflectance = ph.Reflectance; m.Transparency = ph.Transparency; m.CastShadow = ph.CastShadow
		ph.LocalTransparencyModifier = 1
	end
	sync(); m.CFrame = ph.CFrame
	local w = Instance.new("WeldConstraint"); w.Part0 = ph; w.Part1 = m; w.Parent = m
	m.Parent = ph
	for _, k in ipairs({"Size", "Color", "Material", "Reflectance", "Transparency", "CastShadow"}) do ph:GetPropertyChangedSignal(k):Connect(sync) end
	ph:GetPropertyChangedSignal("Size"):Connect(function() m.CFrame = ph.CFrame end)
	-- you bump into the real shape, not the block (only on your side; the server keeps the block)
	local okC, col = pcall(function() return AS:CreateMeshPartAsync(mc.content, {CollisionFidelity = Enum.CollisionFidelity.PreciseConvexDecomposition}) end)
	if okC and col and ph.Parent then
		col.Name = "BuildXShape"; col.Transparency = 1; col.CanTouch = false; col.CanQuery = false; col.CastShadow = false; col.Massless = true; col.Anchored = false
		col.Size = ph.Size; col.CFrame = ph.CFrame; col.CollisionGroup = ph.CollisionGroup
		local w2 = Instance.new("WeldConstraint"); w2.Part0 = ph; w2.Part1 = col; w2.Parent = col
		col.Parent = ph
		local function coll()
			local on = ph:GetAttribute("BxCollide"); if on == nil then on = ph.CanCollide end
			col.CanCollide = on; col.CollisionGroup = ph.CollisionGroup
			if ph.CanCollide then ph.CanCollide = false end
		end
		coll()
		ph:GetAttributeChangedSignal("BxCollide"):Connect(coll)
		ph:GetPropertyChangedSignal("CanCollide"):Connect(coll)
		ph:GetPropertyChangedSignal("CollisionGroup"):Connect(coll)
		ph:GetPropertyChangedSignal("Size"):Connect(function() col.Size = ph.Size; col.CFrame = ph.CFrame end)
	end
end
-- GUI pictures
local function guiPicture(o)
	if not (o:IsA("ImageLabel") or o:IsA("ImageButton")) then return end
	local tag = o:FindFirstChild("BuildXImageData"); if not tag then return end
	local ei = picture(tag.Value); if ei then o.ImageContent = Content.fromObject(ei) end
end
local function look(d)
	if d.Name == "BuildXMesh" and d.Parent then task.spawn(dress, d.Parent)
	elseif d.Name == "BuildXImageData" and d.Parent then task.spawn(guiPicture, d.Parent) end
end
task.spawn(function()
	for _, d in ipairs(workspace:GetDescendants()) do look(d) end
	workspace.DescendantAdded:Connect(look)
	local pg = plr:WaitForChild("PlayerGui")
	for _, d in ipairs(pg:GetDescendants()) do look(d) end
	pg.DescendantAdded:Connect(look)
end)
end
]]></ProtectedString></Properties></Item></Item></Item>
</roblox>