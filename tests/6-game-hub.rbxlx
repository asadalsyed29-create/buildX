F("typing_sound", function(c, a) for i = 0, math.min(80, tNum(a, 20)) - 1 do noise(0.025, 0.25, 3000 + math.random() * 3000, i * (0.06 + math.random() * 0.08)) end end)
F("footsteps_sound", function(c, a) for i = 0, math.min(40, tNum(a, 6)) - 1 do noise(0.06, 0.45, 500 + math.random() * 200, i * 0.42) end end)
F("door_creak", function() for i = 0, 13 do tone(180 + math.sin(i) * 40, 220 + math.cos(i) * 50, 0.06, 0.05, i * 0.055) end end)
F("glass_break", function() noise(0.5, 0.4, 9000, 0); for i, f in ipairs({2400, 3100, 3900, 5200, 6100}) do play(TONE, f / BASE, 0.25, math.random() * 0.12, 1) end end)
F("ui_blip", function() tone(1500, 1900, 0.05, 0.12, 0) end)
F("charge_up", function(c, a) local d = TT(a) or 1.5; tone(120, 1600, d, 0.06, 0); tone(240, 3200, d, 0.04, 0) end)
F("power_down", function() tone(900, 60, 1.2, 0.07, 0) end)
F("robot_voice", function(c, a) for i = 0, math.min(40, tNum(a, 8)) - 1 do local f = 300 + math.random() * 700; tone(f, f * (0.8 + math.random() * 0.4), 0.09, 0.06, i * 0.11, function(s) addFx(s, "DistortionSoundEffect", {Level = 0.4}) end) end end)
F("bird_chirp", function() for i = 0, 2 do tone(2800, 4200, 0.07, 0.08, i * 0.12) end tone(4000, 2600, 0.12, 0.07, 0.4) end)
F("water_drip", function() tone(1400, 500, 0.08, 0.25, 0); tone(700, 500, 0.3, 0.04, 0.12) end)
F("wind_gust", function() play(SWOOSH, 0.6, 0.4, 0, 2) end)
F("magic_sparkle_sound", function() for i, s in ipairs({0, 3, 7, 12, 15, 19, 24}) do local f = 880 * 2 ^ (s / 12); play(TONE, f / BASE, 0.3, (i - 1) * 0.05, 1) end end)
F("spooky_sound", function() for i = 0, 9 do tone(220 + math.sin(i * 0.9) * 40, 230 + math.sin(i * 0.9 + 0.5) * 40, 0.25, 0.07, i * 0.22, function(s) addFx(s, "ReverbSoundEffect", {DecayTime = 3}) end) end end)
F("slot_machine", function() for i = 0, 15 do tone(900, 900, 0.03, 0.05, i * 0.07) end for i, f in ipairs({523, 659, 784, 1047}) do tone(f, f, 0.18, 0.08, 1.2 + (i - 1) * 0.12) end end)
F("record_scratch", function() tone(800, 200, 0.12, 0.1, 0); tone(200, 900, 0.1, 0.1, 0.13); noise(0.25, 0.2, 2500, 0) end)
F("ding_dong", function() play(TONE, 784 / BASE, 0.7, 0, 2); play(TONE, 622 / BASE, 0.7, 0.45, 2) end)
F("cash_register", function() noise(0.15, 0.4, 4000, 0); play(TONE, 2093 / BASE, 0.5, 0.12, 1); play(TONE, 2637 / BASE, 0.45, 0.18, 1) end)
F("camera_shutter", function() noise(0.03, 0.6, 6000, 0); noise(0.05, 0.5, 3000, 0.08) end)
F("balloon_pop", function() noise(0.12, 0.9, 7000, 0); play(HIT, 0.5, 0.6, 0, 1) end)
F("bubble_sound", function() for i = 0, 5 do local f = 300 + math.random() * 400; tone(f, f * 2.2, 0.07, 0.12, i * 0.09 + math.random() * 0.05) end end)
F("engine_rev", function() tone(60, 180, 0.6, 0.09, 0, function(s) addFx(s, "DistortionSoundEffect", {Level = 0.6}) end); tone(180, 90, 0.5, 0.08, 0.6, function(s) addFx(s, "DistortionSoundEffect", {Level = 0.6}) end) end)
F("laser_charge_shot", function() tone(200, 1200, 0.4, 0.05, 0); tone(1600, 200, 0.25, 0.1, 0.42) end)
F("coin_shower", function() for i = 0, 13 do local f = 1800 + math.random() * 1200; play(TONE, f / BASE, 0.25, i * 0.06 + math.random() * 0.04, 1) end end)
F("victory_fanfare", function() for _, ft in ipairs({{523, 0}, {523, 0.15}, {523, 0.3}, {659, 0.45}, {784, 0.75}, {659, 1.05}, {784, 1.2}}) do tone(ft[1], ft[1], 0.28, 0.06, ft[2], function(s) addFx(s, "DistortionSoundEffect", {Level = 0.25}) end) end end)
F("sad_trombone", function() for _, ft in ipairs({{294, 0}, {277, 0.45}, {262, 0.9}}) do tone(ft[1], ft[1] * 0.98, 0.42, 0.07, ft[2]) end tone(247, 233, 1.2, 0.07, 1.35) end)
F("drumroll", function(c, a) local d = TT(a) or 2; local t = 0; while t < d do noise(0.05, 0.18 + t / d * 0.2, 2400, t); t = t + 0.045 end end)
F("cymbal_crash_after_roll", function() local t = 0; while t < 1.6 do noise(0.05, 0.2 + t / 8, 2400, t); t = t + 0.045 end DRUM.crash(1.65) end)

end)()
;(function()
-- ===== Motion: parts that move by themselves =====
local MV = {}
local function plH() return whoH(nil) end
local function plPos() local h = plH(); if h and alive(h) then return hpos(h) end return nil end
local function rad(d) return math.rad(d) end
local function cfOf(P) return CFrame.new(P.pos) * CFrame.fromOrientation(rad(P.ori.X), rad(P.ori.Y), rad(P.ori.Z)) end
local function part(P) local i = P.inst; if i and i:IsA("BasePart") then return i end return nil end
local function mvAdd(c, name, fn, keep)
	local P = c.P
	if not P or P.kind ~= "part" or not part(P) then return end
	if not P.pos then readPart(P) end
	local b = part(P)
	P.mv0 = P.mv0 or {pos = P.pos, ori = P.ori, size = b.Size, tr = b.Transparency, color = b.Color, mat = b.Material}
	b.Anchored = true
	MV[P] = MV[P] or {}
	if not keep then for i = #MV[P], 1, -1 do if MV[P][i].name == name then table.remove(MV[P], i) end end end
	table.insert(MV[P], {name = name, fn = fn, t = 0, base = P.pos, ori = P.ori, size = b.Size})
end
local function stood(P)
	local b = part(P); if not b or not P.touching then return nil end
	for h in pairs(P.touching) do if hpos(h).Y > b.Position.Y + b.Size.Y / 2 - 0.5 then return h end end
	return nil
end
table.insert(STEPS, function(dt)
	for P, list in pairs(MV) do
		local b = part(P)
		if P.alive == false or not b or not b.Parent then MV[P] = nil
		else
			if not P.touching and #list > 0 then computeTouching(P) end
			for i = #list, 1, -1 do local m = list[i]; m.t = m.t + dt; local ok, r = pcall(m.fn, P, dt, m, b); if not ok or r == false then table.remove(list, i) end end
			if P.alive ~= false and b.Parent then syncPart(P) end
			if #list == 0 then MV[P] = nil end
		end
	end
end)
local function A(a, d) return num(a, d) end
local function T(a, d) local t = trim(a); if t == "" then return d end return parseTime(t) or d end
local function look(P) return cfOf(P).LookVector end
local function right(P) local l = look(P); return Vector3.new(-l.Z, 0, l.X) end
local function scale(b, m, k) b.Size = Vector3.new(m.size.X * k.X, m.size.Y * k.Y, m.size.Z * k.Z) end

F("zigzag", function(c, a) local w = A(a, 6); mvAdd(c, "zigzag", function(P, dt, m) local f, r = look({pos = m.base, ori = m.ori}), right({pos = m.base, ori = m.ori}); P.pos = m.base + f * (m.t * 4) + r * (math.sin(m.t * 2) * w) end) end)
F("spiral_up", function(c, a) local r = A(a, 8); mvAdd(c, "spiral_up", function(P, dt, m) P.pos = m.base + Vector3.new(math.cos(m.t) * r, m.t * 2, math.sin(m.t) * r) end) end)
F("figure_eight", function(c, a) local r = A(a, 10); mvAdd(c, "figure_eight", function(P, dt, m) P.pos = m.base + Vector3.new(math.sin(m.t) * r, 0, math.sin(m.t * 2) * r / 2) end) end)
F("vertical_circle", function(c, a) local r = A(a, 8); mvAdd(c, "vertical_circle", function(P, dt, m) P.pos = m.base + Vector3.new(math.cos(m.t) * r, math.sin(m.t) * r, 0) end) end)
local function swingFrom(P, m, b, deg, top)
	local h = m.size.Y / 2
	local th = rad(deg)
	local pivot = m.base + Vector3.new(0, top and h or -h, 0)
	local s = top and 1 or -1
	P.pos = pivot + Vector3.new(h * math.sin(th) * s, -h * math.cos(th) * s, 0)
	P.ori = Vector3.new(m.ori.X, m.ori.Y, deg)
end
F("pendulum", function(c, a) local amp = A(a, 40); mvAdd(c, "pendulum", function(P, dt, m, b) swingFrom(P, m, b, math.sin(m.t * 2) * amp, true) end) end)
F("metronome", function(c, a) local amp = A(a, 30); mvAdd(c, "metronome", function(P, dt, m, b) swingFrom(P, m, b, math.sin(m.t * 3) * amp, false) end) end)
F("sway", function(c, a) local amp = A(a, 6); mvAdd(c, "sway", function(P, dt, m, b) swingFrom(P, m, b, math.sin(m.t * 1.2) * amp, false) end) end)
F("seesaw", function(c, a) local amp = A(a, 15); mvAdd(c, "seesaw", function(P, dt, m) P.ori = Vector3.new(m.ori.X, m.ori.Y, math.sin(m.t * 1.2) * amp) end) end)
F("wave_motion", function(c, a) local amp = A(a, 3); mvAdd(c, "wave_motion", function(P, dt, m) P.pos = m.base + Vector3.new(math.sin(m.t * 0.4) * 15, math.sin(m.t * 2) * amp, 0) end) end)
F("wobble", function(c) mvAdd(c, "wobble", function(P, dt, m, b) local s = math.sin(m.t * 8) * 0.08; scale(b, m, Vector3.new(1 + s, 1 - s, 1 + s)) end) end)
F("jitter", function(c, a) local amp = A(a, 0.2); mvAdd(c, "jitter", function(P, dt, m) P.pos = m.base + Vector3.new((math.random() - 0.5) * 2 * amp, (math.random() - 0.5) * 2 * amp, (math.random() - 0.5) * 2 * amp) end) end)
F("drift", function(c, a) local s = A(a, 2); local an = math.random() * math.pi * 2; local d = Vector3.new(math.cos(an), 0, math.sin(an)); mvAdd(c, "drift", function(P, dt) P.pos = P.pos + d * s * dt end) end)
F("wander_part", function(c, a) local r = A(a, 20); mvAdd(c, "wander_part", function(P, dt, m)
	if not m.goal or (m.goal - P.pos).Magnitude < 0.5 then m.goal = m.base + Vector3.new((math.random() - 0.5) * 2 * r, 0, (math.random() - 0.5) * 2 * r) end
	local d = m.goal - P.pos; P.pos = P.pos + d.Unit * math.min(d.Magnitude, 4 * dt)
end) end)
F("hop_part", function(c, a) local hgt = A(a, 4); mvAdd(c, "hop_part", function(P, dt, m) P.pos = m.base + Vector3.new(0, math.abs(math.sin(m.t * math.pi)) * hgt, 0) end) end)
F("bounce_part", function(c, a) local hgt = A(a, 6); mvAdd(c, "bounce_part", function(P, dt, m) P.pos = m.base + Vector3.new(0, math.abs(math.sin(m.t * 2)) * hgt, 0) end) end)
F("rise", function(c, a) local s = A(a, 2); mvAdd(c, "rise", function(P, dt) P.pos = P.pos + Vector3.new(0, s * dt, 0) end) end)
F("sink_slowly", function(c, a) local s = A(a, 1); mvAdd(c, "sink_slowly", function(P, dt) P.pos = P.pos - Vector3.new(0, s * dt, 0) end) end)
F("float_away", function(c) mvAdd(c, "float_away", function(P, dt, m, b) P.pos = P.pos + Vector3.new(0, 3 * dt, 0); b.Transparency = math.min(1, b.Transparency + 0.3 * dt); if b.Transparency >= 1 then deleteP(P); return false end end) end)
F("rocket_up", function(c) mvAdd(c, "rocket_up", function(P, dt, m) m.v = (m.v or 2) + 20 * dt; P.pos = P.pos + Vector3.new(0, m.v * dt, 0); if m.t > 10 then deleteP(P); return false end end) end)
F("roll_forward", function(c, a) local s = A(a, 6); mvAdd(c, "roll_forward", function(P, dt, m, b) local f = look({pos = m.base, ori = Vector3.new(0, m.ori.Y, 0)}); P.pos = P.pos + f * s * dt; local r = math.max(0.5, m.size.Y / 2); P.ori = Vector3.new(P.ori.X - math.deg(s * dt / r), P.ori.Y, P.ori.Z) end) end)
F("tumble", function(c) local w = Vector3.new(math.random(60, 200), math.random(60, 200), math.random(60, 200)); mvAdd(c, "tumble", function(P, dt) P.ori = P.ori + w * dt end) end)
F("spin_up", function(c) mvAdd(c, "spin_up", function(P, dt, m) m.r = math.min(2000, (m.r or 0) + 60 * dt); P.ori = P.ori + Vector3.new(0, m.r * dt, 0) end) end)
F("propeller", function(c) mvAdd(c, "propeller", function(P, dt) P.ori = P.ori + Vector3.new(0, 0, 1440 * dt) end) end)
F("windmill", function(c) mvAdd(c, "windmill", function(P, dt) P.ori = P.ori + Vector3.new(0, 0, 30 * dt) end) end)
F("heartbeat", function(c) mvAdd(c, "heartbeat", function(P, dt, m, b) local x = m.t % 1; local k = 1 + 0.12 * math.max(0, math.sin(x / 0.15 * math.pi)) * (x < 0.15 and 1 or 0) + 0.08 * math.max(0, math.sin((x - 0.25) / 0.15 * math.pi)) * ((x > 0.25 and x < 0.4) and 1 or 0); scale(b, m, Vector3.new(k, k, k)) end) end)
F("breathe", function(c) mvAdd(c, "breathe", function(P, dt, m, b) local k = 1 + 0.08 * math.sin(m.t * 1.5); scale(b, m, Vector3.new(k, k, k)) end) end)
F("squash_bounce", function(c, a) local hgt = A(a, 4); mvAdd(c, "squash_bounce", function(P, dt, m, b) local s = math.abs(math.sin(m.t * 2.5)); P.pos = m.base + Vector3.new(0, s * hgt, 0); local q = s < 0.15 and (1 - (0.15 - s) * 2) or (1 + s * 0.1); scale(b, m, Vector3.new(1 / math.sqrt(q), q, 1 / math.sqrt(q))) end) end)
F("wiggle", function(c) mvAdd(c, "wiggle", function(P, dt, m) P.ori = Vector3.new(m.ori.X, m.ori.Y + math.sin(m.t * 20) * 8, m.ori.Z) end) end)
F("elevator", function(c, a) local hgt = A(a, 20); local trip = math.max(1, hgt / 6); mvAdd(c, "elevator", function(P, dt, m)
	local cyc = (trip + 2) * 2; local x = m.t % cyc; local u
	if x < 2 then u = 0 elseif x < 2 + trip then u = (x - 2) / trip elseif x < 4 + trip then u = 1 else u = 1 - (x - 4 - trip) / trip end
	u = 0.5 - 0.5 * math.cos(u * math.pi)
	P.pos = m.base + Vector3.new(0, hgt * u, 0)
end) end)
F("sliding_door", function(c, a) local w = T(a, 4); mvAdd(c, "sliding_door", function(P, dt, m)
	local cyc = (w + 1) * 2; local x = m.t % cyc; local u
	if x < 1 then u = x elseif x < 1 + w then u = 1 elseif x < 2 + w then u = 1 - (x - 1 - w) else u = 0 end
	local r = right({pos = m.base, ori = m.ori}); P.pos = m.base + r * (m.size.X * (0.5 - 0.5 * math.cos(u * math.pi)))
end) end)
F("drawbridge", function(c, a) local w = T(a, 5); mvAdd(c, "drawbridge", function(P, dt, m)
	local cyc = (w + 1.5) * 2; local x = m.t % cyc; local u
	if x < 1.5 then u = x / 1.5 elseif x < 1.5 + w then u = 1 elseif x < 3 + w then u = 1 - (x - 1.5 - w) / 1.5 else u = 0 end
	u = 0.5 - 0.5 * math.cos(u * math.pi)
	local th = rad(90 * (1 - u)); local L = m.size.Z / 2
	local hinge = m.base + Vector3.new(0, 0, -L)
	P.pos = hinge + Vector3.new(0, L * math.sin(th), L * math.cos(th)); P.ori = Vector3.new(math.deg(th), m.ori.Y, m.ori.Z)
end) end)
F("carousel", function(c, a) local r = A(a, 10); mvAdd(c, "carousel", function(P, dt, m) local t = m.t * 0.6; P.pos = m.base + Vector3.new(math.cos(t) * r, math.sin(m.t * 2) * 0.8, math.sin(t) * r); P.ori = Vector3.new(m.ori.X, -math.deg(t), m.ori.Z) end) end)
F("orbit_part", function(c, a) local p = split(a, ":"); local r = num(p[1] or "", 12); local nm = trim(p[2] or ""); mvAdd(c, "orbit_part", function(P, dt, m)
	local O = nm ~= "" and findP(nm); local ctr = (O and O.inst and O.inst.Parent and (O.pos or O.inst:GetPivot().Position)) or m.base
	P.pos = ctr + Vector3.new(math.cos(m.t) * r, 0, math.sin(m.t) * r)
end) end)
F("follow_path", function(c, a) local pts = {} for s in (tostring(a) .. ";"):gmatch("([^;]*);") do if trim(s) ~= "" then local O = findP(trim(s)); table.insert(pts, (O and O.pos) or parseVec(s, Vector3.new())) end end
	if #pts == 0 then return end
	mvAdd(c, "follow_path", function(P, dt, m) m.i = m.i or 1; local g = pts[m.i]; local d = g - P.pos; if d.Magnitude < 0.3 then m.i = m.i % #pts + 1 else P.pos = P.pos + d.Unit * math.min(d.Magnitude, 8 * dt) end end)
end)
local function once(c, fn) local P = c.P; if not P or P.kind ~= "part" or not part(P) then return end if not P.pos then readPart(P) end fn(P, part(P)); syncPart(P) end
F("teleport_part", function(c, a) once(c, function(P) P.pos = parseVec(a, P.pos) end) end)
F("step_forward", function(c, a) once(c, function(P) P.pos = P.pos + look(P) * A(a, 4) end) end)
F("turn_left", function(c) once(c, function(P) P.ori = P.ori + Vector3.new(0, 90, 0) end) end)
F("turn_right", function(c) once(c, function(P) P.ori = P.ori - Vector3.new(0, 90, 0) end) end)
F("flip_over", function(c) once(c, function(P) P.ori = P.ori + Vector3.new(0, 0, 180) end) end)
F("straighten", function(c) once(c, function(P) P.ori = Vector3.new(0, P.ori.Y, 0) end) end)
F("random_rotation", function(c) once(c, function(P) P.ori = Vector3.new(math.random(0, 359), math.random(0, 359), math.random(0, 359)) end) end)
F("random_position", function(c, a) local r = A(a, 20); once(c, function(P) P.pos = P.pos + Vector3.new((math.random() - 0.5) * 2 * r, 0, (math.random() - 0.5) * 2 * r) end) end)
F("random_size_part", function(c) once(c, function(P, b) b.Size = Vector3.new(math.random(1, 8), math.random(1, 8), math.random(1, 8)) end) end)
F("random_material", function(c) once(c, function(P, b) local all = {} for _, m in pairs(DATA.materials) do table.insert(all, m) end if #all > 0 then b.Material = Enum.Material[all[math.random(1, #all)]] end end) end)
F("random_shape", function(c) once(c, function(P, b) if b.ClassName == "Part" then local s = {Enum.PartType.Block, Enum.PartType.Ball, Enum.PartType.Cylinder}; b.Shape = s[math.random(1, 3)] end end) end)
local function sizeTo(c, k, d, after) mvAdd(c, "size", function(P, dt, m, b) local u = math.min(1, m.t / d); local s = 1 + (k - 1) * u; scale(b, m, Vector3.new(s, s, s)); if u >= 1 then if after then after(P, b) end return false end end) end
F("grow_over", function(c, a) sizeTo(c, 2, T(a, 2)) end)
F("shrink_away", function(c, a) sizeTo(c, 0.02, T(a, 1), function(P) deleteP(P) end) end)
F("pop", function(c) sizeTo(c, 1.3, 0.2, function(P, b) burst(b.Position, {"#ffffff", string.format("#%02x%02x%02x", math.floor(b.Color.R * 255), math.floor(b.Color.G * 255), math.floor(b.Color.B * 255))}, 30); sfx("pop", nil); deleteP(P) end) end)
F("melt", function(c, a) local d = T(a, 3); mvAdd(c, "melt", function(P, dt, m, b) local u = math.min(1, m.t / d); local y = m.size.Y * (1 - 0.92 * u); b.Size = Vector3.new(m.size.X * (1 + 0.6 * u), y, m.size.Z * (1 + 0.6 * u)); P.pos = m.base - Vector3.new(0, (m.size.Y - y) / 2, 0); if u >= 1 then return false end end) end)
F("dissolve", function(c, a) local d = T(a, 2); mvAdd(c, "dissolve", function(P, dt, m, b) local u = math.min(1, m.t / d); b.Transparency = P.mv0.tr + (1 - P.mv0.tr) * u; if u >= 1 then deleteP(P); return false end end) end)
F("crumble", function(c) once(c, function(P, b)
	local s = b.Size / 2
	for i = 0, 7 do
		local q = Instance.new("Part"); q.Size = s * 0.9; q.Color = b.Color; q.Material = b.Material; q.Anchored = false
		q.CFrame = b.CFrame * CFrame.new((i % 2 - 0.5) * s.X, (math.floor(i / 2) % 2 - 0.5) * s.Y, (math.floor(i / 4) - 0.5) * s.Z)
		q.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 10, math.random() * 6, (math.random() - 0.5) * 10); q.Parent = workspace
		Debris:AddItem(q, 4)
	end
	sfx("punch", nil); deleteP(P)
end) end)
F("freeze_solid", function(c) once(c, function(P, b) b.Material = Enum.Material.Ice; b.Color = Color3.fromRGB(175, 221, 255); b.Transparency = 0.2; MV[P] = nil end) end)
F("petrify", function(c) once(c, function(P, b) b.Material = Enum.Material.Slate; b.Color = Color3.fromRGB(128, 128, 128); MV[P] = nil end) end)
F("burn_up", function(c, a) local d = T(a, 3); local P = c.P; local b0 = P and part(P); if b0 then local f = Instance.new("Fire"); f.Size = math.max(4, b0.Size.Magnitude); f.Parent = b0 end
	mvAdd(c, "burn_up", function(P, dt, m, b) local u = math.min(1, m.t / d); local k = 1 - u; b.Color = Color3.new(P.mv0.color.R * k, P.mv0.color.G * k, P.mv0.color.B * k); if u >= 1 then burst(b.Position, {"#555555", "#222222"}, 30); deleteP(P); return false end end)
end)
F("phase", function(c, a) local d = T(a, 2); mvAdd(c, "phase", function(P, dt, m, b) local on = math.floor(m.t / d) % 2 == 1; b.Transparency = on and 0.7 or P.mv0.tr; b.CanCollide = not on end) end)
F("stop_motion", function(c) if c.P then MV[c.P] = nil end end)
F("reset_motion", function(c) local P = c.P; if not P then return end MV[P] = nil; local b = part(P); if P.mv0 and b then P.pos = P.mv0.pos; P.ori = P.mv0.ori; b.Size = P.mv0.size; b.Transparency = P.mv0.tr; syncPart(P) end end)

-- reacting to the player
local function near(P, r) local pp = plPos(); return pp and (pp - P.pos).Magnitude < r, pp end
F("avoid_player", function(c, a) local r = A(a, 12); mvAdd(c, "avoid_player", function(P, dt) local n, pp = near(P, r); if n then local d = P.pos - pp; d = Vector3.new(d.X, 0, d.Z); if d.Magnitude > 0.01 then P.pos = P.pos + d.Unit * 8 * dt end end end) end)
F("approach_player", function(c, a) local r = A(a, 30); mvAdd(c, "approach_player", function(P, dt) local n, pp = near(P, r); if n then local d = pp - P.pos; d = Vector3.new(d.X, 0, d.Z); if d.Magnitude > 3 then P.pos = P.pos + d.Unit * 4 * dt end end end) end)
F("stalk", function(c) mvAdd(c, "stalk", function(P, dt) local h = plH(); if not h or not alive(h) then return end
	local d = P.pos - hpos(h); local lk = h.root.CFrame.LookVector
	if d.Magnitude > 3 and lk:Dot(d.Unit) < 0.5 then local g = Vector3.new(-d.X, 0, -d.Z); if g.Magnitude > 0 then P.pos = P.pos + g.Unit * 6 * dt end end
end) end)
F("peek", function(c, a) local r = A(a, 15); mvAdd(c, "peek", function(P, dt, m, b) local n = near(P, r); local goal = n and m.base or (m.base - Vector3.new(0, m.size.Y + 0.5, 0)); local d = goal - P.pos; if d.Magnitude > 0.01 then P.pos = P.pos + d.Unit * math.min(d.Magnitude, 10 * dt) end end) end)
F("hide_when_near", function(c, a) local r = A(a, 10); mvAdd(c, "hide_when_near", function(P, dt, m, b) local n = near(P, r); b.Transparency = n and 1 or P.mv0.tr; b.CanCollide = not n end) end)
F("show_when_near", function(c, a) local r = A(a, 10); mvAdd(c, "show_when_near", function(P, dt, m, b) local n = near(P, r); b.Transparency = n and P.mv0.tr or 1; b.CanCollide = n and true or false end) end)
local function glow(b, on) local l = b:FindFirstChild("BuildXGlow"); if on and not l then l = Instance.new("PointLight"); l.Name = "BuildXGlow"; l.Range = 12; l.Brightness = 2; l.Color = b.Color; l.Parent = b end if l then l.Enabled = on end b.Material = on and Enum.Material.Neon or (b:GetAttribute("bxMat") and Enum.Material[b:GetAttribute("bxMat")] or b.Material) end
F("glow_when_near", function(c, a) local r = A(a, 12); mvAdd(c, "glow_when_near", function(P, dt, m, b) if not b:GetAttribute("bxMat") then b:SetAttribute("bxMat", P.mv0.mat.Name) end glow(b, near(P, r) and true or false) end) end)
F("shake_when_near", function(c, a) local r = A(a, 10); mvAdd(c, "shake_when_near", function(P, dt, m) if near(P, r) then P.pos = m.base + Vector3.new((math.random() - 0.5) * 0.4, 0, (math.random() - 0.5) * 0.4) else P.pos = m.base end end) end)
F("turn_to_player", function(c) mvAdd(c, "turn_to_player", function(P) local pp = plPos(); if pp then local d = pp - P.pos; P.ori = Vector3.new(P.ori.X, math.deg(math.atan2(-d.X, -d.Z)), P.ori.Z) end end) end)
F("copy_player_moves", function(c) mvAdd(c, "copy_player_moves", function(P, dt, m) local pp = plPos(); if not pp then return end m.p0 = m.p0 or pp; P.pos = m.base + (pp - m.p0) end) end)
F("mirror_player_moves", function(c) mvAdd(c, "mirror_player_moves", function(P, dt, m) local pp = plPos(); if not pp then return end m.p0 = m.p0 or pp; local d = pp - m.p0; P.pos = m.base + Vector3.new(-d.X, d.Y, -d.Z) end) end)
F("jump_with_player", function(c) mvAdd(c, "jump_with_player", function(P, dt, m) local h = plH(); if not h or not alive(h) then return end
	local vy = h.root.AssemblyLinearVelocity.Y
	if vy > 15 and not m.j then m.j = 0 end
	if m.j then m.j = m.j + dt; P.pos = m.base + Vector3.new(0, math.sin(math.min(1, m.j / 0.6) * math.pi) * 4, 0); if m.j >= 0.6 then m.j = nil; P.pos = m.base end end
end) end)
F("fall_when_stepped", function(c, a) local d = T(a, 0.5); mvAdd(c, "fall_when_stepped", function(P, dt, m, b) if not m.at and stood(P) then m.at = m.t + d end if m.at and m.t >= m.at then b.Anchored = false; MV[P] = nil; return false end end) end)
F("sink_when_stepped", function(c) mvAdd(c, "sink_when_stepped", function(P, dt, m) if stood(P) then P.pos = P.pos - Vector3.new(0, 2 * dt, 0) elseif P.pos.Y < m.base.Y then P.pos = P.pos + Vector3.new(0, math.min(m.base.Y - P.pos.Y, 2 * dt), 0) end end) end)
F("rise_when_stepped", function(c, a) local hgt = A(a, 15); mvAdd(c, "rise_when_stepped", function(P, dt, m) local goal = stood(P) and m.base.Y + hgt or m.base.Y; local dy = goal - P.pos.Y; P.pos = P.pos + Vector3.new(0, math.clamp(dy, -4 * dt, 4 * dt), 0) end) end)
F("tilt_when_stepped", function(c) mvAdd(c, "tilt_when_stepped", function(P, dt, m, b) local h = stood(P); local tx, tz = 0, 0
	if h then local o = hpos(h) - P.pos; tx = math.clamp(-o.Z / math.max(1, m.size.Z / 2), -1, 1) * 15; tz = math.clamp(o.X / math.max(1, m.size.X / 2), -1, 1) * -15 end
	P.ori = Vector3.new(P.ori.X + (m.ori.X + tx - P.ori.X) * math.min(1, dt * 4), P.ori.Y, P.ori.Z + (m.ori.Z + tz - P.ori.Z) * math.min(1, dt * 4))
end) end)
F("spin_when_stepped", function(c, a) local s = A(a, 90); mvAdd(c, "spin_when_stepped", function(P, dt) if stood(P) then P.ori = P.ori + Vector3.new(0, s * dt, 0) end end) end)
F("glow_when_stepped", function(c) mvAdd(c, "glow_when_stepped", function(P, dt, m, b) if not b:GetAttribute("bxMat") then b:SetAttribute("bxMat", P.mv0.mat.Name) end glow(b, stood(P) and true or false) end) end)
F("color_when_stepped", function(c, a) local col = color3(colorArg(trim(a) ~= "" and a or "lime")); mvAdd(c, "color_when_stepped", function(P, dt, m, b) b.Color = stood(P) and col or P.mv0.color end) end)

end)()
;(function()
-- ===== player abilities, part physics, spawning =====
local function TT(a, d) local t = trim(a); if t == "" then return d end return parseTime(t) or d end
local function tNum(a, d) local n = tonumber(evalExpr(trim(a))); if n == nil then return d end return n end
local function rnd(a, b) return a + math.random() * (b - a) end
local function fwd(h) local l = h.root and h.root.CFrame.LookVector or Vector3.new(0, 0, -1); return Vector3.new(l.X, 0, l.Z).Unit end
-- velocity is owned by the player's own computer, so tell it too
local function setVel(h, v) if not h.root then return end h.root.AssemblyLinearVelocity = v; if h.player then Remote:FireClient(h.player, "vel", v) end end
local function moveH(h, pos) if h.model then h.model:PivotTo(CFrame.new(pos) * (h.root.CFrame - h.root.Position)); setVel(h, Vector3.new()) end end
X.setVel = setVel; X.moveH = moveH

-- abilities are kept per person and the player's computer runs the movement ones
local function ab(h) h.ab = h.ab or {}; return h.ab end
local function sync(h) if h.player then Remote:FireClient(h.player, "ab", h.ab or {}) end end
local function AB(name, fn) H(name, function(c, h, a) fn(ab(h), a, h, c); sync(h) end) end
AB("double_jump", function(A) A.jumps = 1 end)
AB("triple_jump", function(A) A.jumps = 2 end)
AB("air_jumps", function(A, a) A.jumps = math.max(0, math.floor(tNum(a, 1))) end)
AB("infinite_jump", function(A) A.infjump = true end)
AB("no_air_jumps", function(A) A.jumps = 0; A.infjump = false end)
AB("glide", function(A) A.glide = true end)
AB("parachute", function(A) A.parachute = true end)
AB("no_parachute", function(A) A.parachute = false; A.glide = false end)
AB("feather_fall", function(A) A.gscale = 0.5 end)
AB("heavy_player", function(A) A.gscale = 2 end)
AB("moon_jump", function(A) A.gscale = 0.3 end)
AB("normal_weight", function(A) A.gscale = 1 end)
AB("dash_ability", function(A) A.dash = true end)
AB("sprint_ability", function(A) A.sprint = true end)
AB("backwards_controls", function(A) A.backwards = true end)
AB("mirror_controls", function(A) A.mirror = true end)
AB("drunk_walk", function(A) A.drunk = true end)
AB("normal_controls", function(A) A.backwards = false; A.mirror = false; A.drunk = false; A.autorun = false end)
AB("auto_run", function(A) A.autorun = true end)
AB("stop_auto_run", function(A) A.autorun = false end)
AB("bunny_hop", function(A) A.bunny = true end)
AB("pogo", function(A) A.pogo = true end)
AB("stop_bouncing", function(A) A.bunny = false; A.pogo = false; A.bounce = false end)
AB("bouncy_landing", function(A) A.bounce = true end)
AB("wall_jump", function(A) A.walljump = true end)
AB("wall_climb", function(A) A.wallclimb = true end)
AB("ground_pound", function(A) A.pound = true end)
AB("jetpack", function(A) A.jetpack = true end)
AB("hover_player", function(A, a) A.hover = TT(a, 3); A.hoverId = (A.hoverId or 0) + 1 end)
AB("spin_player", function(A, a) A.spin = tNum(a, 360) end)
AB("stop_spin_player", function(A) A.spin = 0 end)
AB("stop_on_a_dime", function(A) A.stopdead = true end)
AB("float_up", function(A, a) A.floatUp = tNum(a, 6) end)
AB("stop_floating", function(A) A.floatUp = 0 end)
AB("confuse", function(A, a, h) A.backwards = true; local t = TT(a, 5); A.confuseId = (A.confuseId or 0) + 1; local id = A.confuseId
	table.insert(LATER, {NOW + t, function() if A.confuseId == id then A.backwards = false; sync(h) end end}) end)
H("dash", function(c, h) if h.player then Remote:FireClient(h.player, "dash") elseif h.root then setVel(h, fwd(h) * 80 + Vector3.new(0, 10, 0)) end end)
H("no_jump", function(c, h) if h.hum then h.jp0 = h.jp0 or h.hum.JumpPower; h.hum.UseJumpPower = true; h.hum.JumpPower = 0 end end)
H("allow_jump", function(c, h) if h.hum then h.hum.JumpPower = h.jp0 or 50 * JPK end end)
H("remove_abilities", function(c, h) h.ab = {}; sync(h); h.grow = nil; h.drain = nil; h.regen = nil; if h.hum and h.jp0 then h.hum.JumpPower = h.jp0 end local t = h.root and h.root:FindFirstChild("BuildXTrail"); if t then t:Destroy() end end)
H("blink_forward", function(c, h, a) if h.root then moveH(h, hpos(h) + fwd(h) * tNum(a, 15)); sfx("swoosh", nil) end end)
H("random_teleport", function(c, h, a) local r = tNum(a, 50); if h.root then moveH(h, hpos(h) + Vector3.new(rnd(-r, r), 2, rnd(-r, r))) end end)
H("launch_up", function(c, h, a) if h.root then local v = h.root.AssemblyLinearVelocity; setVel(h, Vector3.new(v.X, tNum(a, 120), v.Z)) end end)
H("rocket_boost", function(c, h) if h.root then local f = fwd(h); setVel(h, Vector3.new(f.X * 90, 90, f.Z * 90)); sfx("explosion", nil) end end)
H("knockback", function(c, h, a) if not h.root then return end local d = hpos(h) - ownerPos(c); d = Vector3.new(d.X, 0, d.Z); if d.Magnitude < 0.01 then d = Vector3.new(0, 0, 1) end local s = tNum(a, 60); setVel(h, h.root.AssemblyLinearVelocity + d.Unit * s + Vector3.new(0, 25, 0)) end)
H("pull_in", function(c, h, a) if not h.root then return end local d = ownerPos(c) - hpos(h); d = Vector3.new(d.X, 0, d.Z); if d.Magnitude < 0.01 then return end local s = tNum(a, 60); setVel(h, h.root.AssemblyLinearVelocity + d.Unit * s + Vector3.new(0, 10, 0)) end)
H("stop_moving_player", function(c, h) setVel(h, Vector3.new()) end)
local function faceTo(h, dir) if not h.root or dir.Magnitude < 0.01 then return end local p = h.root.Position; h.root.CFrame = CFrame.lookAt(p, p + Vector3.new(dir.X, 0, dir.Z)) end
H("turn_around", function(c, h) if h.root then faceTo(h, -h.root.CFrame.LookVector) end end)
H("face_part", function(c, h) faceTo(h, ownerPos(c) - hpos(h)) end)
H("face_away", function(c, h) faceTo(h, hpos(h) - ownerPos(c)) end)
H("grow_slowly", function(c, h) h.grow = 0.15 end)
H("shrink_slowly", function(c, h) h.grow = -0.15 end)
H("stop_growing", function(c, h) h.grow = nil end)
H("random_size", function(c, h) setSize(h, rnd(0.4, 2.5)) end)
H("set_size", function(c, h, a) setSize(h, math.clamp(tNum(a, 1), 0.1, 10)) end)
H("drain", function(c, h, a) h.drain = tNum(a, 5) end)
H("stop_drain", function(c, h) h.drain = nil end)
H("fast_regen", function(c, h, a) h.regen = tNum(a, 10) end)
H("stop_regen", function(c, h) h.regen = nil end)
H("stun", function(c, h, a) local t = TT(a, 1); if not h.hum then return end h.stunWalk = h.stunWalk or h.hum.WalkSpeed; h.hum.WalkSpeed = 0; h.hum.PlatformStand = true
	if h.player then Remote:FireClient(h.player, "camera_shake", "0.3") end
	local tok = {} h.stunTok = tok
	table.insert(LATER, {NOW + t, function() if h.stunTok == tok and h.hum then h.hum.WalkSpeed = h.stunWalk; h.stunWalk = nil; h.hum.PlatformStand = false end end}) end)
H("ghost_for", function(c, h, a) CMD.ghost.hum(c, h, tostring(TT(a, 3))) end)
H("slow_for", function(c, h, a) timedSpeed(h, 0.4, TT(a, 5)) end)
H("coin_magnet", function(c, h, a) h.magnet = tNum(a, 25) end)
local function trailOn(h, cols)
	if not h.root then return end
	local old = h.root:FindFirstChild("BuildXTrail"); if old then old:Destroy() end
	local a0 = h.root:FindFirstChild("BXTA") or Instance.new("Attachment"); a0.Name = "BXTA"; a0.Position = Vector3.new(0, 1, 0); a0.Parent = h.root
	local a1 = h.root:FindFirstChild("BXTB") or Instance.new("Attachment"); a1.Name = "BXTB"; a1.Position = Vector3.new(0, -1, 0); a1.Parent = h.root
	local t = Instance.new("Trail"); t.Name = "BuildXTrail"; t.Attachment0 = a0; t.Attachment1 = a1; t.Lifetime = 0.7; t.LightEmission = 0.6
	local ks = {} for i, col in ipairs(cols) do table.insert(ks, ColorSequenceKeypoint.new((i - 1) / math.max(1, #cols - 1), hex2color(col))) end
	if #ks == 1 then table.insert(ks, ColorSequenceKeypoint.new(1, ks[1].Value)) end
	t.Color = ColorSequence.new(ks); t.Transparency = NumberSequence.new(0.2, 1); t.Parent = h.root
end
H("sparkle_trail", function(c, h) trailOn(h, {"#ffffff", "#fff2a8"}) end)
H("rainbow_trail", function(c, h) trailOn(h, {"#ff4d4d", "#ffb84d", "#fff24d", "#4dff6b", "#4dc3ff", "#a64dff"}) end)
H("fire_trail", function(c, h) trailOn(h, {"#ffd24d", "#ff7a1a", "#c81e00"}) end)
H("no_trail", function(c, h) local t = h.root and h.root:FindFirstChild("BuildXTrail"); if t then t:Destroy() end end)
H("swap_places", function(c, h) local best, bd = nil, math.huge
	for _, o in ipairs(humans()) do if o ~= h and alive(o) then local d = (hpos(o) - hpos(h)).Magnitude; if d < bd then bd = d; best = o end end end
	if best then local p = hpos(h); moveH(h, hpos(best)); moveH(best, p) end end)
H("bring_to_me", function(c, h) moveH(h, ownerPos(c) + Vector3.new(rnd(-3, 3), 2, rnd(-3, 3))) end)
H("send_home", function(c, h) if h.spawnPos then moveH(h, h.spawnPos) end end)
H("throw_randomly", function(c, h) local an = math.random() * math.pi * 2; setVel(h, Vector3.new(math.cos(an) * 80, 70, math.sin(an) * 80)) end)
H("hp_to_full_after", function(c, h, a) table.insert(LATER, {NOW + TT(a, 3), function() if alive(h) then h.hum.Health = h.hum.MaxHealth end end}) end)
H("half_health", function(c, h) if alive(h) then h.hum.Health = math.max(1, h.hum.Health / 2) end end)
H("double_max_health", function(c, h) if alive(h) then local k = h.hum.Health; h.hum.MaxHealth = h.hum.MaxHealth * 2; h.hum.Health = k * 2 end end)
table.insert(HOOK.char, function(h) h.spawnPos = hpos(h); if h.ab then task.defer(function() sync(h) end) end end)
table.insert(STEPS, function(dt)
	for _, h in ipairs(humans()) do if alive(h) then
		if h.grow then setSize(h, math.clamp((h.size or 1) + h.grow * dt, 0.2, 10)) end
		if h.drain then h.hum:TakeDamage(h.drain * dt) end
		if h.regen then h.hum.Health = math.min(h.hum.MaxHealth, h.hum.Health + h.regen * dt) end
		if h.magnet then
			for _, P in ipairs(SCRIPTS) do
				if P.alive ~= false and P.collect and P.kind == "part" and P.inst and P.inst.Parent and P.pos then
					local d = hpos(h) - P.pos
					if d.Magnitude < h.magnet and d.Magnitude > 0.5 then P.pos = P.pos + d.Unit * math.min(d.Magnitude, 40 * dt); syncPart(P) end
				end
			end
		end
	end end
end)

-- part physics
local function body(c) local b = bp(c); if b and c.P.kind == "part" then return b end return nil end
local function phys(b, k, v)
	local p = b.CustomPhysicalProperties or PhysicalProperties.new(b.Material)
	local d, f, e, fw, ew = p.Density or 0.7, p.Friction or 0.3, p.Elasticity or 0.5, p.FrictionWeight or 1, p.ElasticityWeight or 1
	if k == "d" then d = math.clamp(v, 0.01, 100) elseif k == "f" then f = math.clamp(v, 0, 2); fw = 100 elseif k == "e" then e = math.clamp(v, 0, 1); ew = 100 end
	b.CustomPhysicalProperties = PhysicalProperties.new(d, math.min(f, 2), e, fw, ew)
end
local function loose(c) local b = body(c); if not b then return nil end if b.Anchored then c.P.anchored0 = true; b.Anchored = false end return b end
F("lightweight", function(c) local b = body(c); if b then phys(b, "d", 0.05) end end)
F("heavy", function(c) local b = body(c); if b then phys(b, "d", 50) end end)
F("density", function(c, a) local b = body(c); if b then phys(b, "d", num(a, 1)) end end)
F("friction", function(c, a) local b = body(c); if b then phys(b, "f", num(a, 0.3)) end end)
F("elasticity", function(c, a) local b = body(c); if b then phys(b, "e", num(a, 0.5)) end end)
F("mass", function(c, a) local b = body(c); if b then local v = b.Size.X * b.Size.Y * b.Size.Z; phys(b, "d", math.max(0.05, num(a, 10)) / math.max(0.01, v)) end end)
F("launch_self", function(c, a) local b = loose(c); if b then b.AssemblyLinearVelocity = parseVec(a, Vector3.new(0, 120, 0)) end end)
F("push_self", function(c, a) local b = loose(c); if b then b.AssemblyLinearVelocity = b.AssemblyLinearVelocity + parseVec(a, Vector3.new(0, 0, 40)) end end)
F("spin_physics", function(c, a) local b = loose(c); if b then b.AssemblyAngularVelocity = parseVec(a, Vector3.new(0, 10, 0)) end end)
F("sink", function(c) local b = bp(c); local f = b and b:FindFirstChild("BuildXFloat"); if f then f:Destroy() end end)
F("magnet", function(c, a) c.P.magnet = num(a, 30) end)
F("repel", function(c, a) c.P.magnet = -num(a, 30) end)
F("clone_at", function(c, a) if c.P.kind == "part" then cloneThing(c.P, parseVec(a, Vector3.new(0, 20, 0))) end end)
local function spawnPart(shape, size, at)
	local p = Instance.new("Part"); p.Shape = shape; p.Size = size; p.Color = color3("random"); p.Anchored = false; p.Position = at; p.Parent = workspace
	return p
end
F("spawn_ball", function(c, a) spawnPart(Enum.PartType.Ball, Vector3.new(3, 3, 3), trim(a) ~= "" and parseVec(a, Vector3.new()) or ownerPos(c) + Vector3.new(0, 10, 0)) end)
F("spawn_block", function(c, a) spawnPart(Enum.PartType.Block, Vector3.new(4, 2, 2), trim(a) ~= "" and parseVec(a, Vector3.new()) or ownerPos(c) + Vector3.new(0, 10, 0)) end)
-- a bot from a bot with that name (in Storage or the world), or a fresh cube bot
local function makeBot(name, at, from)
	name = trim(name ~= "" and name or "Noob")
	local src
	local st = ServerStorage:FindFirstChild("Storage")
	for _, root in ipairs({st, workspace}) do
		if root and not src then for _, d in ipairs(root:GetDescendants()) do if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") and lower(d.Name) == lower(name) and not Players:GetPlayerFromCharacter(d) then src = d break end end end
	end
	local P0 = src and hOf(src) and hOf(src).P
	local m
	if src then m = (DATA._botCopies[src] or src):Clone()
	else
		m = Instance.new("Model"); m.Name = name
		local r = Instance.new("Part"); r.Name = "HumanoidRootPart"; r.Size = Vector3.new(3, 3, 3); r.Color = from and from.root and from.root.Color or Color3.fromRGB(91, 108, 255); r.Anchored = false; r.Parent = m
		local hd = Instance.new("Part"); hd.Name = "Head"; hd.Size = Vector3.new(1, 1, 1); hd.Transparency = 1; hd.CanCollide = false; hd.Massless = true; hd.Position = r.Position + Vector3.new(0, 1.5, 0); hd.Parent = m
		local w = Instance.new("WeldConstraint"); w.Part0 = r; w.Part1 = hd; w.Parent = r
		local hum = Instance.new("Humanoid"); hum.RequiresNeck = false; hum.HipHeight = 0; hum.Parent = m
		m.PrimaryPart = r
	end
	m.Parent = workspace
	m:PivotTo(CFrame.new(at))
	local P = registerThing(m, (P0 and P0.codeJSON) or (from and from.P and from.P.codeJSON) or "", "bot", true)
	return P and P.h, m
end
X.makeBot = makeBot
F("spawn_bot", function(c, a) makeBot(a, ownerPos(c) + Vector3.new(rnd(-5, 5), 3, rnd(-5, 5))) end)
F("reset", function(c) local P = c.P; local b = body(c); if not b or not P.home then return end if P.anchored0 ~= nil then b.Anchored = P.anchored0 end P.pos = P.home[1]; P.ori = P.home[2]; b.AssemblyLinearVelocity = Vector3.new(); b.AssemblyAngularVelocity = Vector3.new(); if not b.Anchored then b.CFrame = CFrame.new(P.pos) * CFrame.fromOrientation(math.rad(P.ori.X), math.rad(P.ori.Y), math.rad(P.ori.Z)) else syncPart(P) end end)
local function vforce(b, name) local f = b:FindFirstChild(name); if not f then local at = b:FindFirstChild("BXAtt") or Instance.new("Attachment"); at.Name = "BXAtt"; at.Parent = b; f = Instance.new("VectorForce"); f.Name = name; f.Attachment0 = at; f.RelativeTo = Enum.ActuatorRelativeTo.World; f.ApplyAtCenterOfMass = true; f.Parent = b end return f end
F("gravity_self", function(c, a) local b = loose(c); if b then c.P.gscale = num(a, 1) end end)
F("sleep", function(c) local b = body(c); if b then b.AssemblyLinearVelocity = Vector3.new(); b.AssemblyAngularVelocity = Vector3.new() end end)
F("stop_dead", function(c) local b = body(c); if b then b.AssemblyLinearVelocity = Vector3.new(); b.AssemblyAngularVelocity = Vector3.new() end end)
-- where a target word points: a part, a person or x,y,z
local function tpos(w, c)
	w = trim(w)
	if w:find(",") then return parseVec(w, Vector3.new()) end
	local ok, T = pcall(targets, lower(w):gsub("%s+", "_"), c)
	if ok and T and T.h and T.h[1] then return hpos(T.h[1]), T.h[1].root end
	local P = findP(w); if P and P.inst and P.inst.Parent then local i = P.inst; return (i:IsA("Model") and i:GetPivot().Position or i.Position), (i:IsA("BasePart") and i or nil) end
	return nil
end
local function att(b, name, at) local a0 = b:FindFirstChild(name) or Instance.new("Attachment"); a0.Name = name; a0.Parent = b; if at then a0.WorldPosition = at end return a0 end
local function link(c, a, cls, setup)
	local b = loose(c); if not b then return end
	local p = split(a, ":"); local pos, other = tpos(p[1] or "", c); if not pos then return end
	local a1
	if other then a1 = att(other, "BXLinkTo") else local anchor = Instance.new("Part"); anchor.Anchored = true; anchor.CanCollide = false; anchor.Transparency = 1; anchor.Size = Vector3.new(0.2, 0.2, 0.2); anchor.Position = pos; anchor.Name = "BuildXLinkPoint"; anchor.Parent = b; a1 = att(anchor, "BXLinkTo") end
	local k = Instance.new(cls); k.Name = "BuildXLink"; k.Attachment0 = att(b, "BXLinkFrom"); k.Attachment1 = a1; k.Visible = true
	setup(k, tonumber(trim(p[2] or "")), (pos - b.Position).Magnitude); k.Parent = b
end
F("rope_to", function(c, a) link(c, a, "RopeConstraint", function(k, n, d) k.Length = n or d end) end)
F("spring_to", function(c, a) link(c, a, "SpringConstraint", function(k, n, d) k.FreeLength = 0; k.Stiffness = (n or 8) * 50; k.Damping = 10; k.Coils = 6 end) end)
F("rod_to", function(c, a) link(c, a, "RodConstraint", function(k, n, d) k.Length = d end) end)
F("unlink", function(c) local b = body(c); if not b then return end for _, d in ipairs(b:GetChildren()) do if d.Name == "BuildXLink" or d.Name == "BuildXLinkPoint" or d.Name == "BXPull" then d:Destroy() end end c.P.pull = nil; c.P.homing = nil end)
F("magnet_to", function(c, a) local b = loose(c); if b then local p = split(a, ":"); c.P.pull = {w = trim(p[1] or ""), s = tonumber(trim(p[2] or "")) or 60} end end)
F("push_away_from", function(c, a) local b = loose(c); if b then local p = split(a, ":"); c.P.pull = {w = trim(p[1] or ""), s = -(tonumber(trim(p[2] or "")) or 60)} end end)
F("homing", function(c, a) local b = loose(c); if b then c.P.homing = num(a, 40) end end)
F("gravity_well", function(c, a) local p = split(a, ":"); c.P.well = {r = tonumber(trim(p[1] or "")) or 30, s = tonumber(trim(p[2] or "")) or 80} end)
F("anti_gravity_field", function(c, a) c.P.antigrav = num(a, 20) end)
F("air_drag", function(c, a) local b = loose(c); if b then c.P.drag = math.clamp(num(a, 1), 0, 5) end end)
F("max_speed", function(c, a) local b = body(c); if b then c.P.maxSpeed = num(a, 50) end end)
F("bounce_forever", function(c) local b = body(c); if b then b.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 1, 100, 100) end end)
local function onHit(c, fn) local b = body(c); if not b then return end b.Touched:Connect(function(hit) if c.P.alive ~= false and b.Parent and not hit:IsDescendantOf(b) then fn(b, hit) end end) end
F("stick_on_hit", function(c) onHit(c, function(b) if not b.Anchored then b.Anchored = true; readPart(c.P) end end) end)
F("shatter_on_hit", function(c, a) local min = num(a, 40); onHit(c, function(b) if b.AssemblyLinearVelocity.Magnitude >= min then local cc = shallow(c); CMD.crumble.fn(cc, "") end end) end)
F("explode_on_hit", function(c, a) local min = num(a, 30); onHit(c, function(b) if b.AssemblyLinearVelocity.Magnitude >= min then explodeAt(b.Position, 8); deleteP(c.P) end end) end)
local function lob(b, target, speed)
	local d = target - b.Position; local flat = Vector3.new(d.X, 0, d.Z); local t = math.max(0.4, flat.Magnitude / (speed or 50))
	b.AssemblyLinearVelocity = flat / t + Vector3.new(0, d.Y / t + 0.5 * workspace.Gravity * t, 0)
end
F("throw_at_player", function(c) local b = loose(c); local h = whoH(c); if b and h and alive(h) then lob(b, hpos(h), 50) end end)
F("launch_toward", function(c, a) local b = loose(c); if not b then return end local p = split(a, ":"); local pos = tpos(p[1] or "", c); if pos then b.AssemblyLinearVelocity = (pos - b.Position).Unit * (tonumber(trim(p[2] or "")) or 80) end end)
F("random_push", function(c, a) local b = loose(c); if b then local s = num(a, 40); local an = math.random() * math.pi * 2; b.AssemblyLinearVelocity = b.AssemblyLinearVelocity + Vector3.new(math.cos(an) * s, s * 0.4, math.sin(an) * s) end end)
F("buoyant", function(c) local b = loose(c); if b then c.P.buoyant = true end end)
table.insert(STEPS, function(dt)
	for _, P in ipairs(SCRIPTS) do
		local b = P.alive ~= false and P.kind == "part" and P.inst and P.inst.Parent and P.inst:IsA("BasePart") and P.inst or nil
		if b then
			local pos = b.Position
			if P.magnet then for _, h in ipairs(humans()) do if alive(h) then local d = pos - hpos(h); if d.Magnitude < 40 and d.Magnitude > 1 then h.root.AssemblyLinearVelocity = h.root.AssemblyLinearVelocity + d.Unit * P.magnet * dt end end end end
			if not b.Anchored then
				readPart(P)
				local m = b.AssemblyMass
				local f = Vector3.new()
				if P.gscale then f = f + Vector3.new(0, m * workspace.Gravity * (1 - P.gscale), 0) end
				if P.pull then local tp = tpos(P.pull.w, {P = P}); if tp then local d = tp - pos; if d.Magnitude > 0.5 then f = f + d.Unit * P.pull.s * m end end end
				if P.homing then local h = whoH(nil); if h and alive(h) then local want = (hpos(h) - pos).Unit * P.homing; b.AssemblyLinearVelocity = b.AssemblyLinearVelocity:Lerp(want, math.min(1, dt * 2)) end end
				if P.drag then b.AssemblyLinearVelocity = b.AssemblyLinearVelocity * math.max(0, 1 - P.drag * dt) end
				if P.maxSpeed and b.AssemblyLinearVelocity.Magnitude > P.maxSpeed then b.AssemblyLinearVelocity = b.AssemblyLinearVelocity.Unit * P.maxSpeed end
				if P.buoyant then
					for _, W in ipairs(SCRIPTS) do local wb = W.f and W.f.water and W.inst; if wb and wb:IsA("BasePart") then local l = wb.CFrame:PointToObjectSpace(pos); local s = wb.Size / 2; if math.abs(l.X) < s.X and math.abs(l.Z) < s.Z and l.Y < s.Y then f = f + Vector3.new(0, m * workspace.Gravity * 1.4, 0); b.AssemblyLinearVelocity = b.AssemblyLinearVelocity * (1 - dt) end end end
				end
				if P.gscale or P.pull or P.buoyant then vforce(b, "BXPull").Force = f end
			end
			if P.well or P.antigrav then
				local r = P.well and P.well.r or P.antigrav
				for _, Q in ipairs(SCRIPTS) do local qb = Q ~= P and Q.kind == "part" and Q.inst and Q.inst.Parent and Q.inst:IsA("BasePart") and not Q.inst.Anchored and Q.inst
					if qb then local d = pos - qb.Position; if d.Magnitude < r then
						if P.well then qb.AssemblyLinearVelocity = qb.AssemblyLinearVelocity + d.Unit * P.well.s * dt else qb.AssemblyLinearVelocity = qb.AssemblyLinearVelocity + Vector3.new(0, (workspace.Gravity + 10) * dt, 0) end
					end end
				end
			end
		end
	end
end)

-- camera, screen and weather happen on each player's own screen
for _, k in ipairs({"top_down", "side_view", "camera_follow", "camera_at", "cinematic", "no_cinematic", "camera_orbit", "camera_stop_orbit", "camera_low_angle", "camera_high_angle", "camera_level", "camera_free_angle",
	"camera_close", "camera_far", "camera_shoulder", "camera_center", "camera_look_at", "camera_stop_looking", "camera_pan_to", "camera_head_bob", "camera_no_bob", "camera_roll", "camera_unroll", "camera_breathe",
	"camera_stop_breathe", "dolly_zoom", "camera_spin_once", "camera_behind", "camera_front", "camera_isometric", "camera_birdseye"}) do
	F(k, function(c, a)
		local arg = a
		if k == "camera_follow" or k == "camera_look_at" then local pos, part = tpos(a, c); local P = findP(trim(a)); local inst = P and (P.kind == "bot" and P.h and P.h.root or P.inst) or part; arg = inst end
		send(c, "cam", k, arg)
	end)
end
for _, k in ipairs({"screen_sharp_contrast", "screen_washed_out", "screen_vivid", "screen_dim", "screen_bright", "night_vision", "thermal_vision", "dream_vision", "sunburn_vision", "frozen_vision", "screen_hue", "screen_normal",
	"screen_tilt", "screen_upside_down", "screen_mirror", "screen_straight", "vignette", "tunnel_vision", "red_damage_edges", "scanlines", "film_grain", "letterbox", "underwater_screen", "fade_from_black", "flash_screen_color", "clear_screen_effects", "tint_screen"}) do
	F(k, function(c, a) local arg = a; if k == "flash_screen_color" or k == "tint_screen" then arg = colorHex(colorArg(trim(a) ~= "" and a or (k == "tint_screen" and "orange" or "white"))) end send(c, "scr", k, arg) end)
end
local WX = {kind = nil, amt = 1, wind = 0}
local function wsend() Remote:FireAllClients("weather", WX) end
for _, k in ipairs({"weather_rain", "weather_snow", "hail", "sleet", "sandstorm", "thunderstorm", "fireflies", "falling_leaves", "cherry_blossoms", "ash_fall", "meteor_shower", "dust_motes", "blizzard", "bubbles_rising"}) do
	F(k, function(c, a) WX.kind = k; WX.amt = math.clamp(num(a, 1), 0.1, 3); wsend() end)
end
F("clear_weather", function() WX.kind = nil; WX.wind = 0; wsend() end)
F("weather_wind", function(c, a) WX.wind = math.clamp(num(a, 1), -3, 3); wsend() end)
F("weather_amount", function(c, a) WX.amt = math.clamp(num(a, 1), 0.1, 3); wsend() end)
F("aurora", function() WX.aurora = true; wsend() end)
F("no_aurora", function() WX.aurora = false; wsend() end)
F("sky_rainbow", function() WX.rainbow = true; wsend() end)
F("no_sky_rainbow", function() WX.rainbow = false; wsend() end)
F("rain_hurts", function(c, a) WX.hurt = num(a, 2) end)
F("weather_cycle", function(c, a) WX.cycle = math.max(5, TT(a, 30)); WX.cycT = WX.cycle end)
F("stop_weather_cycle", function() WX.cycle = nil end)
F("lightning_strike", function(c, a)
	local p
	if trim(a) ~= "" then p = tpos(a, c) end
	if not p then local h = whoH(nil); p = (h and alive(h) and hpos(h) or Vector3.new()) + Vector3.new(rnd(-60, 60), 0, rnd(-60, 60)) end
	CMD.lightning.fn({P = {pos = p, kind = "part"}}, "")
end)
X.weather = WX
local RP = RaycastParams.new()
table.insert(STEPS, function(dt)
	if WX.cycle then WX.cycT = WX.cycT - dt; if WX.cycT <= 0 then WX.cycT = WX.cycle; local all = {"weather_rain", "weather_snow", "thunderstorm", "falling_leaves", nil}; WX.kind = all[math.random(1, 5)]; wsend() end end
	if WX.hurt and WX.kind and (WX.kind == "weather_rain" or WX.kind == "thunderstorm" or WX.kind == "sleet" or WX.kind == "hail") then
		for _, h in ipairs(humans()) do if alive(h) then
			RP.FilterType = Enum.RaycastFilterType.Exclude; RP.FilterDescendantsInstances = {h.model}
			if not workspace:Raycast(hpos(h), Vector3.new(0, 200, 0), RP) then h.hum:TakeDamage(WX.hurt * dt) end
		end end
	end
	if WX.kind == "thunderstorm" and math.random() < dt / 6 then local h = whoH(nil); if h and alive(h) then CMD.lightning_strike.fn({}, "") end end
end)

end)()
;(function()
-- ===== player abilities, part physics, spawning =====
local function TT(a, d) local t = trim(a); if t == "" then return d end return parseTime(t) or d end
local function tNum(a, d) local n = tonumber(evalExpr(trim(a))); if n == nil then return d end return n end
local function rnd(a, b) return a + math.random() * (b - a) end
local function fwd(h) local l = h.root and h.root.CFrame.LookVector or Vector3.new(0, 0, -1); return Vector3.new(l.X, 0, l.Z).Unit end
-- velocity is owned by the player's own computer, so tell it too
local function setVel(h, v) if not h.root then return end h.root.AssemblyLinearVelocity = v; if h.player then Remote:FireClient(h.player, "vel", v) end end
local function moveH(h, pos) if h.model then h.model:PivotTo(CFrame.new(pos) * (h.root.CFrame - h.root.Position)); setVel(h, Vector3.new()) end end
X.setVel = setVel; X.moveH = moveH

-- abilities are kept per person and the player's computer runs the movement ones
local function ab(h) h.ab = h.ab or {}; return h.ab end
local function sync(h) if h.player then Remote:FireClient(h.player, "ab", h.ab or {}) end end
local function AB(name, fn) H(name, function(c, h, a) fn(ab(h), a, h, c); sync(h) end) end
AB("double_jump", function(A) A.jumps = 1 end)
AB("triple_jump", function(A) A.jumps = 2 end)
AB("air_jumps", function(A, a) A.jumps = math.max(0, math.floor(tNum(a, 1))) end)
AB("infinite_jump", function(A) A.infjump = true end)
AB("no_air_jumps", function(A) A.jumps = 0; A.infjump = false end)
AB("glide", function(A) A.glide = true end)
AB("parachute", function(A) A.parachute = true end)
AB("no_parachute", function(A) A.parachute = false; A.glide = false end)
AB("feather_fall", function(A) A.gscale = 0.5 end)
AB("heavy_player", function(A) A.gscale = 2 end)
AB("moon_jump", function(A) A.gscale = 0.3 end)
AB("normal_weight", function(A) A.gscale = 1 end)
AB("dash_ability", function(A) A.dash = true end)
AB("sprint_ability", function(A) A.sprint = true end)
AB("backwards_controls", function(A) A.backwards = true end)
AB("mirror_controls", function(A) A.mirror = true end)
AB("drunk_walk", function(A) A.drunk = true end)
AB("normal_controls", function(A) A.backwards = false; A.mirror = false; A.drunk = false; A.autorun = false end)
AB("auto_run", function(A) A.autorun = true end)
AB("stop_auto_run", function(A) A.autorun = false end)
AB("bunny_hop", function(A) A.bunny = true end)
AB("pogo", function(A) A.pogo = true end)
AB("stop_bouncing", function(A) A.bunny = false; A.pogo = false; A.bounce = false end)
AB("bouncy_landing", function(A) A.bounce = true end)
AB("wall_jump", function(A) A.walljump = true end)
AB("wall_climb", function(A) A.wallclimb = true end)
AB("ground_pound", function(A) A.pound = true end)
AB("jetpack", function(A) A.jetpack = true end)
AB("hover_player", function(A, a) A.hover = TT(a, 3); A.hoverId = (A.hoverId or 0) + 1 end)
AB("spin_player", function(A, a) A.spin = tNum(a, 360) end)
AB("stop_spin_player", function(A) A.spin = 0 end)
AB("stop_on_a_dime", function(A) A.stopdead = true end)
AB("float_up", function(A, a) A.floatUp = tNum(a, 6) end)
AB("stop_floating", function(A) A.floatUp = 0 end)
AB("confuse", function(A, a, h) A.backwards = true; local t = TT(a, 5); A.confuseId = (A.confuseId or 0) + 1; local id = A.confuseId
	table.insert(LATER, {NOW + t, function() if A.confuseId == id then A.backwards = false; sync(h) end end}) end)
H("dash", function(c, h) if h.player then Remote:FireClient(h.player, "dash") elseif h.root then setVel(h, fwd(h) * 80 + Vector3.new(0, 10, 0)) end end)
H("no_jump", function(c, h) if h.hum then h.jp0 = h.jp0 or h.hum.JumpPower; h.hum.UseJumpPower = true; h.hum.JumpPower = 0 end end)
H("allow_jump", function(c, h) if h.hum then h.hum.JumpPower = h.jp0 or 50 end end)
H("remove_abilities", function(c, h) h.ab = {}; sync(h); h.grow = nil; h.drain = nil; h.regen = nil; if h.hum and h.jp0 then h.hum.JumpPower = h.jp0 end local t = h.root and h.root:FindFirstChild("BuildXTrail"); if t then t:Destroy() end end)
H("blink_forward", function(c, h, a) if h.root then moveH(h, hpos(h) + fwd(h) * tNum(a, 15)); sfx("swoosh", nil) end end)
H("random_teleport", function(c, h, a) local r = tNum(a, 50); if h.root then moveH(h, hpos(h) + Vector3.new(rnd(-r, r), 2, rnd(-r, r))) end end)
H("launch_up", function(c, h, a) if h.root then local v = h.root.AssemblyLinearVelocity; setVel(h, Vector3.new(v.X, tNum(a, 120), v.Z)) end end)
H("rocket_boost", function(c, h) if h.root then local f = fwd(h); setVel(h, Vector3.new(f.X * 90, 90, f.Z * 90)); sfx("explosion", nil) end end)
H("knockback", function(c, h, a) if not h.root then return end local d = hpos(h) - ownerPos(c); d = Vector3.new(d.X, 0, d.Z); if d.Magnitude < 0.01 then d = Vector3.new(0, 0, 1) end local s = tNum(a, 60); setVel(h, h.root.AssemblyLinearVelocity + d.Unit * s + Vector3.new(0, 25, 0)) end)
H("pull_in", function(c, h, a) if not h.root then return end local d = ownerPos(c) - hpos(h); d = Vector3.new(d.X, 0, d.Z); if d.Magnitude < 0.01 then return end local s = tNum(a, 60); setVel(h, h.root.AssemblyLinearVelocity + d.Unit * s + Vector3.new(0, 10, 0)) end)
H("stop_moving_player", function(c, h) setVel(h, Vector3.new()) end)
local function faceTo(h, dir) if not h.root or dir.Magnitude < 0.01 then return end local p = h.root.Position; h.root.CFrame = CFrame.lookAt(p, p + Vector3.new(dir.X, 0, dir.Z)) end
H("turn_around", function(c, h) if h.root then faceTo(h, -h.root.CFrame.LookVector) end end)
H("face_part", function(c, h) faceTo(h, ownerPos(c) - hpos(h)) end)
H("face_away", function(c, h) faceTo(h, hpos(h) - ownerPos(c)) end)
H("grow_slowly", function(c, h) h.grow = 0.15 end)
H("shrink_slowly", function(c, h) h.grow = -0.15 end)
H("stop_growing", function(c, h) h.grow = nil end)
H("random_size", function(c, h) setSize(h, rnd(0.4, 2.5)) end)
H("set_size", function(c, h, a) setSize(h, math.clamp(tNum(a, 1), 0.1, 10)) end)
H("drain", function(c, h, a) h.drain = tNum(a, 5) end)
H("stop_drain", function(c, h) h.drain = nil end)
H("fast_regen", function(c, h, a) h.regen = tNum(a, 10) end)
H("stop_regen", function(c, h) h.regen = nil end)
H("stun", function(c, h, a) local t = TT(a, 1); if not h.hum then return end h.stunWalk = h.stunWalk or h.hum.WalkSpeed; h.hum.WalkSpeed = 0; h.hum.PlatformStand = true
	if h.player then Remote:FireClient(h.player, "camera_shake", "0.3") end
	local tok = {} h.stunTok = tok
	table.insert(LATER, {NOW + t, function() if h.stunTok == tok and h.hum then h.hum.WalkSpeed = h.stunWalk; h.stunWalk = nil; h.hum.PlatformStand = false end end}) end)
H("ghost_for", function(c, h, a) CMD.ghost.hum(c, h, tostring(TT(a, 3))) end)
H("slow_for", function(c, h, a) timedSpeed(h, 0.4, TT(a, 5)) end)
H("coin_magnet", function(c, h, a) h.magnet = tNum(a, 25) end)
local function trailOn(h, cols)
	if not h.root then return end
	local old = h.root:FindFirstChild("BuildXTrail"); if old then old:Destroy() end
	local a0 = h.root:FindFirstChild("BXTA") or Instance.new("Attachment"); a0.Name = "BXTA"; a0.Position = Vector3.new(0, 1, 0); a0.Parent = h.root
	local a1 = h.root:FindFirstChild("BXTB") or Instance.new("Attachment"); a1.Name = "BXTB"; a1.Position = Vector3.new(0, -1, 0); a1.Parent = h.root
	local t = Instance.new("Trail"); t.Name = "BuildXTrail"; t.Attachment0 = a0; t.Attachment1 = a1; t.Lifetime = 0.7; t.LightEmission = 0.6
	local ks = {} for i, col in ipairs(cols) do table.insert(ks, ColorSequenceKeypoint.new((i - 1) / math.max(1, #cols - 1), hex2color(col))) end
	if #ks == 1 then table.insert(ks, ColorSequenceKeypoint.new(1, ks[1].Value)) end
	t.Color = ColorSequence.new(ks); t.Transparency = NumberSequence.new(0.2, 1); t.Parent = h.root
end
H("sparkle_trail", function(c, h) trailOn(h, {"#ffffff", "#fff2a8"}) end)
H("rainbow_trail", function(c, h) trailOn(h, {"#ff4d4d", "#ffb84d", "#fff24d", "#4dff6b", "#4dc3ff", "#a64dff"}) end)
H("fire_trail", function(c, h) trailOn(h, {"#ffd24d", "#ff7a1a", "#c81e00"}) end)
H("no_trail", function(c, h) local t = h.root and h.root:FindFirstChild("BuildXTrail"); if t then t:Destroy() end end)
H("swap_places", function(c, h) local best, bd = nil, math.huge
	for _, o in ipairs(humans()) do if o ~= h and alive(o) then local d = (hpos(o) - hpos(h)).Magnitude; if d < bd then bd = d; best = o end end end
	if best then local p = hpos(h); moveH(h, hpos(best)); moveH(best, p) end end)
H("bring_to_me", function(c, h) moveH(h, ownerPos(c) + Vector3.new(rnd(-3, 3), 2, rnd(-3, 3))) end)
H("send_home", function(c, h) if h.spawnPos then moveH(h, h.spawnPos) end end)
H("throw_randomly", function(c, h) local an = math.random() * math.pi * 2; setVel(h, Vector3.new(math.cos(an) * 80, 70, math.sin(an) * 80)) end)
H("hp_to_full_after", function(c, h, a) table.insert(LATER, {NOW + TT(a, 3), function() if alive(h) then h.hum.Health = h.hum.MaxHealth end end}) end)
H("half_health", function(c, h) if alive(h) then h.hum.Health = math.max(1, h.hum.Health / 2) end end)
H("double_max_health", function(c, h) if alive(h) then local k = h.hum.Health; h.hum.MaxHealth = h.hum.MaxHealth * 2; h.hum.Health = k * 2 end end)
table.insert(HOOK.char, function(h) h.spawnPos = hpos(h); if h.ab then task.defer(function() sync(h) end) end end)
table.insert(STEPS, function(dt)
	for _, h in ipairs(humans()) do if alive(h) then
		if h.grow then setSize(h, math.clamp((h.size or 1) + h.grow * dt, 0.2, 10)) end
		if h.drain then h.hum:TakeDamage(h.drain * dt) end
		if h.regen then h.hum.Health = math.min(h.hum.MaxHealth, h.hum.Health + h.regen * dt) end
		if h.magnet then
			for _, P in ipairs(SCRIPTS) do
				if P.alive ~= false and P.collect and P.kind == "part" and P.inst and P.inst.Parent and P.pos then
					local d = hpos(h) - P.pos
					if d.Magnitude < h.magnet and d.Magnitude > 0.5 then P.pos = P.pos + d.Unit * math.min(d.Magnitude, 40 * dt); syncPart(P) end
				end
			end
		end
	end end
end)

-- part physics
local function body(c) local b = bp(c); if b and c.P.kind == "part" then return b end return nil end
local function phys(b, k, v)
	local p = b.CustomPhysicalProperties or PhysicalProperties.new(b.Material)
	local d, f, e, fw, ew = p.Density or 0.7, p.Friction or 0.3, p.Elasticity or 0.5, p.FrictionWeight or 1, p.ElasticityWeight or 1
	if k == "d" then d = math.clamp(v, 0.01, 100) elseif k == "f" then f = math.clamp(v, 0, 2); fw = 100 elseif k == "e" then e = math.clamp(v, 0, 1); ew = 100 end
	b.CustomPhysicalProperties = PhysicalProperties.new(d, math.min(f, 2), e, fw, ew)
end
local function loose(c) local b = body(c); if not b then return nil end if b.Anchored then c.P.anchored0 = true; b.Anchored = false end return b end
F("lightweight", function(c) local b = body(c); if b then phys(b, "d", 0.05) end end)
F("heavy", function(c) local b = body(c); if b then phys(b, "d", 50) end end)
F("density", function(c, a) local b = body(c); if b then phys(b, "d", num(a, 1)) end end)
F("friction", function(c, a) local b = body(c); if b then phys(b, "f", num(a, 0.3)) end end)
F("elasticity", function(c, a) local b = body(c); if b then phys(b, "e", num(a, 0.5)) end end)
F("mass", function(c, a) local b = body(c); if b then local v = b.Size.X * b.Size.Y * b.Size.Z; phys(b, "d", math.max(0.05, num(a, 10)) / math.max(0.01, v)) end end)
F("launch_self", function(c, a) local b = loose(c); if b then b.AssemblyLinearVelocity = parseVec(a, Vector3.new(0, 120, 0)) end end)
F("push_self", function(c, a) local b = loose(c); if b then b.AssemblyLinearVelocity = b.AssemblyLinearVelocity + parseVec(a, Vector3.new(0, 0, 40)) end end)
F("spin_physics", function(c, a) local b = loose(c); if b then b.AssemblyAngularVelocity = parseVec(a, Vector3.new(0, 10, 0)) end end)
F("sink", function(c) local b = bp(c); local f = b and b:FindFirstChild("BuildXFloat"); if f then f:Destroy() end end)
F("magnet", function(c, a) c.P.magnet = num(a, 30) end)
F("repel", function(c, a) c.P.magnet = -num(a, 30) end)
F("clone_at", function(c, a) if c.P.kind == "part" then cloneThing(c.P, parseVec(a, Vector3.new(0, 20, 0))) end end)
local function spawnPart(shape, size, at)
	local p = Instance.new("Part"); p.Shape = shape; p.Size = size; p.Color = color3("random"); p.Anchored = false; p.Position = at; p.Parent = workspace
	return p
end
F("spawn_ball", function(c, a) spawnPart(Enum.PartType.Ball, Vector3.new(3, 3, 3), trim(a) ~= "" and parseVec(a, Vector3.new()) or ownerPos(c) + Vector3.new(0, 10, 0)) end)
F("spawn_block", function(c, a) spawnPart(Enum.PartType.Block, Vector3.new(4, 2, 2), trim(a) ~= "" and parseVec(a, Vector3.new()) or ownerPos(c) + Vector3.new(0, 10, 0)) end)
-- a bot from a bot with that name (in Storage or the world), or a fresh cube bot
local function makeBot(name, at, from)
	name = trim(name ~= "" and name or "Noob")
	local src
	local st = ServerStorage:FindFirstChild("Storage")
	for _, root in ipairs({st, workspace}) do
		if root and not src then for _, d in ipairs(root:GetDescendants()) do if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") and lower(d.Name) == lower(name) and not Players:GetPlayerFromCharacter(d) then src = d break end end end
	end
	local P0 = src and hOf(src) and hOf(src).P
	local m
	if src then m = (DATA._botCopies[src] or src):Clone()
	else
		m = Instance.new("Model"); m.Name = name
		local r = Instance.new("Part"); r.Name = "HumanoidRootPart"; r.Size = Vector3.new(3, 3, 3); r.Color = from and from.root and from.root.Color or Color3.fromRGB(91, 108, 255); r.Anchored = false; r.Parent = m
		local hd = Instance.new("Part"); hd.Name = "Head"; hd.Size = Vector3.new(1, 1, 1); hd.Transparency = 1; hd.CanCollide = false; hd.Massless = true; hd.Position = r.Position + Vector3.new(0, 1.5, 0); hd.Parent = m
		local w = Instance.new("WeldConstraint"); w.Part0 = r; w.Part1 = hd; w.Parent = r
		local hum = Instance.new("Humanoid"); hum.RequiresNeck = false; hum.HipHeight = 0; hum.Parent = m
		m.PrimaryPart = r
	end
	m.Parent = workspace
	m:PivotTo(CFrame.new(at))
	local P = registerThing(m, (P0 and P0.codeJSON) or (from and from.P and from.P.codeJSON) or "", "bot", true)
	return P and P.h, m
end
X.makeBot = makeBot
F("spawn_bot", function(c, a) makeBot(a, ownerPos(c) + Vector3.new(rnd(-5, 5), 3, rnd(-5, 5))) end)
F("reset", function(c) local P = c.P; local b = body(c); if not b or not P.home then return end if P.anchored0 ~= nil then b.Anchored = P.anchored0 end P.pos = P.home[1]; P.ori = P.home[2]; b.AssemblyLinearVelocity = Vector3.new(); b.AssemblyAngularVelocity = Vector3.new(); if not b.Anchored then b.CFrame = CFrame.new(P.pos) * CFrame.fromOrientation(math.rad(P.ori.X), math.rad(P.ori.Y), math.rad(P.ori.Z)) else syncPart(P) end end)
local function vforce(b, name) local f = b:FindFirstChild(name); if not f then local at = b:FindFirstChild("BXAtt") or Instance.new("Attachment"); at.Name = "BXAtt"; at.Parent = b; f = Instance.new("VectorForce"); f.Name = name; f.Attachment0 = at; f.RelativeTo = Enum.ActuatorRelativeTo.World; f.ApplyAtCenterOfMass = true; f.Parent = b end return f end
F("gravity_self", function(c, a) local b = loose(c); if b then c.P.gscale = num(a, 1) end end)
F("sleep", function(c) local b = body(c); if b then b.AssemblyLinearVelocity = Vector3.new(); b.AssemblyAngularVelocity = Vector3.new() end end)
F("stop_dead", function(c) local b = body(c); if b then b.AssemblyLinearVelocity = Vector3.new(); b.AssemblyAngularVelocity = Vector3.new() end end)
-- where a target word points: a part, a person or x,y,z
local function tpos(w, c)
	w = trim(w)
	if w:find(",") then return parseVec(w, Vector3.new()) end
	local ok, T = pcall(targets, lower(w):gsub("%s+", "_"), c)
	if ok and T and T.h and T.h[1] then return hpos(T.h[1]), T.h[1].root end
	local P = findP(w); if P and P.inst and P.inst.Parent then local i = P.inst; return (i:IsA("Model") and i:GetPivot().Position or i.Position), (i:IsA("BasePart") and i or nil) end
	return nil
end
local function att(b, name, at) local a0 = b:FindFirstChild(name) or Instance.new("Attachment"); a0.Name = name; a0.Parent = b; if at then a0.WorldPosition = at end return a0 end
local function link(c, a, cls, setup)
	local b = loose(c); if not b then return end
	local p = split(a, ":"); local pos, other = tpos(p[1] or "", c); if not pos then return end
	local a1
	if other then a1 = att(other, "BXLinkTo") else local anchor = Instance.new("Part"); anchor.Anchored = true; anchor.CanCollide = false; anchor.Transparency = 1; anchor.Size = Vector3.new(0.2, 0.2, 0.2); anchor.Position = pos; anchor.Name = "BuildXLinkPoint"; anchor.Parent = b; a1 = att(anchor, "BXLinkTo") end
	local k = Instance.new(cls); k.Name = "BuildXLink"; k.Attachment0 = att(b, "BXLinkFrom"); k.Attachment1 = a1; k.Visible = true
	setup(k, tonumber(trim(p[2] or "")), (pos - b.Position).Magnitude); k.Parent = b
end
F("rope_to", function(c, a) link(c, a, "RopeConstraint", function(k, n, d) k.Length = n or d end) end)
F("spring_to", function(c, a) link(c, a, "SpringConstraint", function(k, n, d) k.FreeLength = 0; k.Stiffness = (n or 8) * 50; k.Damping = 10; k.Coils = 6 end) end)
F("rod_to", function(c, a) link(c, a, "RodConstraint", function(k, n, d) k.Length = d end) end)
F("unlink", function(c) local b = body(c); if not b then return end for _, d in ipairs(b:GetChildren()) do if d.Name == "BuildXLink" or d.Name == "BuildXLinkPoint" or d.Name == "BXPull" then d:Destroy() end end c.P.pull = nil; c.P.homing = nil end)
F("magnet_to", function(c, a) local b = loose(c); if b then local p = split(a, ":"); c.P.pull = {w = trim(p[1] or ""), s = tonumber(trim(p[2] or "")) or 60} end end)
F("push_away_from", function(c, a) local b = loose(c); if b then local p = split(a, ":"); c.P.pull = {w = trim(p[1] or ""), s = -(tonumber(trim(p[2] or "")) or 60)} end end)
F("homing", function(c, a) local b = loose(c); if b then c.P.homing = num(a, 40) end end)
F("gravity_well", function(c, a) local p = split(a, ":"); c.P.well = {r = tonumber(trim(p[1] or "")) or 30, s = tonumber(trim(p[2] or "")) or 80} end)
F("anti_gravity_field", function(c, a) c.P.antigrav = num(a, 20) end)
F("air_drag", function(c, a) local b = loose(c); if b then c.P.drag = math.clamp(num(a, 1), 0, 5) end end)
F("max_speed", function(c, a) local b = body(c); if b then c.P.maxSpeed = num(a, 50) end end)
F("bounce_forever", function(c) local b = body(c); if b then b.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 1, 100, 100) end end)
local function onHit(c, fn) local b = body(c); if not b then return end b.Touched:Connect(function(hit) if c.P.alive ~= false and b.Parent and not hit:IsDescendantOf(b) then fn(b, hit) end end) end
F("stick_on_hit", function(c) onHit(c, function(b) if not b.Anchored then b.Anchored = true; readPart(c.P) end end) end)
F("shatter_on_hit", function(c, a) local min = num(a, 40); onHit(c, function(b) if b.AssemblyLinearVelocity.Magnitude >= min then local cc = shallow(c); CMD.crumble.fn(cc, "") end end) end)
F("explode_on_hit", function(c, a) local min = num(a, 30); onHit(c, function(b) if b.AssemblyLinearVelocity.Magnitude >= min then explodeAt(b.Position, 8); deleteP(c.P) end end) end)
local function lob(b, target, speed)
	local d = target - b.Position; local flat = Vector3.new(d.X, 0, d.Z); local t = math.max(0.4, flat.Magnitude / (speed or 50))
	b.AssemblyLinearVelocity = flat / t + Vector3.new(0, d.Y / t + 0.5 * workspace.Gravity * t, 0)
end
F("throw_at_player", function(c) local b = loose(c); local h = whoH(c); if b and h and alive(h) then lob(b, hpos(h), 50) end end)
F("launch_toward", function(c, a) local b = loose(c); if not b then return end local p = split(a, ":"); local pos = tpos(p[1] or "", c); if pos then b.AssemblyLinearVelocity = (pos - b.Position).Unit * (tonumber(trim(p[2] or "")) or 80) end end)
F("random_push", function(c, a) local b = loose(c); if b then local s = num(a, 40); local an = math.random() * math.pi * 2; b.AssemblyLinearVelocity = b.AssemblyLinearVelocity + Vector3.new(math.cos(an) * s, s * 0.4, math.sin(an) * s) end end)
F("buoyant", function(c) local b = loose(c); if b then c.P.buoyant = true end end)
table.insert(STEPS, function(dt)
	for _, P in ipairs(SCRIPTS) do
		local b = P.alive ~= false and P.kind == "part" and P.inst and P.inst.Parent and P.inst:IsA("BasePart") and P.inst or nil
		if b then
			local pos = b.Position
			if P.magnet then for _, h in ipairs(humans()) do if alive(h) then local d = pos - hpos(h); if d.Magnitude < 40 and d.Magnitude > 1 then h.root.AssemblyLinearVelocity = h.root.AssemblyLinearVelocity + d.Unit * P.magnet * dt end end end end
			if not b.Anchored then
				readPart(P)
				local m = b.AssemblyMass
				local f = Vector3.new()
				if P.gscale then f = f + Vector3.new(0, m * workspace.Gravity * (1 - P.gscale), 0) end
				if P.pull then local tp = tpos(P.pull.w, {P = P}); if tp then local d = tp - pos; if d.Magnitude > 0.5 then f = f + d.Unit * P.pull.s * m end end end
				if P.homing then local h = whoH(nil); if h and alive(h) then local want = (hpos(h) - pos).Unit * P.homing; b.AssemblyLinearVelocity = b.AssemblyLinearVelocity:Lerp(want, math.min(1, dt * 2)) end end
				if P.drag then b.AssemblyLinearVelocity = b.AssemblyLinearVelocity * math.max(0, 1 - P.drag * dt) end
				if P.maxSpeed and b.AssemblyLinearVelocity.Magnitude > P.maxSpeed then b.AssemblyLinearVelocity = b.AssemblyLinearVelocity.Unit * P.maxSpeed end
				if P.buoyant then
					for _, W in ipairs(SCRIPTS) do local wb = W.f and W.f.water and W.inst; if wb and wb:IsA("BasePart") then local l = wb.CFrame:PointToObjectSpace(pos); local s = wb.Size / 2; if math.abs(l.X) < s.X and math.abs(l.Z) < s.Z and l.Y < s.Y then f = f + Vector3.new(0, m * workspace.Gravity * 1.4, 0); b.AssemblyLinearVelocity = b.AssemblyLinearVelocity * (1 - dt) end end end
				end
				if P.gscale or P.pull or P.buoyant then vforce(b, "BXPull").Force = f end
			end
			if P.well or P.antigrav then
				local r = P.well and P.well.r or P.antigrav
				for _, Q in ipairs(SCRIPTS) do local qb = Q ~= P and Q.kind == "part" and Q.inst and Q.inst.Parent and Q.inst:IsA("BasePart") and not Q.inst.Anchored and Q.inst
					if qb then local d = pos - qb.Position; if d.Magnitude < r then
						if P.well then qb.AssemblyLinearVelocity = qb.AssemblyLinearVelocity + d.Unit * P.well.s * dt else qb.AssemblyLinearVelocity = qb.AssemblyLinearVelocity + Vector3.new(0, (workspace.Gravity + 10) * dt, 0) end
					end end
				end
			end
		end
	end
end)

-- camera, screen and weather happen on each player's own screen
for _, k in ipairs({"top_down", "side_view", "camera_follow", "camera_at", "cinematic", "no_cinematic", "camera_orbit", "camera_stop_orbit", "camera_low_angle", "camera_high_angle", "camera_level", "camera_free_angle",
	"camera_close", "camera_far", "camera_shoulder", "camera_center", "camera_look_at", "camera_stop_looking", "camera_pan_to", "camera_head_bob", "camera_no_bob", "camera_roll", "camera_unroll", "camera_breathe",
	"camera_stop_breathe", "dolly_zoom", "camera_spin_once", "camera_behind", "camera_front", "camera_isometric", "camera_birdseye"}) do
	F(k, function(c, a)
		local arg = a
		if k == "camera_follow" or k == "camera_look_at" then local pos, part = tpos(a, c); local P = findP(trim(a)); local inst = P and (P.kind == "bot" and P.h and P.h.root or P.inst) or part; arg = inst end
		send(c, "cam", k, arg)
	end)
end
for _, k in ipairs({"screen_sharp_contrast", "screen_washed_out", "screen_vivid", "screen_dim", "screen_bright", "night_vision", "thermal_vision", "dream_vision", "sunburn_vision", "frozen_vision", "screen_hue", "screen_normal",
	"screen_tilt", "screen_upside_down", "screen_mirror", "screen_straight", "vignette", "tunnel_vision", "red_damage_edges", "scanlines", "film_grain", "letterbox", "underwater_screen", "fade_from_black", "flash_screen_color", "clear_screen_effects", "tint_screen"}) do
	F(k, function(c, a) local arg = a; if k == "flash_screen_color" or k == "tint_screen" then arg = colorHex(colorArg(trim(a) ~= "" and a or (k == "tint_screen" and "orange" or "white"))) end send(c, "scr", k, arg) end)
end
local WX = {kind = nil, amt = 1, wind = 0}
local function wsend() Remote:FireAllClients("weather", WX) end
for _, k in ipairs({"weather_rain", "weather_snow", "hail", "sleet", "sandstorm", "thunderstorm", "fireflies", "falling_leaves", "cherry_blossoms", "ash_fall", "meteor_shower", "dust_motes", "blizzard", "bubbles_rising"}) do
	F(k, function(c, a) WX.kind = k; WX.amt = math.clamp(num(a, 1), 0.1, 3); wsend() end)
end
F("clear_weather", function() WX.kind = nil; WX.wind = 0; wsend() end)
F("weather_wind", function(c, a) WX.wind = math.clamp(num(a, 1), -3, 3); wsend() end)
F("weather_amount", function(c, a) WX.amt = math.clamp(num(a, 1), 0.1, 3); wsend() end)
F("aurora", function() WX.aurora = true; wsend() end)
F("no_aurora", function() WX.aurora = false; wsend() end)
F("sky_rainbow", function() WX.rainbow = true; wsend() end)
F("no_sky_rainbow", function() WX.rainbow = false; wsend() end)
F("rain_hurts", function(c, a) WX.hurt = num(a, 2) end)
F("weather_cycle", function(c, a) WX.cycle = math.max(5, TT(a, 30)); WX.cycT = WX.cycle end)
F("stop_weather_cycle", function() WX.cycle = nil end)
F("lightning_strike", function(c, a)
	local p
	if trim(a) ~= "" then p = tpos(a, c) end
	if not p then local h = whoH(nil); p = (h and alive(h) and hpos(h) or Vector3.new()) + Vector3.new(rnd(-60, 60), 0, rnd(-60, 60)) end
	CMD.lightning.fn({P = {pos = p, kind = "part"}}, "")
end)
X.weather = WX
local RP = RaycastParams.new()
table.insert(STEPS, function(dt)
	if WX.cycle then WX.cycT = WX.cycT - dt; if WX.cycT <= 0 then WX.cycT = WX.cycle; local all = {"weather_rain", "weather_snow", "thunderstorm", "falling_leaves", nil}; WX.kind = all[math.random(1, 5)]; wsend() end end
	if WX.hurt and WX.kind and (WX.kind == "weather_rain" or WX.kind == "thunderstorm" or WX.kind == "sleet" or WX.kind == "hail") then
		for _, h in ipairs(humans()) do if alive(h) then
			RP.FilterType = Enum.RaycastFilterType.Exclude; RP.FilterDescendantsInstances = {h.model}
			if not workspace:Raycast(hpos(h), Vector3.new(0, 200, 0), RP) then h.hum:TakeDamage(WX.hurt * dt) end
		end end
	end
	if WX.kind == "thunderstorm" and math.random() < dt / 6 then local h = whoH(nil); if h and alive(h) then CMD.lightning_strike.fn({}, "") end end
end)

end)()
;(function()
-- ===== game rules, saves, info, stats, items, zones, lights and a few more =====
local function TT(a, d) local t = trim(a); if t == "" then return d end return parseTime(t) or d end
local function nm(a, d) local n = tonumber(evalExpr(trim(a))); if n == nil then return d end return n end
local function key(s) return lower(trim(s)) end
local function kva2(a) a = tostring(a or ""); local i = a:find(":", 1, true); if not i then return key(a), "" end return key(a:sub(1, i - 1)), trim(a:sub(i + 1)) end
local function title(t, s) send(nil, "title", t, s or 3) end
local function toast(h, t) if h and h.player then Remote:FireClient(h.player, "toast", t) end end
local function pl() return whoH(nil) end
local function players() local o = {} for _, h in ipairs(humans()) do if h.player then table.insert(o, h) end end return o end
local function bots() local o = {} for _, b in ipairs(BOTS) do if b.model and b.model.Parent then table.insert(o, b) end end return o end
local function pick(t) return t[math.random(1, #t)] end
local GR = {}
X.rules = GR

-- rules
local function endGame(win)
	if GR.over then return end
	GR.over = true
	if win then
		if not WON then WON = true; title(GR.winMsg or "YOU WIN!", 4); sfx("win"); fireAll("on_win", nil, nil); if GR.slowWin then CMD.slow_motion.fn({}, "") end end
	else title(GR.loseMsg or "GAME OVER", 4); sfx("gameover"); fireAll("on_lose", nil, nil) end
	if GR.restartAfter then table.insert(LATER, {NOW + GR.restartAfter, function() GR.over = false; WON = false; CMD.restart.fn({}, "") end}) end
end
X.endGame = endGame
F("lives", function(c, a) GR.lives = math.max(1, math.floor(nm(a, 3) + 0.5)); for _, h in ipairs(players()) do h.lives = GR.lives end end)
F("add_life", function(c) local h = c.who or pl(); if h then h.lives = (h.lives or GR.lives or 1) + 1; toast(h, "Lives: " .. h.lives) end end)
F("time_limit", function(c, a) GR.limit = TT(a, 60); GR.limitT = GR.limit end)
F("survive_to_win", function(c, a) GR.survive = TT(a, 60); GR.surviveT = GR.survive end)
local function coinParts() local o = {} for _, P in ipairs(SCRIPTS) do if P.alive ~= false and P.kind == "part" and P.inst and P.inst.Parent and (P.collect or (P.codeJSON or ""):find('"coin"')) then table.insert(o, P) end end return o end
F("collect_all_to_win", function() GR.collectAll = true; GR.coinsAtStart = #coinParts() end)
F("defeat_all_bots_to_win", function() GR.allBots = true end)
F("score_to_win", function(c, a) GR.scoreWin = nm(a, 100) end)
F("reach_height_to_win", function(c, a) GR.heightWin = nm(a, 200) end)
F("win_message", function(c, a) GR.winMsg = trim(a) ~= "" and interp(a) or "YOU WIN!" end)
F("lose_message", function(c, a) GR.loseMsg = trim(a) ~= "" and interp(a) or "GAME OVER" end)
F("restart_after", function(c, a) GR.restartAfter = TT(a, 5) end)
F("pause_game", function() if AUDIO.ts > 0.06 then GR.prevTs = AUDIO.ts end CMD.time_scale.fn({}, "0.05"); for _, h in ipairs(humans()) do if h.root then h.root.Anchored = true end end GR.paused = true end)
F("resume_game", function() CMD.time_scale.fn({}, tostring(GR.prevTs or 1)); for _, h in ipairs(humans()) do if h.root then h.root.Anchored = false end end GR.paused = false end)
F("difficulty", function(c, a) GR.botDmg = ({easy = 0.5, normal = 1, hard = 1.6, insane = 2.5})[key(a)] or 1; send(nil, "toast", "Difficulty: " .. (trim(a) ~= "" and key(a) or "normal")) end)
F("damage_multiplier", function(c, a) GR.dmgMul = nm(a, 1) end)
F("coin_multiplier", function(c, a) GR.coinMul = nm(a, 1) end)
F("kill_reward", function(c, a) GR.killReward = nm(a, 10) end)
F("death_penalty", function(c, a) GR.deathPenalty = nm(a, 5) end)
F("friendly_bots", function() GR.friendly = true end)
F("no_respawn", function() GR.noRespawn = true; Players.CharacterAutoLoads = false end)
F("sudden_death", function() for _, h in ipairs(humans()) do if alive(h) then h.hum.Health = 1 end end title("SUDDEN DEATH", 2.5); sfx("gong") end)
F("heal_everyone", function() for _, h in ipairs(humans()) do if alive(h) then h.hum.Health = h.hum.MaxHealth end end end)
F("freeze_all_bots", function() for _, b in ipairs(bots()) do if b.root then b.root.Anchored = true end b.frozen = true end end)
F("unfreeze_all_bots", function() for _, b in ipairs(bots()) do if b.root then b.root.Anchored = false end b.frozen = false end end)
F("defeat_all_bots", function() for _, b in ipairs(bots()) do if alive(b) then b.hum.Health = 0 end end end)
F("revive_all_bots", function() for _, b in ipairs(bots()) do if b.hum and b.hum.Health <= 0 and X.reviveBot then X.reviveBot(b) end end end)
F("remove_dead_bots", function() for _, b in ipairs(bots()) do if b.hum and b.hum.Health <= 0 and b.model then b.model:Destroy() end end end)
F("max_bots", function(c, a) GR.maxBots = math.max(0, math.floor(nm(a, 20) + 0.5)) end)
F("spawn_wave", function(c, a)
	local n = math.min(30, math.floor(nm(a, 5) + 0.5)); local h = pl(); local ctr = h and alive(h) and hpos(h) or ownerPos(c)
	for i = 0, n - 1 do local an = i / n * math.pi * 2; X.makeBot("Zombie", ctr + Vector3.new(math.cos(an) * 30, 3, math.sin(an) * 30)) end
	GR.wave = (GR.wave or 0) + 1; VARS.wave = GR.wave; title("Wave " .. GR.wave, 2)
end)
F("waves", function(c, a) GR.waveEvery = math.max(5, TT(a, 20)); GR.waveT = 1 end)
F("stop_waves", function() GR.waveEvery = nil end)
F("round_time", function(c, a) GR.roundLen = math.max(5, TT(a, 60)); GR.roundT = GR.roundLen; GR.round = GR.round or 1; VARS.round = GR.round end)
F("next_round", function() GR.round = (GR.round or 1) + 1; VARS.round = GR.round; GR.roundT = GR.roundLen or 0; title("Round " .. GR.round, 2); sfx("gong"); fireAll("on_signal", "round", nil) end)
F("rounds_to_win", function(c, a) GR.roundsWin = math.floor(nm(a, 5) + 0.5) end)
F("king_of_hill_to_win", function(c, a) GR.hillWin = TT(a, 30) end)
F("tag_game", function() local B = {} for _, b in ipairs(bots()) do if alive(b) then table.insert(B, b) end end GR.it = #B > 0 and pick(B) or pl(); if GR.it then send(nil, "toast", (GR.it.name or "Someone") .. " is it!") end end)
-- saves use Roblox DataStores (turn on "Enable Studio Access to API Services" to test them in Studio)
local store
pcall(function() store = game:GetService("DataStoreService"):GetDataStore("BuildXSaves") end)
local MEM = {}
local function skey(h, k) return tostring(h and h.player and h.player.UserId or 0) .. "_" .. k end
local function sget(h, k) local K = skey(h, k); if MEM[K] ~= nil then return MEM[K] end local ok, v = pcall(function() return store and store:GetAsync(K) end); if ok and v ~= nil then MEM[K] = v end return MEM[K] end
local function sset(h, k, v) local K = skey(h, k); MEM[K] = v; task.spawn(function() pcall(function() if store then if v == nil then store:RemoveAsync(K) else store:SetAsync(K, v) end end end) end) end
local function plainVal(v) if type(v) == "table" then local o = {} for i, x in pairs(v) do o[i] = x end return o end return v end
F("save_value", function(c, a) local k = key(a); sset(c.who or pl(), "v_" .. k, plainVal(getVar(k))) end)
F("load_value", function(c, a) local k = key(a); local v = sget(c.who or pl(), "v_" .. k); if v ~= nil then if type(v) == "table" and v[1] ~= nil then v = asList(v) end VARS[k] = v end end)
F("delete_save", function(c, a) sset(c.who or pl(), "v_" .. key(a), nil) end)
F("save_high_score", function(c) local h = c.who or pl(); local b = tonumber(sget(h, "hi")) or 0; if SCORE > b then sset(h, "hi", SCORE); send(c, "toast", "New high score: " .. SCORE) end VARS.high_score = math.max(b, SCORE) end)
F("load_high_score", function(c) VARS.high_score = tonumber(sget(c.who or pl(), "hi")) or 0 end)
F("save_best_time", function(c) local h = c.who or pl(); local b = tonumber(sget(h, "bt")) or 1e9; local t = math.floor((VARS.__timer or 0) * 100 + 0.5) / 100; if t < b then sset(h, "bt", t); send(c, "toast", "New best time: " .. t .. "s") end VARS.best_time = math.min(b, t) end)
F("load_best_time", function(c) VARS.best_time = tonumber(sget(c.who or pl(), "bt")) or 0 end)
F("stage", function(c, a)
	local n = math.floor(nm(a, 1) + 0.5); VARS.stage = n
	local P = findP("stage" .. n) or findP("stage " .. n) or findP("stage_" .. n)
	local h = c.who or pl()
	if P and h and P.inst then local i = P.inst; local top = (i:IsA("BasePart") and i.Position + Vector3.new(0, i.Size.Y / 2 + 3, 0)) or i:GetPivot().Position + Vector3.new(0, 3, 0); X.moveH(h, top); h.checkpoint = top - Vector3.new(0, 3, 0) end
end)
F("next_stage", function(c) CMD.stage.fn(c, tostring((tonumber(VARS.stage) or 1) + 1)) end)
F("previous_stage", function(c) CMD.stage.fn(c, tostring(math.max(1, (tonumber(VARS.stage) or 1) - 1))) end)
F("team_points", function(c, a) local t, v = kva2(a); GR.tp = GR.tp or {}; GR.tp[t] = (GR.tp[t] or 0) + nm(v, 1); VARS["team_" .. t] = GR.tp[t]
	if GR.teamWin and GR.tp[t] >= GR.teamWin then title(string.upper(t) .. " TEAM WINS", 4); sfx("win"); fireAll("on_win", nil, nil) end end)
F("team_points_to_win", function(c, a) GR.teamWin = nm(a, 50) end)
F("shuffle_teams", function(c, a) local T = {} for s in (trim(a) ~= "" and a or "Red, Blue"):gmatch("[^,]+") do table.insert(T, trim(s)) end
	local all = humans(); for i = #all, 2, -1 do local j = math.random(1, i); all[i], all[j] = all[j], all[i] end
	for i, h in ipairs(all) do h.team = T[(i - 1) % #T + 1]; if h.player then pcall(function() local tm = game:GetService("Teams"):FindFirstChild(h.team); if tm then h.player.Team = tm end end) end end end)
F("countdown_to_start", function(c, a) local n = math.max(1, math.floor(nm(a, 3) + 0.5)); send(nil, "countdown", n)
	for _, h in ipairs(humans()) do if h.root then h.root.Anchored = true end end
	table.insert(LATER, {NOW + n, function() for _, h in ipairs(humans()) do if h.root and not h.frozen then h.root.Anchored = false end end end}) end)
F("respawn_bots_after", function(c, a) GR.botBack = TT(a, 10); for _, b in ipairs(bots()) do b.respawn = true; b.respawnT = GR.botBack end end)
F("max_coins", function(c, a) GR.maxCoins = nm(a, 999) end)
F("starting_coins", function(c, a) GR.startCoins = nm(a, 50); for _, h in ipairs(players()) do setStat(h, "coins", GR.startCoins) end end)
F("slow_mo_on_win", function() GR.slowWin = true end)
F("hide_bot_names", function() for _, b in ipairs(bots()) do if b.hum then b.hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end end end)
F("show_bot_names", function() for _, b in ipairs(bots()) do if b.hum then b.hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer end end end)
F("end_game", function() endGame(false) end)
F("team_create", function(c, a) local n, col = kva2(a); local raw = trim(split(a, ":")[1] or n)
	pcall(function() local T = game:GetService("Teams"); if not T:FindFirstChild(raw) then local t = Instance.new("Team"); t.Name = raw; t.TeamColor = BrickColor.new(color3(col ~= "" and col or "white")); t.AutoAssignable = false; t.Parent = T end end) end)
F("kills_to_win", function(c, a) GR.killsWin = nm(a, 5) end)
F("coins_to_win", function(c, a) GR.coinsWin = nm(a, 10) end)
F("intermission", function(c, a) title("Intermission", nm(a, 5)); send(nil, "countdown", nm(a, 5)) end)
F("round_start", function() title("ROUND START", 2); sfx("gong"); fireAll("on_signal", "round", nil) end)

-- damage, kills and deaths follow the rules
table.insert(HOOK.hurt, function(h, n, from)
	if from and from.kind == "bot" then
		if h.kind == "bot" and GR.friendly then return 0 end
		n = n * (GR.botDmg or 1)
		if from.bx and from.bx.knock and h.root then local d = hpos(h) - hpos(from); X.setVel(h, Vector3.new(d.X, 0, d.Z).Unit * from.bx.knock + Vector3.new(0, 25, 0)) end
	end
	n = n * (GR.dmgMul or 1)
	local S = h.st
	if S and S.def then n = n * (1 - S.def) end
	if from and from.st and from.st.str and h.kind == "bot" then n = n * from.st.str end
	return n
end)
table.insert(HOOK.kill, function(from, h)
	if from.kind == "player" and h.kind == "bot" then
		addStat(from, "kills", 1)
		if GR.killReward then addStat(from, "coins", GR.killReward) end
		if from.st and from.st.xpKill then X.giveXp(from, from.st.xpKill) elseif from.st and from.st.level then X.giveXp(from, 20) end
	end
end)
table.insert(HOOK.died, function(h)
	if h.player then
		if GR.deathPenalty then setStat(h, "coins", math.max(0, (h.stats.coins or 0) - GR.deathPenalty)) end
		if GR.lives then h.lives = (h.lives or GR.lives) - 1; VARS.lives = h.lives; if h.lives <= 0 then Players.CharacterAutoLoads = false; endGame(false) end end
	end
end)
table.insert(HOOK.char, function(h) if h.player and GR.noRespawn and h.spawnedOnce and h.stats.deaths and h.stats.deaths > 0 then end end)
local hillTime = 0
table.insert(STEPS, function(dt)
	local p = pl()
	if GR.limit then GR.limitT = GR.limitT - dt; VARS.time_left = math.max(0, math.ceil(GR.limitT)); if GR.limitT <= 0 then GR.limit = nil; endGame(false) end end
	if GR.survive and p and alive(p) then GR.surviveT = GR.surviveT - dt; VARS.survive_left = math.max(0, math.ceil(GR.surviveT)); if GR.surviveT <= 0 then GR.survive = nil; endGame(true) end end
	if GR.collectAll then local n = #coinParts(); if (GR.coinsAtStart or 0) == 0 then GR.coinsAtStart = n elseif n == 0 then endGame(true) end end
	if GR.allBots then local B = bots(); local any = false; for _, b in ipairs(B) do if alive(b) then any = true end end if #B > 0 and not any then endGame(true) end end
	if GR.scoreWin and SCORE >= GR.scoreWin then endGame(true) end
	if GR.heightWin and p and alive(p) and hpos(p).Y >= GR.heightWin then endGame(true) end
	if GR.maxBots then local B = bots(); for i = GR.maxBots + 1, #B do if B[i].model then B[i].model:Destroy() end end end
	if GR.waveEvery and not GR.over then GR.waveT = GR.waveT - dt; if GR.waveT <= 0 then GR.waveT = GR.waveEvery; CMD.spawn_wave.fn({}, tostring(2 + (GR.wave or 0) * 2)) end end
	if GR.roundLen then GR.roundT = GR.roundT - dt; VARS.round_time_left = math.max(0, math.ceil(GR.roundT)); if GR.roundT <= 0 then if GR.roundsWin and (GR.round or 1) >= GR.roundsWin then GR.roundLen = nil; endGame(true) else CMD.next_round.fn({}, "") end end end
	if GR.hillWin then VARS.hill_time = math.floor(hillTime); if hillTime >= GR.hillWin then endGame(true) end end
	for _, h in ipairs(players()) do
		if GR.maxCoins and (h.stats.coins or 0) > GR.maxCoins then setStat(h, "coins", GR.maxCoins) end
		if GR.coinMul and GR.coinMul ~= 1 then local cn = h.stats.coins or 0; if h.lastC and cn > h.lastC then setStat(h, "coins", h.lastC + (cn - h.lastC) * GR.coinMul) end h.lastC = h.stats.coins or 0 end
		if GR.killsWin and (h.stats.kills or 0) >= GR.killsWin then endGame(true) end
		if GR.coinsWin and (h.stats.coins or 0) >= GR.coinsWin then endGame(true) end
	end
	if GR.it and GR.it.kind == "bot" then GR.it.ai = {mode = "Chase"} end
end)

-- zones
local function zone(c, fn) if c.P and c.P.kind == "part" then c.P.bxz = c.P.bxz or {}; c.P.zone = true; fn(c.P.bxz) end end
F("hill", function(c, a) zone(c, function(z) z.hill = nm(a, 1) end) end)
F("capture_point", function(c, a) zone(c, function(z) z.cap = TT(a, 3); z.capT = 0 end) end)
F("points_zone", function(c, a) zone(c, function(z) z.pts = nm(a, 5) end) end)
F("coin_zone", function(c, a) zone(c, function(z) z.coins = nm(a, 1) end) end)
F("timer_start_zone", function(c) zone(c, function(z) z.tstart = true end) end)
F("timer_stop_zone", function(c) zone(c, function(z) z.tstop = true end) end)
F("magnet_floor", function(c) zone(c, function(z) z.magnet = true end) end)
F("spin_floor", function(c, a) zone(c, function(z) z.spin = nm(a, 90) end) end)
table.insert(STEPS, function(dt)
	for _, P in ipairs(SCRIPTS) do
		local z = P.bxz
		if z and P.alive ~= false and P.inst and P.inst.Parent then
			if not P.touching then computeTouching(P) end
			local on = false
			for h in pairs(P.touching or {}) do if alive(h) then
				on = true
				if z.hill and h.player then hillTime = hillTime + dt; z.acc = (z.acc or 0) + dt; if z.acc >= 1 then z.acc = z.acc - 1; SCORE = SCORE + z.hill end end
				if z.pts then z.pa = (z.pa or 0) + dt; if z.pa >= 1 then z.pa = z.pa - 1; SCORE = SCORE + z.pts; fireAll("on_score", nil, h) end end
				if z.coins and h.player then z.ca = (z.ca or 0) + dt; if z.ca >= 1 then z.ca = z.ca - 1; addStat(h, "coins", z.coins); sfx("coin", h.root) end end
				if z.tstart then VARS.__timer = 0; DATA._timerRun = true; send(nil, "timer", true) end
				if z.tstop and DATA._timerRun then DATA._timerRun = false; send(nil, "timer", false) end
				if z.magnet and h.root then local v = h.root.AssemblyLinearVelocity; if v.Y > 8 then X.setVel(h, Vector3.new(v.X, 8, v.Z)) end end
				if z.spin and h.root then h.root.CFrame = h.root.CFrame * CFrame.Angles(0, math.rad(z.spin * dt), 0) end
				if z.cap and h.team then
					if z.capTeam ~= h.team then z.capT = z.capT + dt; if z.capT >= z.cap then z.capT = 0; z.capTeam = h.team; VARS["owner_" .. lower(P.inst.Name)] = h.team; send(nil, "toast", h.team .. " took " .. P.inst.Name); pcall(function() local tm = game:GetService("Teams"):FindFirstChild(h.team); if tm then P.inst.Color = tm.TeamColor.Color end end) end end
				end
			end end
			if not on and z.cap then z.capT = 0 end
		end
	end
end)

-- items
local function itemArg(a) local p = split(a, ":"); return lower(trim(p[1] or "")), p end
H("bag_size", function(c, h, a) h.bagMax = math.max(1, math.floor(nm(a, 10) + 0.5)) end)
local function dropPickup(pos, n)
	local t = makeTool(n); if not t then return end
	local handle = t:FindFirstChild("Handle")
	if handle then t.Parent = workspace; handle.CFrame = CFrame.new(pos) else t:Destroy() end
end
H("drop_item", function(c, h, a) local n = itemArg(a); if itemCount(h, n) > 0 then takeTool(h, n, 1); dropPickup(hpos(h) + (h.root and h.root.CFrame.LookVector or Vector3.new()) * 4 + Vector3.new(0, 1.2, 0), n) end end)
H("drop_everything", function(c, h)
	local names = {}
	local function scan(w) if w then for _, t in ipairs(w:GetChildren()) do if t:IsA("Tool") then table.insert(names, t.Name) end end end end
	if h.player then scan(h.player:FindFirstChild("Backpack")) end scan(h.model)
	for i, n in ipairs(names) do takeTool(h, nrm(n), 1); local an = i * 1.2; dropPickup(hpos(h) + Vector3.new(math.cos(an) * 3, 1.2, math.sin(an) * 3), nrm(n)) end
	h.items = {}
end)
H("buy", function(c, h, a) local p = split(a, ":"); local n = lower(trim(p[1] or "")); local price = nm(p[2] or "", 0)
	if (h.stats.coins or 0) >= price then setStat(h, "coins", (h.stats.coins or 0) - price); giveTool(h, n, 1); sfx("cash"); toast(h, "Bought " .. n) else sfx("error"); toast(h, "Not enough coins") end end)
H("sell", function(c, h, a) local p = split(a, ":"); local n = lower(trim(p[1] or "")); if itemCount(h, n) > 0 then takeTool(h, n, 1); addStat(h, "coins", nm(p[2] or "", 0)); sfx("cash") end end)
H("craft", function(c, h, a)
	local p = split(a, ":"); local res = lower(trim(p[1] or "")); local cnt = {}
	for s in (p[2] or ""):gmatch("[^+]+") do local k = lower(trim(s)); if k ~= "" then cnt[k] = (cnt[k] or 0) + 1 end end
	for k, n in pairs(cnt) do if itemCount(h, k) < n then toast(h, "You need " .. n .. " " .. k); return end end
	for k, n in pairs(cnt) do takeTool(h, k, n) end
	giveTool(h, res, 1); sfx("ding"); toast(h, "Made " .. res)
end)
H("trade", function(c, h, a) local p = split(a, ":"); local g, t = lower(trim(p[1] or "")), lower(trim(p[2] or "")); if itemCount(h, g) > 0 then takeTool(h, g, 1); giveTool(h, t, 1); sfx("ding") else toast(h, "You need " .. g) end end)
local function bagList(h)
	local cnt, order = {}, {}
	local function scan(w) if w then for _, t in ipairs(w:GetChildren()) do if t:IsA("Tool") then local n = t.Name; if not cnt[n] then table.insert(order, n) end cnt[n] = (cnt[n] or 0) + 1 end end end end
	if h.player then scan(h.player:FindFirstChild("Backpack")) end scan(h.model)
	for n, k in pairs(h.items or {}) do if type(k) == "number" and k > 0 then if not cnt[n] then table.insert(order, n) end cnt[n] = (cnt[n] or 0) + k end end
	return cnt, order
end
X.bagList = bagList
H("show_bag", function(c, h) local cnt, order = bagList(h); local t = {} for _, n in ipairs(order) do table.insert(t, cnt[n] .. "x " .. n) end local s = #t > 0 and table.concat(t, ", ") or "empty"; if h.player then toast(h, "Bag: " .. s) elseif CMD.say then CMD.say.hum(c, h, s) end end)
H("steal_item", function(c, h) local _, order = bagList(h); if #order == 0 then return end local n = nrm(pick(order)); takeTool(h, n, 1); if c.P and c.P.kind == "bot" and c.P.h then c.P.h.items[n] = (c.P.h.items[n] or 0) + 1 end toast(h, "Someone took your " .. n .. "!") end)
H("pickup_range", function(c, h, a) h.reach = math.max(1, nm(a, 4)) end)
H("auto_eat", function(c, h) h.autoEat = true end)
local FOOD = {}
H("item_heals", function(c, h, a) local p = split(a, ":"); FOOD[lower(trim(p[1] or ""))] = nm(p[2] or "", 20) end)
table.insert(STEPS, function(dt)
	for _, h in ipairs(players()) do if alive(h) then
		if h.autoEat and h.hum.Health < h.hum.MaxHealth * 0.4 and (h.eatCD or 0) < NOW then
			for n, amt in pairs(FOOD) do if itemCount(h, n) > 0 then takeTool(h, n, 1); h.hum.Health = math.min(h.hum.MaxHealth, h.hum.Health + amt); h.eatCD = NOW + 1; break end end
		end
		if h.reach and h.reach > 4 then
			for _, t in ipairs(workspace:GetChildren()) do local hd = t:IsA("Tool") and t:FindFirstChild("Handle"); if hd and (hd.Position - hpos(h)).Magnitude < h.reach then if h.player then t.Parent = h.player:FindFirstChild("Backpack") end end end
		end
	end end
end)

-- stats: levels, hunger, thirst, stamina, air, warmth, mana
local function ST(h) h.st = h.st or {}; return h.st end
local function giveXp(h, n)
	local S = ST(h); S.level = S.level or 1; S.xp = (S.xp or 0) + n
	while S.xp >= S.level * 100 do S.xp = S.xp - S.level * 100; S.level = S.level + 1
		if S.lvlHp and h.hum then h.hum.MaxHealth = h.hum.MaxHealth + S.lvlHp; h.hum.Health = h.hum.MaxHealth end
		if h.player then Remote:FireClient(h.player, "title", "Level " .. S.level, 2) end sfx("levelup"); fireAll("on_signal", "level_up", h) end
	if h.player then VARS.level = S.level; VARS.xp = S.xp; setStat(h, "level", S.level) end
end
X.giveXp = giveXp
H("give_xp", function(c, h, a) giveXp(h, nm(a, 10)) end)
H("set_level", function(c, h, a) local S = ST(h); S.level = math.max(1, math.floor(nm(a, 1) + 0.5)); S.xp = 0; if h.player then VARS.level = S.level; setStat(h, "level", S.level) end end)
H("health_per_level", function(c, h, a) ST(h).lvlHp = nm(a, 10) end)
H("xp_per_kill", function(c, h, a) ST(h).xpKill = nm(a, 20) end)
H("hunger", function(c, h, a) local S = ST(h); S.hunger = 100; S.hungerT = math.max(5, TT(a, 120)) end)
H("eat", function(c, h, a) local S = ST(h); if S.hunger then S.hunger = math.min(100, S.hunger + nm(a, 30)) end sfx("pop") end)
H("thirst", function(c, h, a) local S = ST(h); S.thirst = 100; S.thirstT = math.max(5, TT(a, 90)) end)
H("drink", function(c, h, a) local S = ST(h); if S.thirst then S.thirst = math.min(100, S.thirst + nm(a, 40)) end sfx("splash") end)
H("stamina", function(c, h, a) local S = ST(h); S.stam = 100; S.stamT = math.max(1, TT(a, 6)) end)
H("restore_stamina", function(c, h) local S = ST(h); if S.stam then S.stam = 100 end end)
H("oxygen", function(c, h, a) local S = ST(h); S.air = 100; S.airT = math.max(2, TT(a, 15)) end)
H("cold", function(c, h, a) local S = ST(h); S.warm = 100; S.warmT = math.max(5, TT(a, 60)) end)
H("warm_up", function(c, h, a) local S = ST(h); if S.warm then S.warm = math.min(100, S.warm + nm(a, 50)) end end)
H("mana", function(c, h, a) local p = split(a, ":"); local S = ST(h); S.manaMax = nm(p[1] or "", 100); S.mana = S.manaMax; S.manaRegen = nm(p[2] or "", 5) end)
H("use_mana", function(c, h, a) local S = ST(h); local k = nm(a, 10); if (S.mana or 0) >= k then S.mana = S.mana - k; fireAll("on_signal", "mana_used", h) else fireAll("on_signal", "no_mana", h); toast(h, "Not enough mana") end end)
H("strength", function(c, h, a) ST(h).str = math.max(0, nm(a, 1)) end)
H("defense", function(c, h, a) ST(h).def = math.min(0.95, math.max(0, nm(a, 0.3))) end)
local function inWater(h) for _, P in ipairs(SCRIPTS) do if P.f and P.f.water and P.touching and P.touching[h] then return true end end return h.hum and h.hum:GetState() == Enum.HumanoidStateType.Swimming end
local function nearLight(h) for _, d in ipairs(workspace:GetDescendants()) do if (d:IsA("PointLight") or d:IsA("Fire")) and d.Parent and d.Parent:IsA("BasePart") and (d.Parent.Position - hpos(h)).Magnitude < 15 then return true end end return false end
local warmCheck = 0
table.insert(STEPS, function(dt)
	warmCheck = warmCheck - dt
	local doWarm = warmCheck <= 0; if doWarm then warmCheck = 0.5 end
	for _, h in ipairs(humans()) do local S = h.st; if S and alive(h) then
		if S.hunger then S.hunger = math.max(0, S.hunger - 100 / S.hungerT * dt); if S.hunger <= 0 then h.hum:TakeDamage(2 * dt) end end
		if S.thirst then S.thirst = math.max(0, S.thirst - 100 / S.thirstT * dt); if S.thirst <= 0 then h.hum:TakeDamage(3 * dt) end end
		if S.stam then
			local running = h.hum.MoveDirection.Magnitude > 0.1
			if running then S.stam = math.max(0, S.stam - 100 / S.stamT * dt) else S.stam = math.min(100, S.stam + 25 * dt) end
			if S.stam <= 0 and not S.tired then S.tired = h.hum.WalkSpeed; h.hum.WalkSpeed = S.tired * 0.45 elseif S.tired and S.stam > 30 then h.hum.WalkSpeed = S.tired; S.tired = nil end
		end
		if S.air then if inWater(h) then S.air = math.max(0, S.air - 100 / S.airT * dt); if S.air <= 0 then h.hum:TakeDamage(10 * dt) end else S.air = math.min(100, S.air + 40 * dt) end end
		if S.warm and doWarm then S.warmNear = nearLight(h) end
		if S.warm then if S.warmNear then S.warm = math.min(100, S.warm + 20 * dt) else S.warm = math.max(0, S.warm - 100 / S.warmT * dt); if S.warm <= 0 then h.hum:TakeDamage(2 * dt) end end end
		if S.manaMax then S.mana = math.min(S.manaMax, (S.mana or 0) + (S.manaRegen or 0) * dt) end
		if h.player then
			if S.hunger then VARS.hunger = math.floor(S.hunger) end if S.thirst then VARS.thirst = math.floor(S.thirst) end
			if S.stam then VARS.stamina = math.floor(S.stam) end if S.air then VARS.oxygen = math.floor(S.air) end
			if S.warm then VARS.warmth = math.floor(S.warm) end if S.manaMax then VARS.mana = math.floor(S.mana) end
		end
	end end
end)

-- light effects
local function lightOf(c) local b = bp(c); if not b then return nil end local l = b:FindFirstChild("BuildXLight"); if not l then l = Instance.new("PointLight"); l.Name = "BuildXLight"; l.Range = 20; l.Brightness = 2; l.Color = b.Color; l.Parent = b end return l, b end
local LFX = {}
local function lfx(c, kind, arg) local l = lightOf(c); if not l then return end LFX[l] = {kind = kind, arg = arg, base = l.Brightness > 0 and l.Brightness or 2, col = l.Color, t = 0, c = c} end
F("light_range", function(c, a) local l = lightOf(c); if l then l.Range = math.clamp(num(a, 20), 0, 60) end end)
F("light_off", function(c) local l = lightOf(c); if l then l.Enabled = false end end)
F("light_on", function(c) local l = lightOf(c); if l then l.Enabled = true end end)
for _, k in ipairs({"candle_flicker", "strobe_light", "police_lights", "disco_light", "breathing_light", "broken_light", "light_when_dark", "light_when_near"}) do F(k, function(c, a) lfx(c, k, a) end) end
F("steady_light", function(c) local l = lightOf(c); if l and LFX[l] then l.Brightness = LFX[l].base; l.Color = LFX[l].col; l.Enabled = true; LFX[l] = nil end end)
table.insert(STEPS, function(dt)
	for l, f in pairs(LFX) do
		if not l.Parent then LFX[l] = nil else
			f.t = f.t + dt; local t = f.t
			if f.kind == "candle_flicker" then l.Brightness = f.base * (0.75 + math.random() * 0.35)
			elseif f.kind == "strobe_light" then local hz = tonumber(f.arg) or 8; l.Enabled = math.floor(t * hz * 2) % 2 == 0
			elseif f.kind == "police_lights" then l.Color = math.floor(t * 3) % 2 == 0 and Color3.fromRGB(255, 30, 30) or Color3.fromRGB(30, 60, 255)
			elseif f.kind == "disco_light" then l.Color = Color3.fromHSV((t * 0.3) % 1, 1, 1)
			elseif f.kind == "breathing_light" then l.Brightness = f.base * (0.55 + 0.45 * math.sin(t * 1.5))
			elseif f.kind == "broken_light" then if math.random() < dt * 1.5 then f.off = t + 0.1 + math.random() * 0.4 end l.Enabled = not (f.off and t < f.off)
			elseif f.kind == "light_when_dark" then local ct = Lighting.ClockTime; l.Enabled = ct < 6.3 or ct > 17.7
			elseif f.kind == "light_when_near" then local h = pl(); local b = l.Parent; l.Enabled = h and alive(h) and (hpos(h) - b.Position).Magnitude < (tonumber(f.arg) or 15) or false end
		end
	end
end)

-- look
local SHAPES = {block = "Block", ball = "Ball", cylinder = "Cylinder", wedge = "Wedge", cornerwedge = "CornerWedge", cone = "Cone", truss = "Truss"}
local function reshape(c, sh)
	local b = bp(c); if not b or c.P.kind ~= "part" then return end
	local cls = ({Wedge = "WedgePart", CornerWedge = "CornerWedgePart", Truss = "TrussPart"})[sh] or "Part"
	if b.ClassName == cls and cls == "Part" then if sh == "Cone" then local m = b:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh"); m.MeshType = Enum.MeshType.FileMesh; m.MeshId = "rbxasset://fonts/cone.mesh"; m.Scale = b.Size; m.Parent = b else local m = b:FindFirstChildOfClass("SpecialMesh"); if m then m:Destroy() end b.Shape = Enum.PartType[sh] end return end
	local n = Instance.new(cls)
	for _, k in ipairs({"Name", "Size", "CFrame", "Color", "Material", "Transparency", "Anchored", "CanCollide", "CanTouch", "Reflectance", "CastShadow"}) do pcall(function() n[k] = b[k] end) end
	for _, ch in ipairs(b:GetChildren()) do if not ch:IsA("SpecialMesh") then ch.Parent = n end end
	if cls == "Part" then if sh == "Cone" then local m = Instance.new("SpecialMesh"); m.MeshType = Enum.MeshType.FileMesh; m.MeshId = "rbxasset://fonts/cone.mesh"; m.Scale = b.Size; m.Parent = n else n.Shape = Enum.PartType[sh] end end
	n.Parent = b.Parent; b:Destroy(); c.P.inst = n
end
F("shape", function(c, a) local sh = SHAPES[lower(a):gsub("%s", "")]; if sh then reshape(c, sh) end end)
for k, sh in pairs(SHAPES) do if k ~= "truss" then F(k, function(c) reshape(c, sh) end) end end
F("flash", function(c) local b = bp(c); if not b then return end local old = b.Color; b.Color = Color3.new(1, 1, 1); table.insert(LATER, {NOW + 0.3, function() if b.Parent then b.Color = old end end}) end)
F("size_wall", function(c) local b = bp(c); if b then b.Size = Vector3.new(20, 12, 1) end end)
F("size_floor", function(c) local b = bp(c); if b then b.Size = Vector3.new(30, 1, 30) end end)
F("size_pillar", function(c) local b = bp(c); if b then b.Size = Vector3.new(2, 20, 2) end end)
F("invert", function(c) eachPart(c, function(p) p:SetAttribute("bxInvT", p:GetAttribute("bxInvT") or p.Transparency); p.Transparency = 0.85; p.Material = Enum.Material.ForceField end) end)
F("invert_color", function(c) local function inv(col) return Color3.new(1 - col.R, 1 - col.G, 1 - col.B) end if c.P and c.P.kind == "bot" and c.P.h.root then c.P.h.root.Color = inv(c.P.h.root.Color) else eachPart(c, function(p) p.Color = inv(p.Color) end) end end)
F("uninvert", function(c) eachPart(c, function(p) local t = p:GetAttribute("bxInvT"); if t then p.Transparency = t; p.Material = Enum.Material.SmoothPlastic; p:SetAttribute("bxInvT", nil) end end) end)
H("shirt", function(c, h, a) local col = color3(colorArg(a)); if h.model then local s = h.model:FindFirstChildOfClass("BodyColors"); if s then s.TorsoColor3 = col end for _, n in ipairs({"Torso", "UpperTorso", "LowerTorso", "Left Arm", "Right Arm", "LeftUpperArm", "RightUpperArm"}) do local p = h.model:FindFirstChild(n); if p then p.Color = col end end if h.kind == "bot" and h.root then h.root.Color = col end end end)
H("pants", function(c, h, a) local col = color3(colorArg(a)); if h.model then local s = h.model:FindFirstChildOfClass("BodyColors"); if s then s.LeftLegColor3 = col; s.RightLegColor3 = col end for _, n in ipairs({"Left Leg", "Right Leg", "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg"}) do local p = h.model:FindFirstChild(n); if p then p.Color = col end end end end)

-- useful
F("portal", function(c, a)
	local b = bp(c); if not b then return end
	local cam = DATA.cameras and DATA.cameras[nrm(trim(a) ~= "" and a or "Camera")]
	local sg = b:FindFirstChild("BuildXPortal") or Instance.new("SurfaceGui"); sg.Name = "BuildXPortal"; sg.Face = Enum.NormalId.Front; sg.Parent = b
	local vf = sg:FindFirstChild("View") or Instance.new("ViewportFrame"); vf.Name = "View"; vf.Size = UDim2.new(1, 0, 1, 0); vf.BackgroundColor3 = Color3.fromRGB(150, 190, 230); vf.Parent = sg
	local vc = vf:FindFirstChildOfClass("Camera") or Instance.new("Camera"); vc.Parent = vf; vf.CurrentCamera = vc
	if cam then vc.CFrame = CFrame.new(unpack(cam)) end
	-- a ViewportFrame only shows copies, so copy the still parts around the camera once
	for _, d in ipairs(vf:GetChildren()) do if d:IsA("BasePart") or d:IsA("Model") then d:Destroy() end end
	local n = 0
	for _, d in ipairs(workspace:GetDescendants()) do if n > 400 then break end if d:IsA("BasePart") and d ~= b and d.Anchored and not d:FindFirstAncestorOfClass("Model") and (not cam or (d.Position - Vector3.new(cam[1], cam[2], cam[3])).Magnitude < 250) then local k = d:Clone(); for _, ch in ipairs(k:GetChildren()) do if not ch:IsA("DataModelMesh") and not ch:IsA("Decal") and not ch:IsA("Texture") then ch:Destroy() end end k.Parent = vf; n = n + 1 end end
end)
F("portal_off", function(c) local b = bp(c); local g = b and b:FindFirstChild("BuildXPortal"); if g then g:Destroy() end end)
F("control", function(c, a)
	if inSet(lower(trim(a)), "off", "stop", "none") then CMD.release.fn(c, "") return end
	local h = c.who or pl(); if not h or not h.player then return end
	local i = c.P and c.P.inst; if not i then return end
	local main = i:IsA("Model") and (i.PrimaryPart or i:FindFirstChildWhichIsA("BasePart", true)) or i
	for _, d in ipairs((i:IsA("Model") and i or main):GetDescendants()) do if d:IsA("BasePart") and d ~= main then local w = Instance.new("WeldConstraint"); w.Part0 = main; w.Part1 = d; w.Parent = d; d.Anchored = false end end
	main.Anchored = false
	pcall(function() main:SetNetworkOwner(h.player) end)
	Remote:FireClient(h.player, "control", main, tonumber(a) or 0)
end)
F("release", function(c) local h = c.who or pl(); if h and h.player then Remote:FireClient(h.player, "control", nil) end end)

-- variables
F("clamp", function(c, a) local k, r = kva2(a); local p = split(r, ","); local lo, hi = nm(p[1] or "", 0), nm(p[2] or "", 100); local v = tonumber(getVar(k)) or 0; VARS[k] = math.min(hi, math.max(lo, v)) end)
F("concat", function(c, a) local k, r = kva2(a); VARS[k] = TS(getVar(k) or "") .. interp(r) end)

-- info: things only a player's computer knows are sent here every half second
local INFO = {}
Remote.OnServerEvent:Connect(function(p, kind, t) if kind == "info" and type(t) == "table" then INFO[p] = t end end)
local function IN(h, k, d) local t = h and h.player and INFO[h.player]; if t and t[k] ~= nil then return t[k] end return d end
local DAYS = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"}
local MONTHS = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
local function dt0() return os.date("*t") end
local function nearestBot(h) local best, bd = nil, math.huge; for _, b in ipairs(bots()) do if alive(b) and b ~= h then local d = (hpos(b) - hpos(h)).Magnitude; if d < bd then bd = d; best = b end end end return best, bd end
local function partsNamed(n) n = lower(n); local o = {} for _, d in ipairs(workspace:GetDescendants()) do if d:IsA("BasePart") and lower(d.Name):find(n, 1, true) and not Players:GetPlayerFromCharacter(d.Parent) then table.insert(o, d) end end return o end
local function partBy(n) local P = findP(n); if P and P.inst and P.inst.Parent then local i = P.inst; return i:IsA("BasePart") and i or (i:IsA("Model") and (i.PrimaryPart or i:FindFirstChildWhichIsA("BasePart", true))) or nil end local l = partsNamed(n); return l[1] end
local function posOf(n) local P = findP(n); if P and P.kind == "bot" and P.h then return hpos(P.h) end local b = partBy(n); return b and b.Position end
local SHAPE_NAME = function(b) if b:IsA("WedgePart") then return "Wedge" elseif b:IsA("CornerWedgePart") then return "CornerWedge" elseif b:IsA("TrussPart") then return "Truss" elseif b:IsA("Part") then return b.Shape and b.Shape.Name or "Block" end return b.ClassName end
local INFOF = {
	get_hour = function() return dt0().hour end, get_minute = function() return dt0().min end, get_second = function() return dt0().sec end,
	get_day = function() return dt0().day end, get_month = function() return dt0().month end, get_year = function() return dt0().year end,
	get_weekday = function() return DAYS[dt0().wday] end, get_month_name = function() return MONTHS[dt0().month] end,
	get_date = function() local t = dt0(); return DAYS[t.wday] .. " " .. t.day .. " " .. MONTHS[t.month] .. " " .. t.year end,
	get_clock = function() local t = dt0(); return string.format("%02d:%02d", t.hour, t.min) end,
	get_timestamp = function() return os.time() end, get_game_time = function() return math.floor(NOW * 10 + 0.5) / 10 end,
	get_world_time = function() return math.floor(Lighting.ClockTime * 100 + 0.5) / 100 end, get_gravity = function() return workspace.Gravity end,
	get_time_scale = function() return AUDIO.ts end, get_fps = function(h) return IN(h, "fps", 60) end,
	get_screen_width = function(h) return IN(h, "w", 1920) end, get_screen_height = function(h) return IN(h, "h", 1080) end,
	is_phone = function(h) return IN(h, "phone", 0) end, is_landscape = function(h) return IN(h, "w", 16) >= IN(h, "h", 9) and 1 or 0 end,
	get_bots_alive = function() local k = 0 for _, b in ipairs(bots()) do if alive(b) then k = k + 1 end end return k end, get_bots_total = function() return #bots() end,
	get_parts_count = function() local k = 0 for _, d in ipairs(workspace:GetDescendants()) do if d:IsA("BasePart") then k = k + 1 end end return k end,
	count_parts_named = function(h, r) return #partsNamed(trim(r)) end, get_coins_left = function() return #coinParts() end,
	get_player_speed = function(h) if not alive(h) then return 0 end local v = h.root.AssemblyLinearVelocity; return math.floor(Vector3.new(v.X, 0, v.Z).Magnitude * 10 + 0.5) / 10 end,
	get_fall_speed = function(h) if not alive(h) then return 0 end return math.floor(-h.root.AssemblyLinearVelocity.Y * 10 + 0.5) / 10 end,
	get_height_above_ground = function(h) if not alive(h) then return 0 end local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances = {h.model}; local r = workspace:Raycast(hpos(h), Vector3.new(0, -500, 0), rp); return r and math.floor((hpos(h).Y - r.Position.Y - 3) * 10 + 0.5) / 10 or 500 end,
	is_on_ground = function(h) return alive(h) and h.hum.FloorMaterial ~= Enum.Material.Air and 1 or 0 end,
	is_moving = function(h) return alive(h) and h.hum.MoveDirection.Magnitude > 0.1 and 1 or 0 end,
	get_facing = function(h) if not alive(h) then return 0 end local l = h.root.CFrame.LookVector; return math.floor((math.deg(math.atan2(-l.X, -l.Z)) % 360) + 0.5) end,
	get_compass = function(h) if not alive(h) then return "N" end local l = h.root.CFrame.LookVector; local d = (math.deg(math.atan2(l.X, -l.Z)) + 360) % 360; return ({"N", "NE", "E", "SE", "S", "SW", "W", "NW"})[math.floor((d + 22.5) / 45) % 8 + 1] end,
	get_health_percent = function(h) if not alive(h) then return 0 end return math.floor(h.hum.Health / h.hum.MaxHealth * 100 + 0.5) end,
	get_lives = function(h) return h and h.lives or GR.lives or 0 end,
	get_held_item = function(h) local t = h and h.model and h.model:FindFirstChildOfClass("Tool"); return t and t.Name or "" end,
	get_bag_count = function(h) if not h then return 0 end local cnt = bagList(h); local k = 0 for _, n in pairs(cnt) do k = k + n end return k end,
	get_bag_list = function(h) if not h then return newList() end local _, order = bagList(h); return asList(order) end,
	get_nearest_bot = function(h) local b = h and nearestBot(h); return b and b.name or "" end,
	get_nearest_bot_distance = function(h) local b, d = nil, 0; if h then b, d = nearestBot(h) end return b and math.floor(d * 10 + 0.5) / 10 or 0 end,
	get_nearest_part = function(h, r) local best, bd = nil, math.huge; for _, p in ipairs(partsNamed(trim(r))) do local d = (p.Position - hpos(h)).Magnitude; if d < bd then bd = d; best = p end end return best and best.Name or "" end,
	get_distance_to = function(h, r) local p = posOf(trim(r)); return p and h and math.floor((p - hpos(h)).Magnitude * 10 + 0.5) / 10 or 0 end,
	get_distance_between = function(h, r) local p = split(r, ","); local A1, B1 = posOf(trim(p[1] or "")), posOf(trim(p[2] or "")); return A1 and B1 and math.floor((A1 - B1).Magnitude * 10 + 0.5) / 10 or 0 end,
	get_direction_to = function(h, r) local p = posOf(trim(r)); if not p or not h then return 0 end local d = p - hpos(h); return math.floor((math.deg(math.atan2(d.X, -d.Z)) + 360) % 360 + 0.5) end,
	get_camera_zoom = function(h) return IN(h, "zoom", 12) end, get_camera_angle = function(h) return IN(h, "cyaw", 0) end, get_camera_tilt = function(h) return IN(h, "cpitch", 0) end,
	get_input_x = function(h) return IN(h, "ix", 0) end, get_input_y = function(h) return IN(h, "iy", 0) end,
	is_key_down = function(h, r) return h and h.keys and h.keys[lower(trim(r))] and 1 or 0 end,
	get_touching = function(h) if not alive(h) then return "" end local fl = nil; local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances = {h.model}; local r = workspace:Raycast(hpos(h), Vector3.new(0, -4, 0), rp); if r then return r.Instance.Name end for _, P in ipairs(SCRIPTS) do if P.touching and P.touching[h] and P.inst then return P.inst.Name end end return "" end,
	get_touching_count = function(h) if not alive(h) then return 0 end local k = 0 for _, P in ipairs(SCRIPTS) do if P.touching and P.touching[h] then k = k + 1 end end return k end,
	get_killer = function(h) local b = h and h.lastHurtBy; return b and b.name or "" end,
	get_it = function() return GR.it and GR.it.name or "" end, get_round = function() return GR.round or 0 end, get_wave = function() return GR.wave or 0 end,
	get_weather = function() local k = X.weather and X.weather.kind; return k and k:gsub("^weather_", "") or "clear" end,
	get_team_points = function(h, r) return GR.tp and GR.tp[key(r)] or 0 end, get_hill_time = function() return math.floor(hillTime) end,
	get_owner = function(h, r) local P = findP(trim(r)); return P and P.bxz and P.bxz.capTeam or "" end,
	get_part_color = function(h, r) local b = partBy(trim(r)); if not b then return "" end local c3 = b.Color; return string.format("#%02x%02x%02x", math.floor(c3.R * 255 + 0.5), math.floor(c3.G * 255 + 0.5), math.floor(c3.B * 255 + 0.5)) end,
	get_part_material = function(h, r) local b = partBy(trim(r)); return b and b.Material.Name or "" end,
	get_part_shape = function(h, r) local b = partBy(trim(r)); return b and SHAPE_NAME(b) or "" end,
	get_part_transparency = function(h, r) local b = partBy(trim(r)); return b and b.Transparency or 0 end,
	get_part_volume = function(h, r) local b = partBy(trim(r)); return b and math.floor(b.Size.X * b.Size.Y * b.Size.Z * 100 + 0.5) / 100 or 0 end,
	get_part_speed = function(h, r) local b = partBy(trim(r)); return b and math.floor(b.AssemblyLinearVelocity.Magnitude * 10 + 0.5) / 10 or 0 end,
	get_part_top = function(h, r) local b = partBy(trim(r)); return b and math.floor((b.Position.Y + b.Size.Y / 2) * 100 + 0.5) / 100 or 0 end,
	get_part_rotation = function(h, r) local b = partBy(trim(r)); if not b then return 0 end local _, y = b.CFrame:ToOrientation(); return math.floor(math.deg(y) + 0.5) end,
	is_part_alive = function(h, r) return partBy(trim(r)) and 1 or 0 end, is_anchored = function(h, r) local b = partBy(trim(r)); return b and b.Anchored and 1 or 0 end,
	get_random_bot = function() local B = {} for _, b in ipairs(bots()) do if alive(b) then table.insert(B, b) end end return #B > 0 and pick(B).name or "" end,
	get_random_part = function() local o = {} for _, d in ipairs(workspace:GetChildren()) do if d:IsA("BasePart") and d.Name ~= "Terrain" then table.insert(o, d) end end return #o > 0 and pick(o).Name or "" end,
	get_player_name = function(h) return h and h.name or "" end, get_language = function(h) return IN(h, "lang", "en") end,
	is_dark_mode = function(h) return IN(h, "dark", 0) end, get_battery = function() return -1 end,
}
for k, f in pairs(INFOF) do F(k, function(c, a) local v, r = kva2(a); if v ~= "" then VARS[v] = f(c.who or pl(), r) end end) end

end)()
;(function()
-- ===== bots: more brains and extra powers =====
local function TT(a, d) local t = trim(a); if t == "" then return d end return parseTime(t) or d end
local function nm(a, d) local n = tonumber(evalExpr(trim(a))); if n == nil then return d end return n end
local function rnd(a, b) return a + math.random() * (b - a) end
local function flat(v) return Vector3.new(v.X, 0, v.Z) end
local function players() local o = {} for _, h in ipairs(humans()) do if h.player and alive(h) then table.insert(o, h) end end return o end
local function nearestPlayer(b) local best, bd = nil, math.huge for _, h in ipairs(players()) do local d = (hpos(h) - hpos(b)).Magnitude; if d < bd then bd = d; best = h end end return best, bd end
local function liveBots() local o = {} for _, x in ipairs(BOTS) do if alive(x) then table.insert(o, x) end end return o end
local function sayB(b, t) if CMD.say then pcall(CMD.say.hum, {P = b.P}, b, t) end end
local function lines(a) local o = {} for s in tostring(a):gmatch("[^,]+") do if trim(s) ~= "" then table.insert(o, trim(s)) end end return o end
local function partPos(n) local P = findP(trim(n)); if P and P.inst and P.inst.Parent then local i = P.inst; return i:IsA("Model") and i:GetPivot().Position or i.Position, i end return nil end
local function X2(b) b.bx = b.bx or {}; return b.bx end
local function face(b, p) if b.root then local q = b.root.Position; local d = flat(p - q); if d.Magnitude > 0.01 then b.root.CFrame = CFrame.lookAt(q, q + d) end end end

-- brains
local BRAIN = {}
local function M(name, setup) BRAIN[name] = true; H(name, function(c, b, a)
	if b.kind ~= "bot" then return end
	local A = X2(b); A.mode = name; A.ph = 0; A.t = 0; A.goal = nil; A.awake = false; A.i = 1; A.arg = a
	if setup then setup(A, a, b, c) end
	b.ai = {mode = "BX"}
end, true) end
M("kite", function(A, a) A.r = nm(a, 18) end)
M("ambush", function(A, a) A.r = nm(a, 14) end)
M("strafe", function(A, a) A.r = nm(a, 12) end)
M("herd"); M("swarm")
M("sentry", function(A, a) A.r = nm(a, 30) end)
M("roam", function(A, a) A.r = nm(a, 120) end)
M("go_home"); M("hide"); M("zigzag_chase"); M("hop_chase"); M("shy"); M("bot_dance"); M("mirror_player"); M("chase_bots")
M("protect", function(A, a) A.who = trim(a) ~= "" and trim(a) or "player_main" end)
M("orbit_part_bot", function(A, a) A.part = trim(a) end)
M("walk_path", function(A, a) A.list = lines(a) end)
M("walk_path_once", function(A, a) A.list = lines(a); A.once = true end)
M("run_far"); M("jumpy"); M("pace"); M("lead"); M("chase_weakest"); M("chase_farthest"); M("scatter"); M("line_up"); M("crowd_player")
M("wander_in", function(A, a) A.part = trim(a) end)
M("revenge"); M("coward", function(A, a) A.frac = nm(a, 0.3) end)
M("spin_bot", function(A, a) A.rate = nm(a, 180) end)
M("moonwalk")
M("seek_part", function(A, a) A.name = lower(trim(a)) end)
M("avoid_part", function(A, a) local p = split(a, ":"); A.name = lower(trim(p[1] or "")); A.r = nm(p[2] or "", 15) end)
M("play_tag"); M("wander_waypoints", function(A, a) A.list = lines(a) end)
M("keep_distance", function(A, a) A.r = nm(a, 10) end)
M("follow_trail", function(A) A.trail = {} end)
M("charge"); M("random_walk")
M("guard_return", function(A, a) A.r = nm(a, 15) end)
H("brain_off", function(c, b) if b.bx then b.bx.mode = nil end b.ai = {mode = "Idle"} end, true)
H("patrol_bot", function(c, b, a) if b.kind ~= "bot" then return end local v = trim(a):find(",") and parseVec(a, Vector3.new(20, 0, 0)) or Vector3.new(nm(a, 20), 0, 0); b.ai = {mode = "Patrol", d = v, home = hpos(b)} end, true)
H("circle", function(c, b, a) if b.kind ~= "bot" then return end X2(b).mode = "circle"; b.bx.r = nm(a, 10); b.bx.t = 0; b.ai = {mode = "BX"} end, true)
H("copy_player", function(c, b) if b.kind ~= "bot" then return end X2(b).mode = "copy"; b.ai = {mode = "BX"} end, true)
H("respawn_off", function(c, b) b.respawn = false end, true)
H("respawn_on", function(c, b) b.respawn = true end, true)

local function goTo(b, p) if p then b.hum:MoveTo(p) end end
local function away(b, from, dist) local d = flat(hpos(b) - from); if d.Magnitude < 0.01 then d = Vector3.new(1, 0, 0) end return hpos(b) + d.Unit * (dist or 14) end
local function think(b, A, dt)
	local m = A.mode
	local me = hpos(b)
	local p, pd = nearestPlayer(b)
	local pp = p and hpos(p)
	local home = b.home or me
	A.t = A.t + dt
	if m == "kite" then if pp then if pd < A.r then goTo(b, away(b, pp)) elseif pd > A.r + 6 then goTo(b, pp) else b.hum:MoveTo(me) end end
	elseif m == "ambush" then if pp and pd < A.r then A.awake = true end if A.awake and pp then goTo(b, pp) end
	elseif m == "strafe" then if pp then local an = A.t * 1.2; goTo(b, pp + Vector3.new(math.cos(an) * A.r, 0, math.sin(an) * A.r)) end
	elseif m == "herd" then local s, n = Vector3.new(), 0 for _, o in ipairs(liveBots()) do if o ~= b and o.bx and o.bx.mode == "herd" then s = s + hpos(o); n = n + 1 end end if n > 0 then goTo(b, s / n + Vector3.new(rnd(-4, 4), 0, rnd(-4, 4))) elseif math.random() < 0.2 then goTo(b, home + Vector3.new(rnd(-15, 15), 0, rnd(-15, 15))) end
	elseif m == "swarm" then if pp then local mine, idx, n = nil, 0, 0 for _, o in ipairs(liveBots()) do if o.bx and o.bx.mode == "swarm" then n = n + 1; if o == b then idx = n end end end local an = idx / math.max(1, n) * math.pi * 2 + A.t * 0.3; goTo(b, pp + Vector3.new(math.cos(an) * 5, 0, math.sin(an) * 5)) end
	elseif m == "sentry" then b.hum:MoveTo(home); if pp and pd < A.r then face(b, pp) end
	elseif m == "roam" then if not A.goal or (flat(A.goal - me)).Magnitude < 4 or A.t > 12 then A.t = 0; A.goal = home + Vector3.new(rnd(-A.r, A.r), 0, rnd(-A.r, A.r)) end goTo(b, A.goal)
	elseif m == "go_home" then goTo(b, home)
	elseif m == "hide" then if pp then local best, bd = nil, math.huge for _, d in ipairs(workspace:GetChildren()) do if d:IsA("BasePart") and d.Size.Y > 5 and math.max(d.Size.X, d.Size.Z) > 4 then local dd = (d.Position - me).Magnitude; if dd < bd and dd < 80 then bd = dd; best = d end end end
		if best then local dir = flat(best.Position - pp); if dir.Magnitude > 0 then goTo(b, best.Position + dir.Unit * (math.max(best.Size.X, best.Size.Z) / 2 + 3)) end else goTo(b, away(b, pp)) end end
	elseif m == "zigzag_chase" then if pp then local d = flat(pp - me); local side = Vector3.new(-d.Z, 0, d.X); if side.Magnitude > 0 then side = side.Unit end goTo(b, pp + side * math.sin(A.t * 3) * 8) end
	elseif m == "hop_chase" then if pp then goTo(b, pp) end A.ph = A.ph + dt; if A.ph > 1 then A.ph = 0; b.hum.Jump = true end
	elseif m == "shy" then if pp then local pv = p.root.AssemblyLinearVelocity; local toB = flat(me - pp); if toB.Magnitude > 0 and flat(pv):Dot(toB.Unit) > 5 then goTo(b, away(b, pp, 10)) elseif pd > 6 then goTo(b, pp) else b.hum:MoveTo(me) end end
	elseif m == "bot_dance" then b.hum:MoveTo(me); if b.root then b.hum.AutoRotate = false; b.root.CFrame = b.root.CFrame * CFrame.Angles(0, math.rad(240 * dt), 0) end A.ph = A.ph + dt; if A.ph > 0.9 then A.ph = 0; b.hum.Jump = true end
	elseif m == "mirror_player" then if pp then goTo(b, Vector3.new(2 * home.X - pp.X, me.Y, 2 * home.Z - pp.Z)) end
	elseif m == "chase_bots" then local best, bd = nil, math.huge for _, o in ipairs(liveBots()) do if o ~= b then local d = (hpos(o) - me).Magnitude; if d < bd then bd = d; best = o end end end if best then goTo(b, hpos(best)) end
	elseif m == "protect" then local ok, T = pcall(targets, lower(A.who):gsub("%s+", "_"), {P = b.P}); local w = ok and T and T.h and T.h[1]; if w and alive(w) then local wp = hpos(w); local foe
			for _, o in ipairs(liveBots()) do if o ~= b and o ~= w and (not b.team or o.team ~= b.team) and not (o.bx and o.bx.mode == "protect") and (hpos(o) - wp).Magnitude < 15 then foe = o break end end
			if foe then goTo(b, hpos(foe)); b.attack = b.attack or 10 elseif (me - wp).Magnitude > 6 then goTo(b, wp) else b.hum:MoveTo(me) end end
	elseif m == "orbit_part_bot" then local c0 = partPos(A.part) or home; local an = A.t * 0.5; goTo(b, c0 + Vector3.new(math.cos(an) * 8, 0, math.sin(an) * 8))
	elseif m == "walk_path" or m == "walk_path_once" or m == "wander_waypoints" then local L = A.list or {}; if #L > 0 then local g = partPos(L[A.i]); if not g then A.i = A.i % #L + 1 elseif flat(g - me).Magnitude < 3 then
			if m == "wander_waypoints" then A.i = math.random(1, #L) elseif A.i < #L then A.i = A.i + 1 elseif not A.once then A.i = 1 end
		else goTo(b, g) end end
	elseif m == "run_far" then if pp then goTo(b, away(b, pp, 20)) end
	elseif m == "jumpy" then if math.random() < 0.15 then goTo(b, home + Vector3.new(rnd(-20, 20), 0, rnd(-20, 20))) end if math.random() < 0.12 then b.hum.Jump = true end
	elseif m == "pace" then A.ph = A.ph + dt; if A.ph > 3 then A.ph = 0; A.side = not A.side end goTo(b, home + Vector3.new(A.side and 6 or -6, 0, 0))
	elseif m == "lead" then if pp then local l = flat(p.root.CFrame.LookVector); goTo(b, pp + (l.Magnitude > 0 and l.Unit or Vector3.new(0, 0, -1)) * 10) end
	elseif m == "chase_weakest" or m == "chase_farthest" then local best, bv = nil, nil for _, o in ipairs(humans()) do if o ~= b and alive(o) and (o.player or not b.team or o.team ~= b.team) then local v = m == "chase_weakest" and o.hum.Health or -(hpos(o) - me).Magnitude; if bv == nil or v < bv then bv = v; best = o end end end if best then goTo(b, hpos(best)) end
	elseif m == "scatter" then local best, bd = nil, math.huge for _, o in ipairs(liveBots()) do if o ~= b then local d = (hpos(o) - me).Magnitude; if d < bd then bd = d; best = o end end end if best and bd < 20 then goTo(b, away(b, hpos(best))) end
	elseif m == "line_up" then local first, idx, n = nil, 0, 0 for _, o in ipairs(liveBots()) do if o.bx and o.bx.mode == "line_up" then n = n + 1; first = first or o; if o == b then idx = n end end end if first then goTo(b, (first.home or hpos(first)) + Vector3.new((idx - 1) * 4, 0, 0)) end
	elseif m == "crowd_player" then if pp then goTo(b, pp) end
	elseif m == "wander_in" then local c0, inst = partPos(A.part); if c0 and inst and inst:IsA("BasePart") then if not A.goal or flat(A.goal - me).Magnitude < 3 or A.t > 8 then A.t = 0; A.goal = (inst.CFrame * CFrame.new(rnd(-0.45, 0.45) * inst.Size.X, inst.Size.Y / 2, rnd(-0.45, 0.45) * inst.Size.Z)).Position end goTo(b, A.goal) end
	elseif m == "revenge" then local f = b.lastHurtBy; if f and alive(f) then goTo(b, hpos(f)); b.attack = b.attack or 10 else b.hum:MoveTo(me) end
	elseif m == "coward" then if pp then if b.hum.Health < b.hum.MaxHealth * A.frac then goTo(b, away(b, pp, 18)) else goTo(b, pp) end end
	elseif m == "spin_bot" then b.hum:MoveTo(me); if b.root then b.hum.AutoRotate = false; b.root.CFrame = b.root.CFrame * CFrame.Angles(0, math.rad(A.rate * dt), 0) end
	elseif m == "moonwalk" then if pp then goTo(b, pp); b.hum.AutoRotate = false; face(b, me + (me - pp)) end
	elseif m == "seek_part" then local best, bd = nil, math.huge for _, d in ipairs(workspace:GetDescendants()) do if d:IsA("BasePart") and lower(d.Name):find(A.name, 1, true) then local dd = (d.Position - me).Magnitude; if dd < bd then bd = dd; best = d end end end if best then goTo(b, best.Position) end
	elseif m == "avoid_part" then local push = Vector3.new() for _, d in ipairs(workspace:GetDescendants()) do if d:IsA("BasePart") and lower(d.Name):find(A.name, 1, true) then local o = flat(me - d.Position); local dist = math.max(0, o.Magnitude - math.max(d.Size.X, d.Size.Z) / 2); if dist < A.r and o.Magnitude > 0 then push = push + o.Unit end end end
		if push.Magnitude > 0 then goTo(b, me + push.Unit * 10) elseif not A.goal or flat(A.goal - me).Magnitude < 3 or A.t > 8 then A.t = 0; A.goal = home + Vector3.new(rnd(-30, 30), 0, rnd(-30, 30)); goTo(b, A.goal) end
	elseif m == "play_tag" then local it = X.rules and X.rules.it; if it == b then if pp then goTo(b, pp) end elseif it and it.player then if pp and pd < 30 then goTo(b, away(b, pp, 16)) end elseif math.random() < 0.15 then goTo(b, home + Vector3.new(rnd(-20, 20), 0, rnd(-20, 20))) end
		if it == b and p and pd < 4 and (A.tagCD or 0) < NOW then A.tagCD = NOW + 2; X.rules.it = p; send(nil, "toast", p.name .. " is it!") elseif it == p and pd < 4 and (A.tagCD or 0) < NOW then A.tagCD = NOW + 2; X.rules.it = b; send(nil, "toast", b.name .. " is it!") end
	elseif m == "keep_distance" then if pp then local d = flat(me - pp); if d.Magnitude > 0 then goTo(b, pp + d.Unit * A.r) end end
	elseif m == "follow_trail" then if pp then table.insert(A.trail, pp); if #A.trail > 400 then table.remove(A.trail, 1) end end
		local g = A.trail[1]; while g and flat(g - me).Magnitude < 2.5 and #A.trail > 1 do table.remove(A.trail, 1); g = A.trail[1] end if g and #A.trail > 6 then goTo(b, g) end
	elseif m == "charge" then A.ph = A.ph + dt
		if A.ph < 1 then b.hum:MoveTo(me); if pp then face(b, pp); A.dir = flat(pp - me) end
		elseif A.ph < 2.2 then A.ws = A.ws or b.hum.WalkSpeed; b.hum.WalkSpeed = A.ws * 2.5; if A.dir and A.dir.Magnitude > 0 then goTo(b, me + A.dir.Unit * 20) end
		else if A.ws then b.hum.WalkSpeed = A.ws; A.ws = nil end A.ph = 0 end
	elseif m == "random_walk" then A.ph = A.ph + dt; if A.ph > 1 then A.ph = 0; local an = math.random() * math.pi * 2; goTo(b, me + Vector3.new(math.cos(an) * 10, 0, math.sin(an) * 10)) end
	elseif m == "guard_return" then if pp and pd < A.r then goTo(b, pp) else goTo(b, home) end
	elseif m == "circle" then local an = A.t * 0.6; goTo(b, home + Vector3.new(math.cos(an) * A.r, 0, math.sin(an) * A.r))
	elseif m == "copy" then if p then b.hum:Move(p.hum.MoveDirection, false); if p.root.AssemblyLinearVelocity.Y > 15 then b.hum.Jump = true end end end
end
X.reviveBot = function(b) if b.model and b.P then local copy = DATA._botCopies[b.model]; if copy then local m = copy:Clone(); m.Parent = b.model.Parent or workspace; b.model:Destroy(); registerThing(m, b.P.codeJSON, "bot", false) end end end

-- extra powers
local function P2(name, fn) H(name, function(c, b, a) if b.kind ~= "bot" then return end fn(X2(b), a, b, c) end, true) end
P2("bot_armor", function(A, a) A.armor = math.clamp(nm(a, 0.5), 0, 0.95) end)
P2("bot_dodge", function(A, a) A.dodge = math.clamp(nm(a, 0.3), 0, 1) end)
P2("bot_regen", function(A, a) A.regen = nm(a, 5) end)
P2("bot_greet", function(A, a) A.greet = interp(a) end)
P2("bot_chatter", function(A, a) A.chatter = lines(a); A.chatT = rnd(3, 8) end)
P2("bot_ouch", function(A, a) A.ouch = interp(a) end)
P2("bot_last_words", function(A, a) A.lastWords = interp(a) end)
P2("bot_shoot", function(A, a) A.shoot = TT(a, 2); A.shootT = A.shoot end)
P2("bot_shot_damage", function(A, a) A.shotDmg = nm(a, 15) end)
P2("bot_shot_color", function(A, a) A.shotCol = colorHex(colorArg(a)) end)
P2("bot_shoot_range", function(A, a) A.shotRange = nm(a, 60) end)
P2("bot_throw", function(A, a) A.throw = TT(a, 3); A.throwT = A.throw end)
P2("bot_leap", function(A, a) A.leap = TT(a, 2); A.leapT = A.leap end)
P2("bot_blink", function(A, a) A.blink = TT(a, 4); A.blinkT = A.blink end)
P2("bot_appear_behind", function(A, a) A.behind = TT(a, 8); A.behindT = A.behind end)
P2("bot_hide_far", function(A, a) A.hideFar = nm(a, 30) end)
P2("bot_aura", function(A, a) local p = split(a, ":"); A.aura = nm(p[1] or "", 10); A.auraR = nm(p[2] or "", 8) end)
P2("bot_heal_aura", function(A, a) local p = split(a, ":"); A.healAura = nm(p[1] or "", 10); A.healR = nm(p[2] or "", 12) end)
P2("bot_summon", function(A, a) A.summon = TT(a, 10); A.summonT = A.summon end)
P2("bot_trail", function(A, a, b) local col = colorHex(colorArg(trim(a) ~= "" and a or "purple")); if b.root then local old = b.root:FindFirstChild("BuildXBotTrail"); if old then old:Destroy() end local e = Instance.new("ParticleEmitter"); e.Name = "BuildXBotTrail"; e.Texture = "rbxasset://textures/particles/smoke_main.dds"; e.Color = ColorSequence.new(hex2color(col)); e.Size = NumberSequence.new(1.2, 0); e.Lifetime = NumberRange.new(1, 1.5); e.Speed = NumberRange.new(0.5); e.Rate = 15; e.Parent = b.root end end)
P2("bot_stare", function(A) A.stare = true end)
P2("bot_grow", function(A, a) local p = split(a, ":"); A.grow = nm(p[1] or "", 0.05); A.growMax = nm(p[2] or "", 3) end)
P2("bot_knockback", function(A, a) A.knock = nm(a, 60) end)
P2("bot_slow_hit", function(A, a) A.slowHit = TT(a, 3) end)
P2("bot_freeze_hit", function(A, a) A.freezeHit = TT(a, 1) end)
P2("bot_poison_hit", function(A, a) A.poisonHit = TT(a, 4) end)
P2("bot_lifesteal", function(A, a) A.lifesteal = math.clamp(nm(a, 0.5), 0, 1) end)
P2("bot_steal_coins", function(A, a) A.stealCoins = nm(a, 5) end)
P2("bot_explode_on_death", function(A, a) A.explodeR = nm(a, 10) end)
P2("bot_drop_coins", function(A, a) A.dropCoins = math.floor(nm(a, 3) + 0.5) end)
P2("bot_drop_item", function(A, a) A.dropItem = lower(trim(a)) end)
P2("bot_split", function(A, a) A.split = math.floor(nm(a, 2) + 0.5) end)
P2("bot_grow_on_kill", function(A) A.growKill = true end)
H("bot_health", function(c, b, a) if b.hum then b.hum.MaxHealth = nm(a, 100); b.hum.Health = b.hum.MaxHealth end end, true)
H("bot_jump_power", function(c, b, a) if b.hum then b.hum.UseJumpPower = true; b.hum.JumpPower = nm(a, 50) * JPK end end, true)
H("bot_size", function(c, b, a) setSize(b, math.clamp(nm(a, 1), 0.2, 10)); b.baseSize = b.size end, true)
H("bot_name", function(c, b, a) local n = trim(a) ~= "" and interp(a) or "Bot"; b.name = n; if b.hum then b.hum.DisplayName = n end end, true)
H("bot_team", function(c, b, a) b.team = trim(a) end, true)
H("bot_pushable", function(c, b) if b.root then b.root.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0.3, 0, 1, 1) end end, true)
H("bot_unpushable", function(c, b) if b.root then b.root.CustomPhysicalProperties = PhysicalProperties.new(100, 1, 0, 1, 1) end end, true)
H("bot_home_here", function(c, b) b.home = hpos(b); if b.ai then b.ai.home = b.home end end, true)
H("bot_home", function(c, b, a) local p = partPos(a); b.home = p or parseVec(a, hpos(b)); if b.ai then b.ai.home = b.home end end, true)
H("bot_leap_now", function(c, b) local p = nearestPlayer(b); if p and b.root then local d = hpos(p) - hpos(b); b.root.AssemblyLinearVelocity = Vector3.new(d.X * 2.2, 45, d.Z * 2.2) end end, true)
local function shot(b, target, col, dmg)
	if not b.root or not target or not alive(target) then return end
	local from = b.root.Position + Vector3.new(0, 1, 0); local dir = (hpos(target) - from).Unit
	local s = Instance.new("Part"); s.Shape = Enum.PartType.Ball; s.Size = Vector3.new(0.7, 0.7, 0.7); s.Material = Enum.Material.Neon; s.Color = hex2color(col or "#ff5a3d"); s.CanCollide = false; s.Position = from + dir * 2.5; s.Parent = workspace
	local at = Instance.new("Attachment", s); local f = Instance.new("VectorForce"); f.Attachment0 = at; f.RelativeTo = Enum.ActuatorRelativeTo.World; f.Force = Vector3.new(0, s.AssemblyMass * workspace.Gravity, 0); f.Parent = s
	s.AssemblyLinearVelocity = dir * 70
	s.Touched:Connect(function(hit) local m = hit:FindFirstAncestorOfClass("Model"); local h = m and hOf(m); if h and h ~= b then hurtHumanoid(h, dmg or 10, b); s:Destroy() elseif hit.CanCollide and not hit:IsDescendantOf(b.model) then s:Destroy() end end)
	Debris:AddItem(s, 3)
end
H("bot_shoot_now", function(c, b) local A = X2(b); shot(b, nearestPlayer(b), A.shotCol, A.shotDmg or 10) end, true)
H("bot_teleport_home", function(c, b) if b.home and b.model then b.model:PivotTo(CFrame.new(b.home + Vector3.new(0, 1, 0))); if b.root then b.root.AssemblyLinearVelocity = Vector3.new() end end end, true)
H("bot_clone", function(c, b) if b.kind ~= "bot" or #BOTS >= 80 then return end X.makeBot(b.model and b.model.Name or "Bot", hpos(b) + Vector3.new(4, 1, 0), b) end, true)
H("make_it", function(c, h) if X.rules then X.rules.it = h end sayB(h, "I'm it!") end)

local function lob(from, to, dmg, b)
	local r = Instance.new("Part"); r.Shape = Enum.PartType.Ball; r.Size = Vector3.new(1.2, 1.2, 1.2); r.Material = Enum.Material.Slate; r.Color = Color3.fromRGB(110, 100, 92); r.CanCollide = false; r.Position = from; r.Parent = workspace
	local d = to - from; local fl = flat(d); local t = math.max(0.5, fl.Magnitude / 40)
	r.AssemblyLinearVelocity = fl / t + Vector3.new(0, d.Y / t + 0.5 * workspace.Gravity * t, 0)
	r.Touched:Connect(function(hit) local m = hit:FindFirstAncestorOfClass("Model"); local h = m and hOf(m); if h and h ~= b then hurtHumanoid(h, dmg, b); r:Destroy() end end)
	Debris:AddItem(r, 4)
end
local function coinDrop(pos)
	local cp = Instance.new("Part"); cp.Shape = Enum.PartType.Cylinder; cp.Size = Vector3.new(0.3, 2, 2); cp.Color = Color3.fromRGB(255, 205, 40); cp.Material = Enum.Material.Metal; cp.Anchored = true; cp.CanCollide = false
	cp.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2); cp.Name = "Coin"; cp.Parent = workspace
	local taken = false
	cp.Touched:Connect(function(hit) if taken then return end local m = hit:FindFirstAncestorOfClass("Model"); local h = m and hOf(m); if h and h.player then taken = true; addStat(h, "coins", 1); sfx("coin", h.root); cp:Destroy() end end)
	Debris:AddItem(cp, 60)
end

table.insert(HOOK.hurt, function(h, n, from)
	local A = h.bx
	if A then
		if A.dodge and math.random() < A.dodge then sayB(h, "Missed!"); return 0 end
		if A.armor then n = n * (1 - A.armor) end
		if A.ouch and (A.ouchCD or 0) < NOW then A.ouchCD = NOW + 1.5; sayB(h, A.ouch) end
	end
	local F2 = from and from.bx
	if F2 then
		if F2.slowHit then timedSpeed(h, 0.4, F2.slowHit) end
		if F2.freezeHit and h.root then h.root.Anchored = true; local r = h.root; table.insert(LATER, {NOW + F2.freezeHit, function() if r.Parent then r.Anchored = false end end}) end
		if F2.poisonHit then for i = 1, math.floor(F2.poisonHit) do table.insert(LATER, {NOW + i, function() hurtHumanoid(h, 3) end}) end end
		if F2.lifesteal and alive(from) then from.hum.Health = math.min(from.hum.MaxHealth, from.hum.Health + n * F2.lifesteal) end
		if F2.stealCoins and h.player then setStat(h, "coins", math.max(0, (h.stats.coins or 0) - F2.stealCoins)) end
	end
	return n
end)
table.insert(HOOK.kill, function(from, h) local A = from.bx; if A and A.growKill then setSize(from, math.min(10, (from.size or 1) * 1.2)) end end)
table.insert(HOOK.died, function(b)
	local A = b.bx; if not A or b.kind ~= "bot" then return end
	local pos = hpos(b)
	if A.lastWords then sayB(b, A.lastWords) end
	if A.explodeR then explodeAt(pos, A.explodeR) end
	if A.dropCoins then for i = 1, A.dropCoins do coinDrop(pos + Vector3.new(rnd(-3, 3), 1.5, rnd(-3, 3))) end end
	if A.dropItem and A.dropItem ~= "" then local t = makeTool(A.dropItem); local hd = t and t:FindFirstChild("Handle"); if hd then t.Parent = workspace; hd.CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)) elseif t then t:Destroy() end end
	if A.split and A.split > 0 and (b.size or 1) > 0.35 then for i = 1, A.split do local nb = X.makeBot(b.model and b.model.Name or "Bot", pos + Vector3.new(rnd(-3, 3), 2, rnd(-3, 3)), b); if nb then setSize(nb, (b.size or 1) * 0.6); nb.bx = {split = A.split} end end end
end)

local acc = 0
table.insert(STEPS, function(dt)
	acc = acc + dt
	local brainTick = acc >= 0.25
	if brainTick then acc = 0 end
	for _, b in ipairs(BOTS) do
		local A = b.bx
		if A and alive(b) and not b.frozen then
			local p, pd = nearestPlayer(b)
			if A.mode and brainTick then pcall(think, b, A, 0.25) end
			if A.regen then b.hum.Health = math.min(b.hum.MaxHealth, b.hum.Health + A.regen * dt) end
			if A.greet and p then local nearNow = pd < 10; if nearNow and not A.greeted then sayB(b, A.greet) end A.greeted = nearNow end
			if A.chatter and #A.chatter > 0 then A.chatT = A.chatT - dt; if A.chatT <= 0 then A.chatT = rnd(6, 12); sayB(b, A.chatter[math.random(1, #A.chatter)]) end end
			if A.shoot and p then A.shootT = A.shootT - dt; if A.shootT <= 0 then A.shootT = A.shoot; if pd < (A.shotRange or 60) then shot(b, p, A.shotCol, A.shotDmg or 10) end end end
			if A.throw and p then A.throwT = A.throwT - dt; if A.throwT <= 0 then A.throwT = A.throw; if pd < 60 then lob(hpos(b) + Vector3.new(0, 2, 0), hpos(p), 12, b) end end end
			if A.leap and p then A.leapT = A.leapT - dt; if A.leapT <= 0 and pd < 20 then A.leapT = A.leap; local d = hpos(p) - hpos(b); b.root.AssemblyLinearVelocity = Vector3.new(d.X * 2.2, 45, d.Z * 2.2) end end
			if A.blink then A.blinkT = A.blinkT - dt; if A.blinkT <= 0 then A.blinkT = A.blink; local hm = b.home or hpos(b); b.model:PivotTo(CFrame.new(hm + Vector3.new(rnd(-15, 15), 2, rnd(-15, 15)))); burst(hpos(b), {"#b48cff", "#ffffff"}, 25) end end
			if A.behind and p then A.behindT = A.behindT - dt; if A.behindT <= 0 then A.behindT = A.behind; local l = flat(p.root.CFrame.LookVector); if l.Magnitude > 0 then b.model:PivotTo(CFrame.lookAt(hpos(p) - l.Unit * 5, hpos(p))) end end end
			if A.hideFar and p then local hide = pd > A.hideFar; if hide ~= A.hidden then A.hidden = hide; for _, d in ipairs(b.model:GetDescendants()) do if d:IsA("BasePart") and d.Name ~= "Head" then if hide then d:SetAttribute("bxT0", d.Transparency); d.Transparency = 1 else d.Transparency = d:GetAttribute("bxT0") or 0 end end end end end
			if A.aura then for _, h in ipairs(humans()) do if h ~= b and alive(h) and (h.player or (b.team and h.team ~= b.team)) and (hpos(h) - hpos(b)).Magnitude < A.auraR then hurtHumanoid(h, A.aura * dt, b) end end end
			if A.healAura then for _, o in ipairs(liveBots()) do if (hpos(o) - hpos(b)).Magnitude < A.healR then o.hum.Health = math.min(o.hum.MaxHealth, o.hum.Health + A.healAura * dt) end end end
			if A.summon then A.summonT = A.summonT - dt; if A.summonT <= 0 then A.summonT = A.summon; if #BOTS < 60 then local nb = X.makeBot("Minion", hpos(b) + Vector3.new(rnd(-4, 4), 2, rnd(-4, 4))); if nb then setSize(nb, 0.6); nb.ai = {mode = "Chase"}; nb.attack = 5 end end end end
			if A.stare and p then face(b, hpos(p)) end
			if A.grow then local s = math.min(A.growMax, (b.size or 1) + A.grow * dt); if math.abs(s - (b.size or 1)) > 0.01 then setSize(b, s) end end
		end
	end
end)

end)()
;(function()
-- ===== items: every setting from the BuildX item editor, and game passes =====
local MPS = game:GetService("MarketplaceService")
local function toast19(h, t) if h and h.player then Remote:FireClient(h.player, "toast", t) end end
local function infoOf(tool) local key = tool:GetAttribute("BuildXItem") or nrm(tool.Name); return ITEMS[key], key end
local function jdec(s) if not s or s == "" then return nil end local ok, t = pcall(function() return HttpService:JSONDecode(s) end); return ok and t or nil end
local function c3(hex, d) hex = tostring(hex or ""):gsub("#", ""); if #hex ~= 6 then return d end return Color3.fromRGB(tonumber(hex:sub(1, 2), 16) or 255, tonumber(hex:sub(3, 4), 16) or 255, tonumber(hex:sub(5, 6), 16) or 255) end
local function runOps(h, json, field)
	if not json then return end
	local C = jdec(json); if not C then return end
	table.insert(DATA._itemP.threads, newThread(C.main or {}, h))
end

-- tools carry their settings as attributes so the client can animate them
local baseMake = makeTool
makeTool = function(n)
	local tool = baseMake(n); if not tool then return tool end
	local info = ITEMS[nrm(n)] or {}
	if info.label then tool.ToolTip = info.label end
	if info.info and info.info ~= "" then tool.ToolTip = info.info end
	tool.CanBeDropped = info.canDrop and true or false
	if info.animsJSON then tool:SetAttribute("BuildXAnims", info.animsJSON) end
	if info.autoUse then tool:SetAttribute("BuildXAutoUse", true) end
	if info.uses then tool:SetAttribute("BuildXUses", info.uses) end
	tool:SetAttribute("BuildXGrip0", tool.Grip)
	local hnd = tool:FindFirstChild("Handle")
	if hnd then
		if info.glow then local l = Instance.new("PointLight"); l.Name = "BuildXGlow"; l.Brightness = 2; l.Range = 10; l.Color = c3(info.glowColor, Color3.fromRGB(255, 210, 122)); l.Parent = hnd end
		local fx = info.fx
		if fx == "Sparkles" or fx == "Glitter" or fx == "Stars" then local s = Instance.new("Sparkles"); s.SparkleColor = fx == "Stars" and Color3.fromRGB(255, 240, 160) or Color3.fromRGB(255, 255, 255); s.Parent = hnd
		elseif fx == "Fire" then Instance.new("Fire", hnd).Size = 2
		elseif fx == "Smoke" then local s = Instance.new("Smoke"); s.Size = 1; s.Opacity = 0.2; s.Parent = hnd
		elseif fx then
			local e = Instance.new("ParticleEmitter"); e.Rate = 8; e.Lifetime = NumberRange.new(0.8, 1.4); e.Speed = NumberRange.new(1, 2); e.Size = NumberSequence.new(0.3)
			e.Color = ColorSequence.new(fx == "Hearts" and Color3.fromRGB(255, 90, 140) or fx == "Bubbles" and Color3.fromRGB(150, 210, 255) or Color3.fromRGB(255, 255, 255))
			e.Acceleration = fx == "Snow" and Vector3.new(0, -2, 0) or Vector3.new(0, 1.5, 0); e.Parent = hnd
		end
	end
	return tool
end

-- taking it out and putting it away
local function onEquip(h, tool)
	local info = infoOf(tool); if not info or not h.hum then return end
	h.heldTool = tool
	if info.heldSpeed and info.heldSpeed ~= 1 then h.heldSM = info.heldSpeed; h.hum.WalkSpeed = h.hum.WalkSpeed * info.heldSpeed end
	if info.heldJump and info.heldJump ~= 1 then h.heldJM = info.heldJump; h.hum.JumpPower = h.hum.JumpPower * info.heldJump end
	if info.info and info.info ~= "" then toast19(h, info.info) end
	runOps(h, info.equipJSON)
end
local function onUnequip(h, tool)
	local info = infoOf(tool); if h.heldTool == tool then h.heldTool = nil end
	if h.hum then
		if h.heldSM then h.hum.WalkSpeed = h.hum.WalkSpeed / h.heldSM; h.heldSM = nil end
		if h.heldJM then h.hum.JumpPower = h.hum.JumpPower / h.heldJM; h.heldJM = nil end
	end
	if info then runOps(h, info.unequipJSON) end
end
local function hookTool(h, t)
	if t:GetAttribute("BuildXHooked") then return end
	t:SetAttribute("BuildXHooked", true)
	t.Activated:Connect(function() local who = (t.Parent and hOf(t.Parent)) or h; useItem(who, t) end)
	t.Equipped:Connect(function() onEquip((t.Parent and hOf(t.Parent)) or h, t) end)
	t.Unequipped:Connect(function() onUnequip(h, t) end)
end
X.hookTool = hookTool
-- tools picked up from the ground get hooked too
table.insert(HOOK.char, function(h)
	if not h.model then return end
	h.model.ChildAdded:Connect(function(c) if c:IsA("Tool") and c:GetAttribute("BuildXItem") then hookTool(h, c) end end)
end)

local function countHeld(h, key)
	local k = 0
	if h.player then for _, w in ipairs({h.model, h.player:FindFirstChild("Backpack")}) do if w then for _, t in ipairs(w:GetChildren()) do if t:IsA("Tool") and (t:GetAttribute("BuildXItem") or nrm(t.Name)) == key then k = k + 1 end end end end end
	return k
end
local baseGive = giveTool
giveTool = function(h, n, k)
	if not h.player then return baseGive(h, n, k) end
	local key = nrm(n); local info = ITEMS[key] or {}
	local bpk = h.player:FindFirstChild("Backpack"); if not bpk then return end
	for _ = 1, (k or 1) do
		if info.maxStack and info.maxStack > 0 and countHeld(h, key) >= info.maxStack then toast19(h, "You can't carry more " .. n) break end
		local t = makeTool(n); hookTool(h, t); t.Parent = bpk
		-- keep it after dying unless "drop when you die" is on
		if not info.dropOnDeath then local sg = h.player:FindFirstChild("StarterGear"); if sg then local c = makeTool(n); c:SetAttribute("BuildXGearOf", true); c.Parent = sg end end
	end
end
local baseTake = takeTool
takeTool = function(h, n, k)
	local r = baseTake(h, n, k)
	if h.player then local sg = h.player:FindFirstChild("StarterGear"); local left = k or 1; local key = nrm(n)
		if sg then for _, t in ipairs(sg:GetChildren()) do if left > 0 and t:IsA("Tool") and (t:GetAttribute("BuildXItem") or nrm(t.Name)) == key then t:Destroy(); left = left - 1 end end end end
	return r
end
-- #give_tool only gives it when you don't have one yet (same as BuildX), so standing on a sword pad doesn't stack swords
H("give_tool", function(c, h, a) local n = trim(a) ~= "" and trim(a) or "Sword"; if not h.player or countHeld(h, nrm(n)) == 0 then giveTool(h, n, 1) end end)
-- respawn copies from StarterGear need hooking; drop on death
table.insert(HOOK.char, function(h)
	if not h.player then return end
	task.defer(function() local b = h.player:FindFirstChild("Backpack"); if b then for _, t in ipairs(b:GetChildren()) do if t:IsA("Tool") and t:GetAttribute("BuildXItem") then hookTool(h, t) end end
		b.ChildAdded:Connect(function(t) if t:IsA("Tool") and t:GetAttribute("BuildXItem") then hookTool(h, t) end end) end end)
end)
table.insert(HOOK.died, function(h)
	if not h.player then return end
	local at = hpos(h)
	for _, w in ipairs({h.model, h.player:FindFirstChild("Backpack")}) do if w then for i, t in ipairs(w:GetChildren()) do
		local info = t:IsA("Tool") and infoOf(t)
		if info and info.dropOnDeath then local hd = t:FindFirstChild("Handle"); if hd then t.Parent = workspace; hd.CFrame = CFrame.new(at + Vector3.new(math.cos(i) * 2.5, 1.5, math.sin(i) * 2.5)) else t:Destroy() end end
	end end end
end)

-- using it
local function shotFrom(h, info, dmg)
	local look = h.root and h.root.CFrame.LookVector or Vector3.new(0, 0, -1)
	local ball = Instance.new("Part")
	local sz = info.shotSize or 0.7
	ball.Shape = Enum.PartType.Ball; ball.Size = Vector3.new(sz, sz, sz); ball.Material = Enum.Material.Neon; ball.Color = c3(info.shotColor, Color3.fromRGB(255, 220, 90))
	ball.CanCollide = false; ball.CFrame = CFrame.new(hpos(h) + Vector3.new(0, 1.5, 0) + look * 2.5); ball.Parent = workspace
	ball.AssemblyLinearVelocity = look * (info.shotSpeed or 120)
	local at = Instance.new("Attachment", ball); local f = Instance.new("VectorForce"); f.Attachment0 = at; f.RelativeTo = Enum.ActuatorRelativeTo.World; f.Force = Vector3.new(0, ball.AssemblyMass * workspace.Gravity, 0); f.Parent = ball
	ball.Touched:Connect(function(hit) local m = hit:FindFirstAncestorOfClass("Model"); local o = m and hOf(m); if o and o ~= h then hurtHumanoid(o, dmg, h); ball:Destroy() end end)
	Debris:AddItem(ball, 3)
end
local function throwFrom(h, tool, info, dmg)
	local hd = tool:FindFirstChild("Handle"); if not hd then return end
	local look = h.root and h.root.CFrame.LookVector or Vector3.new(0, 0, -1)
	local p = hd:Clone(); for _, d in ipairs(p:GetChildren()) do if d:IsA("TouchTransmitter") then d:Destroy() end end
	p.Name = tool.Name; p.Anchored = false; p.CanCollide = true; p.Massless = false
	p.CFrame = CFrame.new(hpos(h) + Vector3.new(0, 2, 0) + look * 2); p.Parent = workspace
	p.AssemblyLinearVelocity = look * (info.throwPower or 60) + Vector3.new(0, (info.throwPower or 60) * 0.35, 0)
	local done = false
	p.Touched:Connect(function(hit) if done then return end local m = hit:FindFirstAncestorOfClass("Model"); local o = m and hOf(m); if o and o ~= h then done = true; hurtHumanoid(o, dmg, h) end end)
	task.delay(2.5, function()
		if not p.Parent then return end
		if info.throwPickup ~= false then local key = tool:GetAttribute("BuildXItem") or nrm(tool.Name); local t = makeTool(key); local th = t and t:FindFirstChild("Handle")
			if th then th.CFrame = p.CFrame; t.Parent = workspace elseif t then t:Destroy() end end
		p:Destroy()
	end)
end
local baseUse = useItem
useItem = function(h, tool)
	local info, key = infoOf(tool)
	if not info or not info.usable then return end
	local cd = info.cooldown or 0.35
	h.useTs = h.useTs or {}
	if h.useTs[key] and NOW - h.useTs[key] < cd then return end
	h.useTs[key] = NOW
	h.useT = nil
	tool:SetAttribute("BuildXUseAt", workspace:GetServerTimeNow())
	local ef = info.effect or "None"; local amt = info.amount or 0
	if ef == "Hit" then
		local look = h.root and h.root.CFrame.LookVector or Vector3.new(0, 0, -1); local R = info.range or 7.5
		for _, b in ipairs(humans()) do
			if b ~= h and alive(b) then
				local d = hpos(b) - hpos(h); local fl = Vector3.new(d.X, 0, d.Z)
				if fl.Magnitude < R and math.abs(d.Y) < 5 and (fl.Magnitude < 0.5 or fl.Unit:Dot(look) > 0.2) then
					hurtHumanoid(b, amt, h)
					if info.knockback and info.knockback > 0 and b.root then local dir = fl.Magnitude > 0.01 and fl.Unit or look; b.root.AssemblyLinearVelocity = dir * info.knockback + Vector3.new(0, info.knockback * 0.4, 0); if b.player then Remote:FireClient(b.player, "vel", b.root.AssemblyLinearVelocity) end end
				end
			end
		end
		fireAll("on_signal", "use_" .. key, h)
	elseif ef == "Shoot" then shotFrom(h, info, amt); fireAll("on_signal", "use_" .. key, h)
	elseif ef == "Throw" then throwFrom(h, tool, info, amt); fireAll("on_signal", "use_" .. key, h)
	else
		local turns, cons = info.turnsInto, info.consumable
		info.turnsInto = nil; info.consumable = nil
		h.useT = nil
		baseUse(h, tool)
		info.turnsInto = turns; info.consumable = cons
	end
	if info.sound and info.sound ~= "" then sfx(info.sound, h.root) elseif ef == "Hit" or ef == "Shoot" or ef == "Throw" then sfx("pop", h.root) end
	-- uses left
	if info.uses and info.uses > 0 then
		local left = (tool:GetAttribute("BuildXUses") or info.uses) - 1
		tool:SetAttribute("BuildXUses", left)
		if left <= 0 then toast19(h, tool.Name .. " broke"); sfx("break", h.root); takeTool(h, key, 1); tool:Destroy(); return end
	end
	if ef == "Throw" then takeTool(h, key, 1); tool:Destroy(); return end
	if info.turnsInto and info.turnsInto ~= "" then
		tool:Destroy(); giveTool(h, info.turnsInto, 1)
		local bpk = h.player and h.player:FindFirstChild("Backpack")
		if bpk then for _, t in ipairs(bpk:GetChildren()) do if t:IsA("Tool") and nrm(t.Name) == nrm(info.turnsInto) then h.hum:EquipTool(t) break end end end
	elseif info.consumable then takeTool(h, key, 1); tool:Destroy() end
end

-- ===== game passes =====
local PASSES = DATA.passes or {}
local PASSDIR = script:FindFirstChild("Passes")
local function passId(p) local v = PASSDIR and PASSDIR:FindFirstChild(p.name); if v and v.Value and v.Value > 0 then return v.Value end return p.rid or 0 end
local function findPass(n) local k = nrm(n); for _, p in ipairs(PASSES) do if p.key == k or nrm(p.name) == k then return p end end return nil end
local function applyPass(h, p, again)
	h.passes = h.passes or {}
	if h.passes[p.key] and not again then return end
	h.passes[p.key] = true
	VARS["pass_" .. p.key] = 1
	if h.player then h.player:SetAttribute("Pass_" .. p.key, true) end
	local js = again and p.respawnJSON or p.codeJSON
	if js and js ~= "" then local C = jdec(js); if C then table.insert(DATA._itemP.threads, newThread(C.main or {}, h)) end end
	if (p.coinsMul or 1) > 1 then if CMD.coin_multiplier and CMD.coin_multiplier.fn then pcall(CMD.coin_multiplier.fn, {P = DATA._itemP}, tostring(p.coinsMul)) end end
	if p.door and p.door ~= "" and h.player then Remote:FireClient(h.player, "passdoor", p.door) end
	if not again then fireAll("on_signal", "bought_" .. p.key, h) end
end
local function owns(h, p)
	if h.passes and h.passes[p.key] then return true end
	local id = passId(p); if not h.player or id <= 0 then return false end
	local ok, r = pcall(function() return MPS:UserOwnsGamePassAsync(h.player.UserId, id) end)
	return ok and r
end
local function prompt(h, p)
	if not h.player then return end
	if h.passes and h.passes[p.key] then toast19(h, "You already have " .. p.name) return end
	local id = passId(p)
	if id <= 0 then toast19(h, p.name .. " has no game pass ID yet") return end
	pcall(function() MPS:PromptGamePassPurchase(h.player, id) end)
end
MPS.PromptGamePassPurchaseFinished:Connect(function(plr, id, bought)
	if not bought then return end
	local h = PLAYER_H[plr]; if not h then return end
	for _, p in ipairs(PASSES) do if passId(p) == id then applyPass(h, p) end end
end)
table.insert(HOOK.char, function(h, respawned)
	if not h.player or #PASSES == 0 then return end
	task.spawn(function()
		for _, p in ipairs(PASSES) do
			if respawned then if h.passes and h.passes[p.key] then applyPass(h, p, true) end
			elseif owns(h, p) then applyPass(h, p) end
		end
		if not respawned then task.wait(2); for _, p in ipairs(PASSES) do if p.start and not (h.passes and h.passes[p.key]) then prompt(h, p) break end end end
	end)
end)
-- parts that offer a pass when touched
task.defer(function()
	for _, p in ipairs(PASSES) do
		if p.touch and p.touch ~= "" then
			local P = findP(p.touch); local inst = P and P.inst
			local parts = {}
			if inst and inst:IsA("BasePart") then parts = {inst} elseif inst then for _, d in ipairs(inst:GetDescendants()) do if d:IsA("BasePart") then table.insert(parts, d) end end end
			for _, b in ipairs(parts) do b.Touched:Connect(function(hit)
				local m = hit:FindFirstAncestorOfClass("Model"); local h = m and hOf(m); if not h or not h.player then return end
				h.passAsk = h.passAsk or {}; if h.passAsk[p.key] and NOW - h.passAsk[p.key] < 4 then return end
				h.passAsk[p.key] = NOW; prompt(h, p)
			end) end
		end
	end
end)
H("prompt_pass", function(c, h, a) local p = findPass(a); if p then prompt(h, p) end end)
alias("buy_pass", "prompt_pass")
H("give_pass", function(c, h, a) local p = findPass(a); if p then applyPass(h, p) end end)
H("has_pass", function(c, h, a) local q = split(a, ":"); local p = findPass(trim(q[1] or "")); VARS[lower(trim(q[2] or "owns")):gsub("%s+", "_")] = (p and owns(h, p)) and 1 or 0 end)

end)()
;(function()
-- ===== GUI freedom: GUI commands with easy forms, and events on any GUI thing =====
local function N(s) return (lower(tostring(s or "")):gsub("[^a-z0-9]", "")) end
local function unq(s) s = trim(s); local a = s:match('^"(.*)"$') or s:match("^'(.*)'$"); return a or s end
-- every GUI thing in the place: path (Gui.Thing), name and type
local THINGS = {}
for _, sg in ipairs(StarterGui:GetChildren()) do
	if sg:IsA("LayerCollector") and A(sg, "BuildXGui") then
		for _, d in ipairs(sg:GetDescendants()) do
			local p = A(d, "BuildXPath")
			if p then table.insert(THINGS, {path = p, name = d.Name, gui = sg.Name, typ = A(d, "BuildXType") or "", toggle = A(d, "BuildXValue")}) end
		end
	end
end
local function findThing(w)
	w = unq(w); if w == "" then return nil end
	local g, e = w:match("^([^%.]+)%.(.+)$")
	for _, t in ipairs(THINGS) do
		if g then if N(t.gui) == N(g) and N(t.name) == N(e) then return t end
		elseif N(t.name) == N(w) then return t end
	end
	return nil
end
X.guiThing = findThing
local SELFW = {self = 1, me = 1, this = 1, it = 1}
local function selfPath(c) return c and c.P and c.P.kind == "gui" and c.P.gpath or nil end
-- "Thing : value", "value = Thing", "value : Thing", "self : value", or only a value on a GUI thing's own code
local function thingAndValue(c, a, needsValue)
	local s = trim(a)
	local function pair(w, v) w = trim(w); if SELFW[lower(w)] and selfPath(c) then return selfPath(c), v end local t = findThing(w); if t then return t.path, v end return nil end
	if s:find("=", 1, true) then
		local parts = {}; for x in (s .. "="):gmatch("(.-)%s*=%s*") do table.insert(parts, x) end
		local last = parts[#parts]; local rest = table.concat(parts, " = ", 1, #parts - 1)
		local p, v = pair(last, rest); if p then return p, unq(v) end
		p, v = pair(parts[1], table.concat(parts, " = ", 2)); if p then return p, unq(v) end
	end
	local ci = s:find(":", 1, true)
	if ci then
		local a1, a2 = s:sub(1, ci - 1), s:sub(ci + 1)
		local p, v = pair(a1, a2); if p then return p, trim(unq(v)) end
		local tail = trim(a2):match("([^:]+)$") or ""
		p, v = pair(tail, a1); if p then return p, trim(unq(v)) end
	end
	if not needsValue then local p = pair(s, ""); if p then return p, "" end end
	if selfPath(c) then return selfPath(c), unq(s) end
	local p = pair(s, ""); if p then return p, "" end
	return nil
end
X.guiThingAndValue = thingAndValue
local function nm(v, d) local x = tonumber(evalExpr(trim(v))); if x == nil then return d end return x end
local function two(v) local a, b = tostring(v):match("^%s*([^,%s]+)[,%s]+([^,%s]+)"); return tonumber(evalExpr(a or "")), tonumber(evalExpr(b or "")) end
local function yes(v) local k = lower(trim(v)); return not (k == "0" or k == "off" or k == "false" or k == "no" or k == "hide" or k == "hidden") end
local FONTS = {rounded = {17, 19}, chunky = {20, 20}, handwritten = {9, 9}, classic = {8, 8}, typewriter = {10, 10}, clean = {3, 4}}
local DO = {
	set_text = function(v) return {text = interp(v)} end,
	add_text = function(v) return {addText = interp(v)} end,
	set_text_color = function(v) return {textColor = colorHex(v)} end,
	set_background = function(v) return {bg = colorHex(v)} end,
	set_transparency = function(v) return {alpha = math.clamp(1 - nm(v, 0), 0, 1)} end,
	set_text_size = function(v) return {textSize = math.max(1, nm(v, 18))} end,
	set_font = function(v) local f = FONTS[N(v)]; if f then return {font = f} end return nil end,
	set_bold = function(v) return {bold = yes(v)} end,
	set_position = function(v) local x, y = two(v); return {x = x, y = y} end,
	move_thing = function(v) local x, y = two(v); return {dx = x or 0, dy = y or 0} end,
	set_thing_size = function(v) local x, y = two(v); return {w = x, h = y} end,
	set_rotation = function(v) return {rot = nm(v, 0)} end,
	turn_thing = function(v) return {drot = nm(v, 15)} end,
	set_corners = function(v) return {radius = math.max(0, nm(v, 0))} end,
	set_border = function(v) return {stroke = math.max(0, nm(v, 1))} end,
	set_border_color = function(v) return {strokeColor = colorHex(v)} end,
	set_toggle = function(v) local k = lower(trim(v)); if k == "toggle" or k == "switch" or k == "flip" then return {toggle = "flip"} end return {toggle = yes(v) and 1 or 0} end,
	set_choices = function(v) return {options = tostring(v)} end,
	set_choice = function(v) return {choice = trim(v)} end,
	enable_thing = function() return {disabled = false} end,
	disable_thing = function() return {disabled = true} end,
	toggle_thing = function() return {toggleHidden = true} end,
}
local NOVAL = {enable_thing = true, disable_thing = true, toggle_thing = true}
for name, f in pairs(DO) do
	F(name, function(c, a)
		local p, v = thingAndValue(c, a, not NOVAL[name])
		if not p then warnOnce("g" .. name .. tostring(a), "#" .. name .. ": no GUI thing called that") return end
		local ch = f(v or ""); if ch then send(c, "gset", p, ch) end
	end)
end
alias("settext", "set_text")
F("show_thing", function(c, a) local p = thingAndValue(c, a, false); if p then send(c, "gset", p, {hidden = false}) end end)
F("hide_thing", function(c, a) local p = thingAndValue(c, a, false); if p then send(c, "gset", p, {hidden = true}) end end)
F("set_value", function(c, a) local p, v = thingAndValue(c, a, true); if p then send(c, "gset", p, {value = nm(v, 0)}) end end)
F("set_gui_color", function(c, a) local p, v = thingAndValue(c, a, true); if p then send(c, "gset", p, {bg = colorHex(v)}) end end)

-- events: clicking or changing a GUI thing runs "#on_click = Thing", "#on_change = Thing", "#on_turn_on = Thing", "#on_turn_off = Thing" anywhere
X.guiEvent = function(P, path, b, h)
	local t
	for _, x in ipairs(THINGS) do if x.path == path then t = x break end end
	if not t then return end
	local evs
	if t.typ == "Toggle" or t.typ == "Dropdown" or t.typ == "Slider" or t.typ == "TextBox" then
		evs = {on_change = true}
		if t.typ == "Toggle" then evs[(tonumber(b) or 0) > 0 and "on_turn_on" or "on_turn_off"] = true end
	else evs = {on_click = true} end
	local full, short = N(t.path), N(t.name)
	for _, Q in ipairs(SCRIPTS) do
		if Q ~= P and (Q.alive ~= false or Q.kind == "gui") then
			for _, hd in ipairs(Q.handlers or {}) do
				if evs[hd.ev] and hd.arg and hd.arg ~= "" then
					local a = N(hd.arg)
					if a == full or a == short then table.insert(Q.threads, newThread(hd.ops, h)) end
				end
			end
		end
	end
	-- a GUI thing's own "#on_change" / "#on_turn_on" … #end
	if P and not evs.on_click then
		for _, hd in ipairs(P.handlers or {}) do
			if evs[hd.ev] and hd.ev ~= "on_click" and (not hd.arg or hd.arg == "" or N(hd.arg) == short or N(hd.arg) == full) then table.insert(P.threads, newThread(hd.ops, h)) end
		end
	end
end

end)()
;(function()
-- ===== BuildX's built-in tools (#give_tool = Sword, Speed Coil, Gravity Coil, Flashlight, Rocket) =====
-- In BuildX these are not parts in the place, so Roblox needs real models and the same behaviour.
local BUILTIN = {
	sword = {name = "Sword"}, speedcoil = {name = "Speed Coil"}, gravitycoil = {name = "Gravity Coil"},
	flashlight = {name = "Flashlight"}, rocket = {name = "Rocket"},
}
local function bpart(name, size, color, mat, shape)
	local p = Instance.new("Part"); p.Name = name; p.Size = size; p.Color = color; p.Material = mat or Enum.Material.SmoothPlastic
	p.CanCollide = false; p.Massless = true; p.Anchored = false; p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then p.Shape = shape end
	return p
end
local function attach(tool, hnd, p, cf)
	p.CFrame = hnd.CFrame * cf; p.Parent = tool
	local w = Instance.new("WeldConstraint"); w.Part0 = hnd; w.Part1 = p; w.Parent = p
end
local function buildModel(key, tool)
	local hnd
	if key == "sword" then
		-- grip in the hand, blade pointing up (BuildX: silver metal blade 0.3 x 4 x 0.6)
		hnd = bpart("Handle", Vector3.new(0.3, 1, 0.3), Color3.fromRGB(92, 58, 32), Enum.Material.Wood); hnd.Parent = tool
		attach(tool, hnd, bpart("Blade", Vector3.new(0.18, 3.6, 0.6), Color3.fromRGB(192, 192, 192), Enum.Material.Metal), CFrame.new(0, 2.45, 0))
		attach(tool, hnd, bpart("Tip", Vector3.new(0.18, 0.42, 0.42), Color3.fromRGB(192, 192, 192), Enum.Material.Metal), CFrame.new(0, 4.25, 0) * CFrame.Angles(math.rad(45), 0, 0))
		attach(tool, hnd, bpart("Guard", Vector3.new(0.3, 0.22, 1.5), Color3.fromRGB(120, 120, 128), Enum.Material.Metal), CFrame.new(0, 0.6, 0))
		attach(tool, hnd, bpart("Pommel", Vector3.new(0.4, 0.4, 0.4), Color3.fromRGB(120, 120, 128), Enum.Material.Metal, Enum.PartType.Ball), CFrame.new(0, -0.6, 0))
		tool.Grip = CFrame.new(0, -0.1, 0)
	elseif key == "speedcoil" or key == "gravitycoil" then
		local col = key == "speedcoil" and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(98, 37, 209)
		hnd = bpart("Handle", Vector3.new(1.2, 1.2, 1.2), col, Enum.Material.Neon, Enum.PartType.Cylinder); hnd.Parent = tool
		tool.Grip = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(90))
	elseif key == "flashlight" then
		hnd = bpart("Handle", Vector3.new(0.5, 0.5, 2), Color3.fromRGB(51, 51, 51), Enum.Material.Metal); hnd.Parent = tool
		local lens = bpart("Lens", Vector3.new(0.42, 0.42, 0.06), Color3.fromRGB(255, 244, 200), Enum.Material.Neon)
		attach(tool, hnd, lens, CFrame.new(0, 0, -1.02))
		local l = Instance.new("SpotLight"); l.Name = "Beam"; l.Face = Enum.NormalId.Front; l.Range = 40; l.Angle = 50; l.Brightness = 3; l.Color = Color3.fromRGB(255, 244, 214); l.Enabled = false; l.Parent = hnd
		tool.Grip = CFrame.new(0, 0, 0.4)
	elseif key == "rocket" then
		hnd = bpart("Handle", Vector3.new(0.8, 0.8, 2.4), Color3.fromRGB(255, 255, 255), Enum.Material.Metal); hnd.Parent = tool
		attach(tool, hnd, bpart("Nose", Vector3.new(0.8, 0.8, 0.8), Color3.fromRGB(200, 40, 40), Enum.Material.SmoothPlastic, Enum.PartType.Ball), CFrame.new(0, 0, -1.2))
		tool.Grip = CFrame.new(0, 0, 0)
	end
	return hnd
end
-- built-ins behave like BuildX: the sword hits for 30 within 6 studs in front and knocks back
ITEMS.sword = ITEMS.sword or {usable = true, effect = "Hit", amount = 30, range = 6, knockback = 40, cooldown = 0.35, builtin = true}
ITEMS.rocket = ITEMS.rocket or {usable = true, effect = "None", cooldown = 0.5, builtin = true}
for _, k in ipairs({"speedcoil", "gravitycoil", "flashlight"}) do ITEMS[k] = ITEMS[k] or {builtin = true} end

local baseMake21 = makeTool
makeTool = function(n)
	local tool = baseMake21(n); if not tool then return tool end
	local key = nrm(n); local b = BUILTIN[key]
	if b and not tool:FindFirstChild("Handle") then
		tool.Name = b.name; tool.RequiresHandle = true
		buildModel(key, tool)
		tool:SetAttribute("BuildXBuiltin", key)
		tool:SetAttribute("BuildXGrip0", tool.Grip)
	end
	return tool
end

-- holding a coil or flashlight changes you (BuildX: Speed Coil walk 28, Gravity Coil 0.35 gravity, Flashlight light)
local function heldEffect(h, tool, on)
	local key = tool:GetAttribute("BuildXBuiltin"); if not key or not h.hum then return end
	if key == "speedcoil" then
		if on then h.hum:SetAttribute("BxWalkBefore", h.hum.WalkSpeed); h.hum.WalkSpeed = 28
		else h.hum.WalkSpeed = h.hum:GetAttribute("BxWalkBefore") or 16 end
	elseif key == "gravitycoil" then
		local r = h.root; if not r then return end
		local f = r:FindFirstChild("BuildXGravityCoil")
		if on then
			if not f then
				local a = r:FindFirstChild("RootAttachment") or Instance.new("Attachment", r)
				f = Instance.new("VectorForce"); f.Name = "BuildXGravityCoil"; f.Attachment0 = a; f.RelativeTo = Enum.ActuatorRelativeTo.World; f.ApplyAtCenterOfMass = true; f.Parent = r
			end
			local mass = 0; for _, p in ipairs(h.model:GetDescendants()) do if p:IsA("BasePart") and not p.Massless then mass = mass + p:GetMass() end end
			f.Force = Vector3.new(0, mass * workspace.Gravity * 0.65, 0)
		elseif f then f:Destroy() end
	elseif key == "flashlight" then
		local hd = tool:FindFirstChild("Handle"); local l = hd and hd:FindFirstChild("Beam"); if l then l.Enabled = on end
	end
end
table.insert(HOOK.char, function(h)
	if not h.model then return end
	h.model.ChildAdded:Connect(function(c) if c:IsA("Tool") then heldEffect(h, c, true) end end)
	h.model.ChildRemoved:Connect(function(c) if c:IsA("Tool") then heldEffect(h, c, false) end end)
end)

-- swinging the sword and riding the rocket
local baseUse21 = useItem
useItem = function(h, tool)
	local key = tool:GetAttribute("BuildXBuiltin")
	if key == "rocket" then
		if h.useTs and h.useTs.rocket and NOW - h.useTs.rocket < 0.5 then return end
		h.useTs = h.useTs or {}; h.useTs.rocket = NOW
		if h.root then local v = h.root.AssemblyLinearVelocity; h.root.AssemblyLinearVelocity = Vector3.new(v.X, 140, v.Z); if h.player then Remote:FireClient(h.player, "vel", h.root.AssemblyLinearVelocity) end end
		sfx("whoosh", h.root); fireAll("on_signal", "use_rocket", h)
		return
	end
	local before = h.useTs and h.useTs[key or ""]
	baseUse21(h, tool)
	if key == "sword" and (h.useTs and h.useTs.sword) ~= before and not tool:GetAttribute("BuildXAnims") then
		-- the slash: tip the blade forward, then back
		local g0 = tool:GetAttribute("BuildXGrip0") or tool.Grip
		tool.Grip = g0 * CFrame.Angles(math.rad(80), 0, 0)
		task.delay(0.22, function() if tool.Parent then tool.Grip = g0 end end)
		sfx("swoosh", h.root)
	end
end

end)()
;(function()
-- ===== look exactly like BuildX: labels, bot name tags + health bars, leaderboard columns, cube breaking apart =====
local UI = DATA.ui or {}
local function on(k) return UI[k] ~= false end
-- the client reads these to draw BuildX's HUD (health bar, hotbar, leaderboard, chat log)
for k, v in pairs(UI) do if type(v) ~= "table" then pcall(function() Remote:SetAttribute("ui_" .. k, v) end) end end
if type(UI.hot) == "table" then for k, v in pairs(UI.hot) do pcall(function() Remote:SetAttribute("hot_" .. k, v) end) end end

-- #label: BuildX draws a dark tag with white bold text, the same size at any distance, on top of everything
local function tagGui(host, name, offsetY)
	local g = Instance.new("BillboardGui"); g.Name = name; g.Size = UDim2.new(0, 400, 0, 26); g.AlwaysOnTop = true; g.LightInfluence = 0
	g.StudsOffset = Vector3.new(0, offsetY, 0); g.MaxDistance = 1000; g.ResetOnSpawn = false; g.Parent = host
	return g
end
local function labelText(g)
	local t = g:FindFirstChild("Tag")
	if not t then
		t = Instance.new("TextLabel"); t.Name = "Tag"; t.AnchorPoint = Vector2.new(0.5, 1); t.Position = UDim2.new(0.5, 0, 1, 0)
		t.AutomaticSize = Enum.AutomaticSize.X; t.Size = UDim2.new(0, 0, 0, 22); t.BackgroundColor3 = Color3.new(0, 0, 0); t.BackgroundTransparency = 0.45; t.BorderSizePixel = 0
		t.Font = Enum.Font.GothamBold; t.TextSize = 14; t.TextColor3 = Color3.new(1, 1, 1); t.TextStrokeTransparency = 0.3; t.TextStrokeColor3 = Color3.new(0, 0, 0)
		local pd = Instance.new("UIPadding"); pd.PaddingLeft = UDim.new(0, 6); pd.PaddingRight = UDim.new(0, 6); pd.Parent = t
		t.Parent = g
	end
	return t
end
local LIVE = {}
F("label", function(c, a)
	local b = bp(c) or (c.P.kind == "bot" and c.P.h.root); if not b then return end
	local g = b:FindFirstChild("BuildXLabel"); if g then g:Destroy() end
	g = tagGui(b, "BuildXLabel", b.Size.Y / 2 + 1.5)
	local t = labelText(g); t.Text = tostring(evalExpr(a))
	if tostring(a):find("{", 1, true) or tostring(a):match("[%a_][%w_]*") then LIVE[g] = a end
end)
-- labels with variables keep updating, like BuildX
-- one timer for the repeating checks below (a while-loop would hold the script)
local EVERY = {}
local function every(sec, f) table.insert(EVERY, {sec, 0, f}) end
game:GetService("RunService").Heartbeat:Connect(function(dt) for _, e in ipairs(EVERY) do e[2] = e[2] + dt; if e[2] >= e[1] then e[2] = 0; pcall(e[3]) end end end)
every(0.25, function() for g, a in pairs(LIVE) do if g.Parent then local t = g:FindFirstChild("Tag"); if t then local s = tostring(evalExpr(a)); if t.Text ~= s then t.Text = s end end else LIVE[g] = nil end end end)

-- bots: name above, health bar under it (70 x 9 px, green / yellow / red, "hp / max")
local function botTag(h)
	if not h.model or not h.root or h.model:FindFirstChild("BuildXTag", true) then return end
	local sz = h.root.Size.Y
	local g = Instance.new("BillboardGui"); g.Name = "BuildXTag"; g.Size = UDim2.new(0, 200, 0, 40); g.AlwaysOnTop = true; g.LightInfluence = 0; g.MaxDistance = 1000
	g.StudsOffset = Vector3.new(0, sz * 2 - sz / 2, 0); g.Parent = h.root
	if on("botNames") then
		local n = Instance.new("TextLabel"); n.Name = "Name"; n.BackgroundTransparency = 1; n.Size = UDim2.new(1, 0, 0, 18); n.Position = UDim2.new(0, 0, 0, on("botHP") and 6 or 22)
		n.Font = Enum.Font.GothamBold; n.TextSize = 14; n.TextColor3 = Color3.new(1, 1, 1); n.TextStrokeTransparency = 0.3; n.Text = h.name or h.model.Name; n.Parent = g
	end
	if on("botHP") and h.hum then
		local box = Instance.new("Frame"); box.Name = "HP"; box.AnchorPoint = Vector2.new(0.5, 0); box.Position = UDim2.new(0.5, 0, 0, 25); box.Size = UDim2.new(0, 74, 0, 13)
		box.BackgroundColor3 = Color3.new(0, 0, 0); box.BackgroundTransparency = 0.35; box.BorderSizePixel = 0; box.Parent = g
		local bg = Instance.new("Frame"); bg.Name = "Back"; bg.Position = UDim2.new(0, 2, 0, 2); bg.Size = UDim2.new(1, -4, 1, -4); bg.BackgroundColor3 = Color3.fromRGB(90, 13, 13); bg.BorderSizePixel = 0; bg.Parent = box
		local fill = Instance.new("Frame"); fill.Name = "Fill"; fill.BorderSizePixel = 0; fill.Parent = bg
		local tx = Instance.new("TextLabel"); tx.BackgroundTransparency = 1; tx.Size = UDim2.new(1, 0, 1, 0); tx.Font = Enum.Font.GothamBlack; tx.TextSize = 8; tx.TextColor3 = Color3.new(1, 1, 1); tx.ZIndex = 2; tx.Parent = bg
		local function upd()
			local mx = math.max(1, h.hum.MaxHealth); local k = math.clamp(h.hum.Health / mx, 0, 1)
			fill.Size = UDim2.new(k, 0, 1, 0)
			fill.BackgroundColor3 = k > 0.5 and Color3.fromRGB(61, 220, 107) or k > 0.25 and Color3.fromRGB(255, 204, 51) or Color3.fromRGB(255, 71, 87)
			tx.Text = math.ceil(math.max(0, h.hum.Health)) .. " / " .. math.floor(mx)
		end
		upd(); h.hum.HealthChanged:Connect(upd); h.hum:GetPropertyChangedSignal("MaxHealth"):Connect(upd)
	end
	if h.hum then h.hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
end
for _, h in ipairs(BOTS) do pcall(botTag, h) end
every(1, function() for _, h in ipairs(BOTS) do if h.model and h.model.Parent and not h.dead then pcall(botTag, h) end end end)

-- the leaderboard shows Coins, Kills and Deaths like BuildX
local function lbStats(h)
	if not (DATA.leaderboard and h.player) then return end
	for _, k in ipairs({"kills", "deaths"}) do if on(k == "kills" and "lbKills" or "lbDeaths") then setStat(h, k, h.stats[k] or 0) end end
end
for _, h in ipairs(HUMANS) do pcall(lbStats, h) end
Players.PlayerAdded:Connect(function(plr) task.defer(function() local h = PLAYER_H[plr]; if h then lbStats(h) end end) end)

-- dying: the cube breaks into small cubes (BuildX: 1.35-stud chunks that fly apart)
table.insert(HOOK.died, function(h)
	if h.player and DATA.leaderboard and on("lbDeaths") then setStat(h, "deaths", h.stats.deaths or 0) end
	local m = h.model; if not m or h.player then return end  -- players keep Roblox's own avatar and death
	local body = m:FindFirstChild("Body") or (h.kind == "bot" and h.root)
	if not body or not body:IsA("BasePart") then return end
	local at = body.Position; local col = body.Color; local mat = body.Material; local s = body.Size.X / 3
	for _, p in ipairs(m:GetDescendants()) do if p:IsA("BasePart") then p.Transparency = 1 elseif p:IsA("BillboardGui") then p.Enabled = false end end
	for i = 1, 6 do
		local c = Instance.new("Part"); c.Name = "Chunk"; c.Size = Vector3.new(1.35, 1.35, 1.35) * s; c.Color = col; c.Material = mat
		c.TopSurface = Enum.SurfaceType.Smooth; c.BottomSurface = Enum.SurfaceType.Smooth
		local a = i / 6 * math.pi * 2
		c.CFrame = CFrame.new(at + Vector3.new(math.cos(a), (i % 2) * 0.8, math.sin(a)) * s * 0.8) * CFrame.Angles(math.random() * 3, math.random() * 3, 0)
		c.Parent = workspace
		c.AssemblyLinearVelocity = Vector3.new(math.cos(a) * 14, 18 + math.random() * 8, math.sin(a) * 14)
		Debris:AddItem(c, 3)
	end
end)

-- cubes roll like in BuildX: the root moves (hidden), a welded Body shows the cube and the client rolls it.
-- Commands still colour / hide the root, so those changes are passed on to the Body.
local function cubeBody(h)
	local m, r = h.model, h.root
	if not m or not r or m:FindFirstChild("Body") then return end
	local b = Instance.new("Part"); b.Name = "Body"; b.Size = r.Size; b.Color = r.Color; b.Material = r.Material; b.Reflectance = r.Reflectance; b.Transparency = r.Transparency
	b.CanCollide = false; b.CanQuery = false; b.CanTouch = false; b.Massless = true; b.Anchored = false; b.CFrame = r.CFrame
	b.TopSurface = Enum.SurfaceType.Smooth; b.BottomSurface = Enum.SurfaceType.Smooth
	for _, k in ipairs(r:GetChildren()) do if k:IsA("Decal") or k:IsA("Texture") or k:IsA("SurfaceGui") then k.Parent = b end end
	local w = Instance.new("Weld"); w.Name = "BodyWeld"; w.Part0 = r; w.Part1 = b; w.Parent = b
	b.Parent = m; r.Transparency = 1
end
local MIRRORED = setmetatable({}, {__mode = "k"})
local function mirror(h)
	local m, r = h.model, h.root; if not m or not r or MIRRORED[r] then return end
	local b = m:FindFirstChild("Body"); if not b then return end
	MIRRORED[r] = true
	for _, k in ipairs({"Color", "Material", "Reflectance"}) do r:GetPropertyChangedSignal(k):Connect(function() if b.Parent then b[k] = r[k] end end) end
	r:GetPropertyChangedSignal("Size"):Connect(function() if b.Parent then b.Size = r.Size end end)
	r:GetPropertyChangedSignal("Transparency"):Connect(function() if r.Transparency < 1 and b.Parent then b.Transparency = r.Transparency; r.Transparency = 1 end end)
	-- the player's colour comes from the cube (Body), so read and write it there
	if h.player then r.Color = b.Color; r.Material = b.Material end
end
local function cube(h) if h.kind == "bot" then pcall(cubeBody, h) end pcall(mirror, h) end
for _, h in ipairs(BOTS) do cube(h) end
for _, h in ipairs(HUMANS) do pcall(mirror, h) end
table.insert(HOOK.char, function(h) task.defer(function() pcall(mirror, h) end) end)
every(0.5, function() for _, h in ipairs(BOTS) do if h.model and h.model.Parent and not h.dead then cube(h) end end end)

-- meshes still as blocks (the Mesh Maker plugin was not used): each player's game collides with the real
-- shape (made on their side). The server tells them when a command turns collision on or off.
do
	local function watch(ph)
		if not ph or not ph:IsA("BasePart") then return end
		ph:SetAttribute("BxCollide", ph.CanCollide)
		ph:GetPropertyChangedSignal("CanCollide"):Connect(function() ph:SetAttribute("BxCollide", ph.CanCollide) end)
	end
	for _, d in ipairs(workspace:GetDescendants()) do if d.Name == "BuildXMesh" then watch(d.Parent) end end
	for _, d in ipairs(game:GetService("ServerStorage"):GetDescendants()) do if d.Name == "BuildXMesh" then watch(d.Parent) end end
	workspace.DescendantAdded:Connect(function(d) if d.Name == "BuildXMesh" then watch(d.Parent) end end)
end

end)()
-- ===== prompts, spawners and a few more =====
local function promptFor(P, text)
	local inst = P.inst
	local host = inst and (inst:IsA("BasePart") and inst or (P.kind == "bot" and P.h.root) or (inst:IsA("Model") and inst.PrimaryPart))
	if not host then return end
	local pp = host:FindFirstChild("BuildXPrompt")
	if not pp then
		pp = Instance.new("ProximityPrompt"); pp.Name = "BuildXPrompt"; pp.MaxActivationDistance = 10; pp.RequiresLineOfSight = false; pp.Parent = host
		pp.Triggered:Connect(function(plr) fire(P, "on_prompt", nil, PLAYER_H[plr]) end)
	end
	pp.ActionText = text ~= "" and text or "Use"
end
DATA._promptFor = promptFor
F("prompt", function(c, a) promptFor(c.P, tostring(evalExpr(a))) end)
F("prompt_distance", function(c, a) local i = c.P.inst; local host = i and (i:IsA("BasePart") and i or (c.P.kind == "bot" and c.P.h.root)); local pp = host and host:FindFirstChild("BuildXPrompt"); if pp then pp.MaxActivationDistance = num(a, 10) end end)
F("click_distance", function(c, a) local i = c.P.inst; local cd = i and i:FindFirstChildOfClass("ClickDetector"); if cd then cd.MaxActivationDistance = num(a, 32) end end)
F("play_animation", function() end); F("stop_animation", function() end)
H("play_animation", function() end, true); H("stop_animation", function() end, true)
H("jump_every", function(c, h, a)
	local t = parseTime(a ~= "" and a or "1")
	local function again() if alive(h) then h.hum.Jump = true; table.insert(LATER, {NOW + t, again}) end end
	again()
end, true)
local function groundAt(x, z, from)
	local params = RaycastParams.new()
	local r = workspace:Raycast(Vector3.new(x, from + 200, z), Vector3.new(0, -600, 0), params)
	return r and r.Position or Vector3.new(x, from, z)
end
local spawned = {}
F("spawn_randomly", function(c, a)
	local list, every = a:match("^([^:]*):?(.*)$")
	local names = {}
	for n in (list or ""):gmatch("[^,]+") do table.insert(names, trim(n)) end
	if #names == 0 then return end
	local t = trim(every) ~= "" and parseTime(every) or 3
	local center = ownerPos(c)
	local function tick()
		for _, n in ipairs(names) do
			spawned[n] = spawned[n] or {}
			local live = {}
			for _, i in ipairs(spawned[n]) do if i.Parent then table.insert(live, i) end end
			spawned[n] = live
			if #live < 30 then
				local storage = ServerStorage:FindFirstChild("Storage")
				local src
				for _, d in ipairs(storage and storage:GetDescendants() or {}) do if nrm(d.Name) == nrm(n) and (d:IsA("BasePart") or d:IsA("Model")) then src = d break end end
				if src then
					local g = groundAt(center.X + math.random(-60, 60), center.Z + math.random(-60, 60), center.Y)
					local i = src:Clone(); i.Parent = workspace
					local hgt = i:IsA("BasePart") and i.Size.Y / 2 or 1
					if i:IsA("Model") then i:PivotTo(CFrame.new(g + Vector3.new(0, hgt, 0))) else i.Position = g + Vector3.new(0, hgt, 0) end
					local cv = i:FindFirstChild("BuildXCode")
					registerThing(i, cv and cv.Value or nil, i:IsA("Model") and "model" or "part", true)
					table.insert(spawned[n], i)
				end
			end
		end
		table.insert(LATER, {NOW + t, tick})
	end
	tick()
end)
alias("randomly_spawn", "spawn_randomly")

---------------------------------------------------------------- setting things up
local function decode(s)
	if not s or s == "" then return nil end
	local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
	if ok then return t end
	warn("[BuildX] could not read some code: " .. tostring(t))
	return nil
end

local function attach(P, code)
	P.threads = P.threads or {}; P.handlers = P.handlers or {}; P.rules = P.rules or {}; P.funcs = P.funcs or {}
	P.beh = P.beh or {}; P.f = P.f or {}; P.tw = P.tw or {}
	if not code then return end
	for _, h in ipairs(code.handlers or {}) do table.insert(P.handlers, h) end
	for k, f in pairs(code.funcs or {}) do P.funcs[k] = f end
	for _, r in ipairs(code.rules or {}) do table.insert(P.rules, shallow(r)) end
	-- a GUI thing's plain code runs when it is clicked (like in BuildX), not when the game starts
	if code.main and #code.main > 0 then if P.kind == "gui" then P.clickMain = code.main else table.insert(P.threads, newThread(code.main, nil, true)) end end
end

local function newBotH(model, P)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local h = {kind = "bot", model = model, hum = hum, root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart, name = (hum and hum.DisplayName ~= "" and hum.DisplayName) or model.Name,
		stats = {}, items = {}, size = 1, P = P, ai = {mode = A(model, "BuildXBehavior") or "Idle"}, home = nil}
	h.home = h.root and h.root.Position
	h.attack = A(model, "BuildXAttack")
	if hum then hum.Died:Connect(function()
		h.stats.deaths = (h.stats.deaths or 0) + 1
		fireAll("on_death", nil, h); fireAll("on_bot_death", nil, h)
		for _, f in ipairs(HOOK.died) do pcall(f, h) end
		if h.respawn ~= false and (A(model, "BuildXRespawn") or h.respawn) then
			local copy = DATA._botCopies[model]
			task.delay(h.respawnT or 3, function() if copy then local m = copy:Clone(); m.Parent = model.Parent or workspace; model:Destroy(); registerThing(m, P.codeJSON, "bot", false) end end)
		else Debris:AddItem(model, 3) end
	end) end
	return h
end

DATA._botCopies = {}
registerThing = function(inst, codeJSON, kind, fresh)
	local P = {kind = kind, inst = inst, name = inst.Name, alive = true, codeJSON = codeJSON, touches = 0, clicks = 0}
	attach(P, decode(codeJSON))
	if kind == "bot" then
		P.h = newBotH(inst, P)
		table.insert(BOTS, P.h); table.insert(HUMANS, P.h)
	elseif kind == "part" or kind == "model" then
		readPart(P)
		P.home = {P.pos, P.ori}
	elseif kind == "gui" then
		P.gpath = A(inst, "BuildXPath"); P.vis = inst.Visible
	end
	-- clicking: a ClickDetector when the code listens for clicks
	local wantsClick = false
	for _, h in ipairs(P.handlers) do if h.ev == "on_click" then wantsClick = true end if h.ev == "on_prompt" then P.prompt = true end end
	if wantsClick and kind ~= "gui" then
		local host = inst:IsA("BasePart") and inst or (kind == "bot" and P.h.root) or inst
		local cd = host:FindFirstChildOfClass("ClickDetector") or Instance.new("ClickDetector")
		cd.MaxActivationDistance = 40; cd.Parent = host
		cd.MouseClick:Connect(function(plr) local h = PLAYER_H[plr]; P.clicks = (P.clicks or 0) + 1; fire(P, "on_click", nil, h); sfx("click", inst:IsA("BasePart") and inst or nil) end)
	end
	if P.prompt and kind ~= "gui" then promptFor(P, "Use") end
	table.insert(SCRIPTS, P)
	addName(P)
	if fresh then fire(P, "on_spawn", nil, nil) end
	return P
end

lightP = function(w)
	local k = nrm(w)
	for _, d in ipairs(workspace:GetDescendants()) do
		if (d:IsA("BasePart") or (d:IsA("Model") and not d:FindFirstChildOfClass("Humanoid"))) and nrm(d.Name) == k and not hOf(d) and not (d.Parent and d.Parent:FindFirstChildOfClass("Humanoid")) then
			return registerThing(d, nil, d:IsA("Model") and "model" or "part", false)
		end
	end
	return nil
end
-- every part / model / bot that came from BuildX
local function scan(root, inStorage)
	for _, d in ipairs(root:GetDescendants()) do
		local cv = d:FindFirstChild("BuildXCode")
		local isThing = A(d, "BuildXKind")
		if isThing and not inStorage then
			local kind = isThing
			if kind == "bot" then DATA._botCopies[d] = d:Clone() end
			registerThing(d, cv and cv.Value or nil, kind, false)
		end
	end
end
scan(workspace, false)

-- the Scripts folder (code that is not on a part)
local sfolder = script.Parent:FindFirstChild("BuildXScripts")
if sfolder then for _, v in ipairs(sfolder:GetChildren()) do
	if v:IsA("StringValue") and v.Name ~= "BuildXSource" then
		local P = {kind = "script", inst = v, name = v.Name, alive = true}
		attach(P, decode(v.Value)); table.insert(SCRIPTS, P)
	end
end end

-- GUI things with code (their clicks come from the players' screens)
local GUIP = {}
for _, sg in ipairs(StarterGui:GetChildren()) do
	if sg:IsA("LayerCollector") and A(sg, "BuildXGui") then
		for _, d in ipairs(sg:GetDescendants()) do
			if d:IsA("GuiObject") and A(d, "BuildXPath") then
				local cv = d:FindFirstChild("BuildXCode")
				local P = {kind = "gui", inst = d, name = d.Name, alive = true}
				P.gpath = A(d, "BuildXPath"); P.vis = d.Visible
				attach(P, decode(cv and cv.Value or nil))
				GUIP[P.gpath] = P
				table.insert(SCRIPTS, P); addName(P)
			end
		end
	end
end
guiThingState = function(Q, c)
	local h = whoH(c)
	local vis = Q.vis
	if h and h.guiVis and h.guiVis[Q.gpath] ~= nil then vis = h.guiVis[Q.gpath] end
	return {visible = vis, invisible = not vis, shown = vis, hidden = not vis, open = vis, closed = not vis}
end

-- the item "holder" runs the code of items whose effect is Run code
DATA._itemP = {kind = "script", name = "Items", alive = true, threads = {}, handlers = {}, rules = {}, funcs = {}, beh = {}, f = {}}
table.insert(SCRIPTS, DATA._itemP)
for k, info in pairs(ITEMS) do if info.codeJSON then info.code = decode(info.codeJSON) end end

---------------------------------------------------------------- players
local function setupPlayer(plr)
	local h = {kind = "player", player = plr, name = plr.DisplayName, stats = {}, items = {}, keys = {}, size = 1, guiVis = {}}
	PLAYER_H[plr] = h
	table.insert(HUMANS, h)
	local ls = Instance.new("Folder"); ls.Name = "leaderstats"
	if DATA.leaderboard or DATA.usesCoins then local cv = Instance.new("NumberValue"); cv.Name = "Coins"; cv.Parent = ls end
	ls.Parent = plr
	local function onChar(ch)
		h.model = ch; h.hum = ch:WaitForChild("Humanoid"); h.root = ch:WaitForChild("HumanoidRootPart")
		h.size = 1; h.won = false; h.baseWalk = nil
		h.hum.WalkSpeed = DATA.walkSpeed or 16
		h.hum.UseJumpPower = true; h.hum.JumpPower = (DATA.jumpPower or 50) * JPK
		if h.checkpoint then task.defer(function() if h.model == ch then ch:PivotTo(CFrame.new(h.checkpoint + Vector3.new(0, 3, 0))) end end) end
		local respawned = h.spawnedOnce
		h.spawnedOnce = true
		h.hum.Died:Connect(function()
			h.stats.deaths = (h.stats.deaths or 0) + 1
			fireAll("on_death", nil, h)
			for _, f in ipairs(HOOK.died) do pcall(f, h) end
		end)
		for _, f in ipairs(HOOK.char) do pcall(f, h, respawned) end
		h.hum.StateChanged:Connect(function(_, new)
			if new == Enum.HumanoidStateType.Jumping then fireAll("on_jump", nil, h)
			elseif new == Enum.HumanoidStateType.Landed then fireAll("on_land", nil, h) end
		end)
		if respawned then fireAll("on_respawn", nil, h) end
	end
	plr.CharacterAdded:Connect(onChar)
	if plr.Character then onChar(plr.Character) end
	plr.Chatted:Connect(function(msg) fireAll("on_chat", lower(trim(msg)), h) end)
end
Players.PlayerAdded:Connect(setupPlayer)
for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerRemoving:Connect(function(p)
	local h = PLAYER_H[p]; PLAYER_H[p] = nil
	for i, x in ipairs(HUMANS) do if x == h then table.remove(HUMANS, i) break end end
end)

Remote.OnServerEvent:Connect(function(plr, kind, a, b)
	local h = PLAYER_H[plr]; if not h then return end
	if kind == "key" then local k = lower(tostring(a)); h.keys[k] = b and true or nil; if b then fireAll("on_key", k, h) end
	elseif kind == "gclick" then local P = GUIP[tostring(a)]; if P then
		if P.clickMain then table.insert(P.threads, newThread(P.clickMain, h)) end
		fire(P, "on_click", nil, h); if b ~= nil then fire(P, "on_choice", tostring(b), h) end end
		if X.guiEvent then X.guiEvent(P, tostring(a), b, h) end
	elseif kind == "var" then local k = lower(tostring(a)); if k ~= "" and not k:match("^__") then VARS[k] = b end
	elseif kind == "gvis" then h.guiVis[tostring(a)] = b and true or false
	elseif kind == "use" then local t = h.model and h.model:FindFirstChildOfClass("Tool"); if t then useItem(h, t) end end
end)

---------------------------------------------------------------- the game loop
local WHO_WORDS = {toucher = 1, touched = 1, who = 1, them = 1, someone = 1, somebody = 1, anyone = 1, anybody = 1, it_player = 1}
local function isWhoCond(s)
	s = lower(trim(s))
	if inSet(s, "touch", "touched", "touching", "is_touched") then return true end
	local a, b = s:match("^([%w_]+)%s*==?%s*([%w_]+)$")
	if a and WHO_WORDS[a] and inSet(b, "touch", "touches", "touching", "touched") then return true end
	if s:find("%f[%w_]toucher%f[^%w_]") then return true end
	return false
end

local acc, lastVars = 0, 0
local function partBehaviors(P, dt)
	local B = P.beh
	if not P.pos or not P.inst or not P.inst.Parent then return end
	local moved = false
	local t = NOW
	if B.spin then P.ori = P.ori + B.spin * dt; moved = true end
	if B.bob then P.bobBase = P.bobBase or P.pos.Y; P.pos = Vector3.new(P.pos.X, P.bobBase + math.sin(t * 2) * B.bob, P.pos.Z); moved = true end
	if B.patrol then local pt = B.patrol; pt.ph = pt.ph + dt; local u = 0.5 - 0.5 * math.cos(pt.ph / pt.t * math.pi); P.pos = pt.o + pt.d * u; moved = true end
	if B.orbit then P.pos = B.orbit.o + Vector3.new(math.cos(t) * B.orbit.r, 0, math.sin(t) * B.orbit.r); moved = true end
	if B.swing then P.ori = B.swing.o + Vector3.new(0, 0, math.sin(t * 2) * B.swing.amt); moved = true end
	if B.follow or B.chase or B.flee then
		local tt = targets("nearest", {P = P}); local o = tt and tt.h and tt.h[1]
		if o and o.player then
			local d = hpos(o) - P.pos; d = Vector3.new(d.X, 0, d.Z); local L = d.Magnitude
			if L > 0.01 then
				local s = B.follow or B.chase or -B.flee
				if not (B.follow and L < 6) and not (B.flee and L >= 30) then P.pos = P.pos + d / L * s * dt; moved = true end
			end
		end
	end
	if B.look then local tt = targets("nearest", {P = P}); local o = tt and tt.h and tt.h[1]; if o then local d = hpos(o) - P.pos; P.ori = Vector3.new(0, math.deg(math.atan2(-d.X, -d.Z)), 0); moved = true end end
	if B.tilt then P.ori = Vector3.new(math.sin(t * 1.3) * 6, P.ori.Y, math.cos(t * 1.1) * 6); moved = true end
	if B.rainbow then local col = Color3.new(0.5 + 0.5 * math.sin(t * 2), 0.5 + 0.5 * math.sin(t * 2 + 2), 0.5 + 0.5 * math.sin(t * 2 + 4)); eachPart({P = P}, function(p) p.Color = col end) end
	if B.blink then local off = math.floor(t / B.blink) % 2 == 1; eachPart({P = P}, function(p) p.Transparency = off and 1 or 0; p.CanCollide = not off and p:GetAttribute("bxC") ~= false end) end
	if B.pulse then local b = bp({P = P}); if b then b.Size = B.pulse.base * (1 + math.sin(t * 4) * B.pulse.amt) end end
	if B.flicker then local b = bp({P = P}); local l = b and (b:FindFirstChild("BuildXLight") or b:FindFirstChild("BuildXGlow")); if l then l.Enabled = math.random() > 0.1 end end
	for i = #P.tw, 1, -1 do
		local w = P.tw[i]
		w.t = w.t + dt
		local u = math.min(1, w.t / w.dur)
		local e = w.prop == "pos" and (0.5 - 0.5 * math.cos(u * math.pi)) or (1 - (1 - u) * (1 - u))
		if w.prop == "pos" then P.pos = w.from:Lerp(w.to, e); moved = true
		elseif w.prop == "Transparency" then local v = w.from + (w.to - w.from) * e; eachPart({P = P}, function(p) p.Transparency = v; p.CanCollide = v < 0.99 and p:GetAttribute("bxC") ~= false end) end
		if u >= 1 then table.remove(P.tw, i) end
	end
	if P.shakeT and P.shakeT > NOW then local b = bp({P = P}); if b and b.Anchored then b.CFrame = b.CFrame + Vector3.new((math.random() - 0.5) * 0.3, 0, (math.random() - 0.5) * 0.3) end end
	P.moving = moved
	if moved then
		local b = P.inst
		local old = b:IsA("BasePart") and b.Position
		syncPart(P)
		if old and b.Anchored and dt > 0 then b.AssemblyLinearVelocity = (b.Position - old) / dt end
	end
	if P.f.conv and P.inst:IsA("BasePart") then P.inst.AssemblyLinearVelocity = P.inst.CFrame.LookVector * P.f.conv end
end

local function botStep(b, dt)
	if not alive(b) or not b.hum then return end
	b.aiT = (b.aiT or 0) - dt
	if b.aiT > 0 then return end
	b.aiT = 0.25
	local ai = b.ai or {mode = "Idle"}
	local mode = ai.mode
	local near, nd = nil, math.huge
	for _, h in ipairs(humans()) do if h.player and alive(h) then local d = (hpos(h) - hpos(b)).Magnitude; if d < nd then nd = d; near = h end end end
	if mode == "Chase" or (mode == "Guard" and near and nd < 30) then if near then b.hum:MoveTo(hpos(near)) end
	elseif mode == "Follow" then if near and nd > 6 then b.hum:MoveTo(hpos(near)) else b.hum:MoveTo(hpos(b)) end
	elseif mode == "Flee" then if near and nd < 30 then b.hum:MoveTo(hpos(b) + (hpos(b) - hpos(near)).Unit * 12) end
	elseif mode == "Wander" then if math.random() < 0.15 then b.hum:MoveTo((b.home or hpos(b)) + Vector3.new(math.random(-20, 20), 0, math.random(-20, 20))) end
	elseif mode == "Patrol" and ai.d then ai.flip = not ai.flip; if not ai.next or ai.next < NOW then ai.next = NOW + 3; b.hum:MoveTo(ai.flip and (ai.home + ai.d) or ai.home) end
	elseif mode == "Guard" then b.hum:MoveTo(ai.home or b.home or hpos(b))
	elseif mode == "Goto" and ai.goal then b.hum:MoveTo(ai.goal) end
	-- bots touching people (zombies and such)
	if b.attack and near and nd < 3.7 * math.max(near.size or 1, b.size or 1) then
		b.cd = b.cd or {}
		if NOW >= (b.cd[near] or 0) then b.cd[near] = NOW + 0.8; hurtHumanoid(near, b.attack, b) end
	end
end

local zoneState = {}
local function zones(P, dt)
	local f = P.f
	if not next(f) and not P.collect then return end
	for h in pairs(P.touching or {}) do
		if f.hz and alive(h) then h.hum.Health = math.min(h.hum.MaxHealth, h.hum.Health + f.hz * dt) end
		if f.dz and not ((h.shieldT or 0) > NOW or h.god) then h.hum:TakeDamage(f.dz * dt) end
		if f.water and h.root then local v = h.root.AssemblyLinearVelocity; if v.Y < -8 then h.root.AssemblyLinearVelocity = Vector3.new(v.X * 0.9, -8, v.Z * 0.9) end if h.hum.Jump then h.root.AssemblyLinearVelocity = Vector3.new(v.X, 16, v.Z) end end
		if f.lowg and h.root then h.root.AssemblyLinearVelocity = h.root.AssemblyLinearVelocity + Vector3.new(0, workspace.Gravity * 0.7 * dt, 0) end
		if f.ladder and h.root and h.hum.MoveDirection.Magnitude > 0.1 then local v = h.root.AssemblyLinearVelocity; h.root.AssemblyLinearVelocity = Vector3.new(v.X, 12, v.Z) end
		if f.wind and h.root then h.root.AssemblyLinearVelocity = h.root.AssemblyLinearVelocity + f.wind * dt end
		if f.jboost and h.hum then h.hum.JumpPower = 100 * JPK end
		if f.nojump and h.hum then h.hum.Jump = false end
		local key = tostring(P) .. tostring(h)
		if (f.sz or f.sticky) and h.hum and not zoneState[key] then zoneState[key] = h.hum.WalkSpeed; h.hum.WalkSpeed = f.sz or 4 end
		if P.collect and h.player and P.alive then
			P.alive = false
			giveTool(h, P.name, 1)
			sfx("pop", h.root)
			if h.player then send({player = h.player}, "toast", "Got " .. P.name .. "!") end
			fireAll("on_signal", "got_" .. nrm(P.name), h)
			P.inst:Destroy()
		end
	end
	for key, sp in pairs(zoneState) do
		if key:sub(1, #tostring(P)) == tostring(P) then
			local still = false
			for h in pairs(P.touching or {}) do if tostring(P) .. tostring(h) == key then still = true end end
			if not still then
				for _, h in ipairs(HUMANS) do if tostring(P) .. tostring(h) == key and h.hum then h.hum.WalkSpeed = sp end end
				zoneState[key] = nil
			end
		end
	end
end

local started = false
RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 0.1) * AUDIO.ts
	NOW = NOW + dt
	for _, f in ipairs(STEPS) do local ok, e = pcall(f, dt); if not ok then warnOnce("s" .. tostring(e), tostring(e)) end end
	if not started then started = true; fireAll("on_start", nil, nil) end
	if DATA._timerRun then VARS.__timer = (VARS.__timer or 0) + dt end
	if DATA._dayCycle then Lighting.ClockTime = (Lighting.ClockTime + dt * DATA._dayCycle * 24 / 600) % 24 end
	-- timed things
	for i = #LATER, 1, -1 do local L = LATER[i]; if L[1] <= NOW then table.remove(LATER, i); pcall(L[2]) end end
	-- who touches what
	for _, P in ipairs(SCRIPTS) do
		if (P.kind == "part" or P.kind == "model") and P.alive then
			local before = P.touching or {}
			computeTouching(P)
			for h in pairs(P.touching) do if not before[h] then P.touches = (P.touches or 0) + 1; fire(P, "on_touch", nil, h) end end
			for h in pairs(before) do if not P.touching[h] then fire(P, "on_touch_end", nil, h) end end
			zones(P, dt)
		end
	end
	-- bots touching people fire the bot's on_touch
	for _, b in ipairs(BOTS) do
		if alive(b) and b.P then
			for _, o in ipairs(humans()) do
				if o ~= b and alive(o) and (hpos(o) - hpos(b)).Magnitude < 3.7 * math.max(o.size or 1, b.size or 1) then
					b.tcd = b.tcd or {}
					if NOW >= (b.tcd[o] or 0) then b.tcd[o] = NOW + 0.8; fire(b.P, "on_touch", nil, o) end
				end
			end
		end
		botStep(b, dt)
	end
	-- near / far / health / score / timer
	for _, P in ipairs(SCRIPTS) do
		if P.alive ~= false then
			local pos = (P.kind == "bot" and P.h and P.h.root and hpos(P.h)) or ((P.kind == "part" or P.kind == "model") and P.pos) or nil
			for _, hd in ipairs(P.handlers or {}) do
				for _, h in ipairs(humans()) do
					if h.player and alive(h) then
						if (hd.ev == "on_near" or hd.ev == "on_far") and pos then
							local rr = tonumber(evalExpr(hd.arg)) or 10
							local inn = (hpos(h) - pos).Magnitude < rr
							hd._n = hd._n or {}
							local was = hd._n[h]
							if was ~= nil then
								if hd.ev == "on_near" and inn and not was then table.insert(P.threads, newThread(hd.ops, h)) end
								if hd.ev == "on_far" and not inn and was then table.insert(P.threads, newThread(hd.ops, h)) end
							end
							hd._n[h] = inn
						elseif hd.ev == "on_health" then
							local lim = tonumber(hd.arg) or 30
							hd._f = hd._f or {}
							if h.hum.Health < lim and not hd._f[h] then hd._f[h] = true; table.insert(P.threads, newThread(hd.ops, h)) end
							if h.hum.Health >= lim then hd._f[h] = nil end
						elseif hd.ev == "on_score" then
							local lim = tonumber(hd.arg) or 10
							hd._f = hd._f or {}
							if math.max(SCORE, h.stats.coins or 0) >= lim and not hd._f[h] then hd._f[h] = true; table.insert(P.threads, newThread(hd.ops, h)) end
						end
					end
				end
				if hd.ev == "on_timer" and not hd._t and NOW >= parseTime(hd.arg) then hd._t = true; table.insert(P.threads, newThread(hd.ops, nil)) end
			end
		end
	end
	-- the code: rules that keep watching, then every running thread
	for _, P in ipairs(SCRIPTS) do
		if P.alive ~= false or P.kind == "gui" then
			if P.kind == "part" or P.kind == "model" then partBehaviors(P, dt) end
			for _, r in ipairs(P.rules or {}) do
				local ops = r.ops or {r.op}
				if r.each == nil then r.each = (P.kind == "part" or P.kind == "bot" or P.kind == "model") and isWhoCond(r.cond) end
				if r.each then
					r.lastH = r.lastH or {}
					for _, h in ipairs(humans()) do
						if not (P.kind == "bot" and h == P.h) then
							local ok, v = pcall(cond, {P = P, who = h, direct = true, each = true}, r.cond)
							v = ok and v or false
							if r.neg then v = not v end
							if v and not r.lastH[h] then table.insert(P.threads, newThread(ops, h)) end
							r.lastH[h] = v
						end
					end
				else
					local firstP = nil
					for _, h in ipairs(humans()) do if h.player then firstP = h break end end
					local ok, v = pcall(cond, {P = P, who = firstP, direct = true}, r.cond)
					v = ok and v or false
					if r.neg then v = not v end
					if v and not r.last then
						local who = r.cond:lower():find("bot") and nil or firstP
						if P.touching then for h in pairs(P.touching) do who = h break end end
						table.insert(P.threads, newThread(ops, who))
					end
					r.last = v
				end
			end
			local keep = {}
			for _, th in ipairs(P.threads) do
				local ok, err = pcall(runThread, P, th, dt)
				if not ok then warnOnce("r" .. tostring(err), P.name .. ": " .. tostring(err)); th.done = true end
				if not th.done then table.insert(keep, th) end
			end
			P.threads = keep
		end
	end
	-- signals sent with #send also start "#do = on = signal" lines
	-- send the variables to the screens a few times a second (for {coins} in GUI text)
	lastVars = lastVars + dt
	if lastVars > 0.25 then
		lastVars = 0
		for _, h in ipairs(humans()) do
			if h.player then
				local v = {}
				for k, x in pairs(VARS) do if type(x) == "table" then v[k] = TS(x) else v[k] = x end end
				for k, x in pairs(h.stats) do v[k] = x end
				v.score = SCORE; v.health = h.hum and math.floor(h.hum.Health + 0.5) or 0; v.time = math.floor(NOW); v.timer = math.floor((VARS.__timer or 0) * 10) / 10
				v.coins = h.stats.coins or 0; v.gems = h.stats.gems or 0
				Remote:FireClient(h.player, "vars", v)
			end
		end
	end
end)

-- #send = x also reaches lines written as "#thing = on = signal = x"
local oldFireAll = fireAll
fireAll = function(ev, arg, who)
	oldFireAll(ev, arg, who)
	if ev == "on_signal" then
		for _, P in ipairs(SCRIPTS) do
			for _, s in ipairs(P.signals or {}) do if s[1] == lower(tostring(arg)) then table.insert(P.threads, newThread(s[2], who)) end end
		end
	end
end

-- respawns go to the last checkpoint (handled in setupPlayer); the respawn time from BuildX
Players.RespawnTime = DATA.respawnTime or 3

-- for automatic tests outside Roblox (does nothing in a real game)
if _G and _G.BUILDX_TEST then
	_G.BUILDX_TEST.register = registerThing
	_G.BUILDX_TEST.vars = function() return VARS end
	_G.BUILDX_TEST.reset = function() for k in pairs(VARS) do VARS[k] = nil end end
	_G.BUILDX_TEST.TS = TS
	_G.BUILDX_TEST.isList = isList
	_G.BUILDX_TEST.cmds = function() return CMD end
end
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX000002EB"><Properties><string name="Name">BuildXData</string><ProtectedString name="Source"><![CDATA[return {
